INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 1 — La formation du contrat de travail', 'Point clé : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes qu...', 'Cas pratique : Dans une entreprise à Paris, Jean se demande comment appliquer Art. L1221-1. Solution : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Art. L1221-1 du Code du travail', 'Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la formation du contrat de travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 2 — La période d''essai du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale...', 'Cas pratique : Dans une entreprise à Paris, Sophie se demande comment appliquer Art. L1221-19. Solution : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Art. L1221-19 du Code du travail', 'Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-19 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la période d''essai du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 3 — Renouvellement de la période d''essai', 'Point clé : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet acco...', 'Cas pratique : Dans une entreprise à Paris, Marc se demande comment appliquer Art. L1221-21. Solution : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Art. L1221-21 du Code du travail', 'La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-21 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'renouvellement de la période d''essai', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 4 — Délai de prévenance (Rupture période d''essai)', 'Point clé : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le sala...', 'Cas pratique : Dans une entreprise à Lyon, Léa se demande comment appliquer Art. L1221-25. Solution : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Art. L1221-25 du Code du travail', 'Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-25 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'délai de prévenance (rupture période d''essai)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 5 — Exécution de bonne foi', 'Point clé : Le contrat de travail est exécuté de bonne foi....', 'Cas pratique : Dans une entreprise à Lyon, Thomas se demande comment appliquer Art. L1222-1. Solution : Le contrat de travail est exécuté de bonne foi.', 'Art. L1222-1 du Code du travail', 'Le contrat de travail est exécuté de bonne foi.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'exécution de bonne foi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 6 — Le télétravail', 'Point clé : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait éga...', 'Cas pratique : Dans une entreprise à Lyon, Karim se demande comment appliquer Art. L1222-9. Solution : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Art. L1222-9 du Code du travail', 'Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-9 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'le télétravail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 7 — Rupture du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salar...', 'Cas pratique : Dans une entreprise à Marseille, Awa se demande comment appliquer Art. L1231-1. Solution : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Art. L1231-1 du Code du travail', 'Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Conseil Expert : Assurez-vous que l''application de Art. L1231-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 8 — Cause réelle et sérieuse', 'Point clé : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse....', 'Cas pratique : Dans une entreprise à Marseille, Julien se demande comment appliquer Art. L1232-1. Solution : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Art. L1232-1 du Code du travail', 'Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Conseil Expert : Assurez-vous que l''application de Art. L1232-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'cause réelle et sérieuse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 9 — Licenciement économique', 'Point clé : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou...', 'Cas pratique : Dans une entreprise à Marseille, Nadia se demande comment appliquer Art. L1233-3. Solution : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Art. L1233-3 du Code du travail', 'Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1233-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'licenciement économique', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 10 — Préavis de licenciement', 'Point clé : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est dé...', 'Cas pratique : Dans une entreprise à Lille, Camille se demande comment appliquer Art. L1234-1. Solution : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Art. L1234-1 du Code du travail', 'Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Conseil Expert : Assurez-vous que l''application de Art. L1234-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'préavis de licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 11 — Contestation du licenciement', 'Point clé : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et l...', 'Cas pratique : Dans une entreprise à Lille, Jean se demande comment appliquer Art. L1235-1. Solution : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Art. L1235-1 du Code du travail', 'En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1235-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'contestation du licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 12 — Rupture conventionnelle', 'Point clé : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contra...', 'Cas pratique : Dans une entreprise à Lille, Sophie se demande comment appliquer Art. L1237-11. Solution : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Art. L1237-11 du Code du travail', 'L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-11 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture conventionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 13 — Durée légale du travail', 'Point clé : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par ...', 'Cas pratique : Dans une entreprise à Bordeaux, Marc se demande comment appliquer Art. L3121-27. Solution : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Art. L3121-27 du Code du travail', 'La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-27 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée légale du travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 14 — Temps de travail effectif', 'Point clé : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employ...', 'Cas pratique : Dans une entreprise à Bordeaux, Léa se demande comment appliquer Art. L3121-1. Solution : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Art. L3121-1 du Code du travail', 'La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de travail effectif', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 15 — Temps de pause', 'Point clé : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d...', 'Cas pratique : Dans une entreprise à Bordeaux, Thomas se demande comment appliquer Art. L3121-16. Solution : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Art. L3121-16 du Code du travail', 'Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-16 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de pause', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 16 — Durée quotidienne maximale', 'Point clé : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures....', 'Cas pratique : Dans une entreprise à Nantes, Karim se demande comment appliquer Art. L3121-18. Solution : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Art. L3121-18 du Code du travail', 'Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-18 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée quotidienne maximale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 17 — Durée maximale hebdomadaire', 'Point clé : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures....', 'Cas pratique : Dans une entreprise à Nantes, Awa se demande comment appliquer Art. L3121-20. Solution : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Art. L3121-20 du Code du travail', 'Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-20 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée maximale hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 18 — Travail de nuit', 'Point clé : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la ...', 'Cas pratique : Dans une entreprise à Nantes, Julien se demande comment appliquer Art. L3122-1. Solution : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Art. L3122-1 du Code du travail', 'Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Conseil Expert : Assurez-vous que l''application de Art. L3122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'travail de nuit', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 19 — Repos quotidien', 'Point clé : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives....', 'Cas pratique : Dans une entreprise à Strasbourg, Nadia se demande comment appliquer Art. L3131-1. Solution : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Art. L3131-1 du Code du travail', 'Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3131-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos quotidien', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 20 — Repos hebdomadaire', 'Point clé : Il est interdit de faire travailler un même salarié plus de six jours par semaine....', 'Cas pratique : Dans une entreprise à Strasbourg, Camille se demande comment appliquer Art. L3132-1. Solution : Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Art. L3132-1 du Code du travail', 'Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 21 — Repos dominical', 'Point clé : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche....', 'Cas pratique : Dans une entreprise à Strasbourg, Jean se demande comment appliquer Art. L3132-3. Solution : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Art. L3132-3 du Code du travail', 'Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos dominical', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 22 — Congés annuels', 'Point clé : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur....', 'Cas pratique : Dans une entreprise à Toulouse, Sophie se demande comment appliquer Art. L3141-1. Solution : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Art. L3141-1 du Code du travail', 'Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés annuels', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 23 — Calcul des congés', 'Point clé : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le m...', 'Cas pratique : Dans une entreprise à Toulouse, Marc se demande comment appliquer Art. L3141-3. Solution : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Art. L3141-3 du Code du travail', 'Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'calcul des congés', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 24 — Égalité de rémunération', 'Point clé : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunér...', 'Cas pratique : Dans une entreprise à Toulouse, Léa se demande comment appliquer Art. L3221-2. Solution : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Art. L3221-2 du Code du travail', 'Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Conseil Expert : Assurez-vous que l''application de Art. L3221-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'égalité de rémunération', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 25 — Mensualisation du salaire', 'Point clé : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une qu...', 'Cas pratique : Dans une entreprise à Nice, Thomas se demande comment appliquer Art. L3242-1. Solution : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Art. L3242-1 du Code du travail', 'Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Conseil Expert : Assurez-vous que l''application de Art. L3242-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'mensualisation du salaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 26 — Obligation de sécurité', 'Point clé : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et ...', 'Cas pratique : Dans une entreprise à Nice, Karim se demande comment appliquer Art. L4121-1. Solution : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Art. L4121-1 du Code du travail', 'L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Conseil Expert : Assurez-vous que l''application de Art. L4121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation de sécurité', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 27 — Obligation du salarié (Sécurité)', 'Point clé : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilit...', 'Cas pratique : Dans une entreprise à Nice, Awa se demande comment appliquer Art. L4122-1. Solution : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Art. L4122-1 du Code du travail', 'Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation du salarié (sécurité)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 28 — Définition de la sanction disciplinaire', 'Point clé : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la...', 'Cas pratique : Dans une entreprise à Montpellier, Julien se demande comment appliquer Art. L1331-1. Solution : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Art. L1331-1 du Code du travail', 'Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Conseil Expert : Assurez-vous que l''application de Art. L1331-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'définition de la sanction disciplinaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 29 — Non-discrimination', 'Point clé : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun ...', 'Cas pratique : Dans une entreprise à Montpellier, Nadia se demande comment appliquer Art. L1132-1. Solution : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Art. L1132-1 du Code du travail', 'Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Conseil Expert : Assurez-vous que l''application de Art. L1132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'non-discrimination', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 30 — Harcèlement moral', 'Point clé : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour ...', 'Cas pratique : Dans une entreprise à Montpellier, Camille se demande comment appliquer Art. L1152-1. Solution : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Art. L1152-1 du Code du travail', 'Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1152-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement moral', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 31 — Harcèlement sexuel', 'Point clé : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou c...', 'Cas pratique : Dans une entreprise à Paris, Jean se demande comment appliquer Art. L1153-1. Solution : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Art. L1153-1 du Code du travail', 'Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Conseil Expert : Assurez-vous que l''application de Art. L1153-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement sexuel', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 32 — Informations demandées au candidat', 'Point clé : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir...', 'Cas pratique : Dans une entreprise à Paris, Sophie se demande comment appliquer Art. L1221-6. Solution : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Art. L1221-6 du Code du travail', 'Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-6 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'informations demandées au candidat', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 33 — Protection maternité (Licenciement)', 'Point clé : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de gross...', 'Cas pratique : Dans une entreprise à Paris, Marc se demande comment appliquer Art. L1225-4. Solution : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Art. L1225-4 du Code du travail', 'Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1225-4 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'protection maternité (licenciement)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 34 — Inaptitude non-professionnelle', 'Point clé : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait ...', 'Cas pratique : Dans une entreprise à Lyon, Léa se demande comment appliquer Art. L1226-2. Solution : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Art. L1226-2 du Code du travail', 'Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Conseil Expert : Assurez-vous que l''application de Art. L1226-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'inaptitude non-professionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 35 — Démission', 'Point clé : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention...', 'Cas pratique : Dans une entreprise à Lyon, Thomas se demande comment appliquer Art. L1237-1. Solution : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Art. L1237-1 du Code du travail', 'En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'démission', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 36 — Liberté syndicale', 'Point clé : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''...', 'Cas pratique : Dans une entreprise à Lyon, Karim se demande comment appliquer Art. L2141-1. Solution : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Art. L2141-1 du Code du travail', 'Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Conseil Expert : Assurez-vous que l''application de Art. L2141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'liberté syndicale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 37 — Application convention collective', 'Point clé : La convention collective applicable est celle dont relève l''activité principale exercée par l''employ...', 'Cas pratique : Dans une entreprise à Marseille, Awa se demande comment appliquer Art. L2261-2. Solution : La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Art. L2261-2 du Code du travail', 'La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L2261-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'application convention collective', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 38 — Missions du CSE', 'Point clé : Le comité social et économique a pour mission d''assurer une expression collective des salariés perme...', 'Cas pratique : Dans une entreprise à Marseille, Julien se demande comment appliquer Art. L2312-1. Solution : Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Art. L2312-1 du Code du travail', 'Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Conseil Expert : Assurez-vous que l''application de Art. L2312-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'missions du cse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 39 — Congés événements familiaux', 'Point clé : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mar...', 'Cas pratique : Dans une entreprise à Marseille, Nadia se demande comment appliquer Art. L3142-1. Solution : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Art. L3142-1 du Code du travail', 'Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Conseil Expert : Assurez-vous que l''application de Art. L3142-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés événements familiaux', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 40 — Visite d''information et de prévention', 'Point clé : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des profes...', 'Cas pratique : Dans une entreprise à Lille, Camille se demande comment appliquer Art. L4612-1. Solution : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Art. L4612-1 du Code du travail', 'Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4612-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'visite d''information et de prévention', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 41 — La formation du contrat de travail', 'Point clé : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes qu...', 'Cas pratique : Dans une entreprise à Lille, Jean se demande comment appliquer Art. L1221-1. Solution : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Art. L1221-1 du Code du travail', 'Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la formation du contrat de travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 42 — La période d''essai du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale...', 'Cas pratique : Dans une entreprise à Lille, Sophie se demande comment appliquer Art. L1221-19. Solution : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Art. L1221-19 du Code du travail', 'Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-19 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la période d''essai du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 43 — Renouvellement de la période d''essai', 'Point clé : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet acco...', 'Cas pratique : Dans une entreprise à Bordeaux, Marc se demande comment appliquer Art. L1221-21. Solution : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Art. L1221-21 du Code du travail', 'La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-21 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'renouvellement de la période d''essai', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 44 — Délai de prévenance (Rupture période d''essai)', 'Point clé : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le sala...', 'Cas pratique : Dans une entreprise à Bordeaux, Léa se demande comment appliquer Art. L1221-25. Solution : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Art. L1221-25 du Code du travail', 'Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-25 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'délai de prévenance (rupture période d''essai)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 45 — Exécution de bonne foi', 'Point clé : Le contrat de travail est exécuté de bonne foi....', 'Cas pratique : Dans une entreprise à Bordeaux, Thomas se demande comment appliquer Art. L1222-1. Solution : Le contrat de travail est exécuté de bonne foi.', 'Art. L1222-1 du Code du travail', 'Le contrat de travail est exécuté de bonne foi.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'exécution de bonne foi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 46 — Le télétravail', 'Point clé : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait éga...', 'Cas pratique : Dans une entreprise à Nantes, Karim se demande comment appliquer Art. L1222-9. Solution : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Art. L1222-9 du Code du travail', 'Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-9 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'le télétravail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 47 — Rupture du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salar...', 'Cas pratique : Dans une entreprise à Nantes, Awa se demande comment appliquer Art. L1231-1. Solution : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Art. L1231-1 du Code du travail', 'Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Conseil Expert : Assurez-vous que l''application de Art. L1231-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 48 — Cause réelle et sérieuse', 'Point clé : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse....', 'Cas pratique : Dans une entreprise à Nantes, Julien se demande comment appliquer Art. L1232-1. Solution : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Art. L1232-1 du Code du travail', 'Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Conseil Expert : Assurez-vous que l''application de Art. L1232-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'cause réelle et sérieuse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 49 — Licenciement économique', 'Point clé : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou...', 'Cas pratique : Dans une entreprise à Strasbourg, Nadia se demande comment appliquer Art. L1233-3. Solution : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Art. L1233-3 du Code du travail', 'Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1233-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'licenciement économique', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 50 — Préavis de licenciement', 'Point clé : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est dé...', 'Cas pratique : Dans une entreprise à Strasbourg, Camille se demande comment appliquer Art. L1234-1. Solution : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Art. L1234-1 du Code du travail', 'Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Conseil Expert : Assurez-vous que l''application de Art. L1234-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'préavis de licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 51 — Contestation du licenciement', 'Point clé : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et l...', 'Cas pratique : Dans une entreprise à Strasbourg, Jean se demande comment appliquer Art. L1235-1. Solution : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Art. L1235-1 du Code du travail', 'En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1235-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'contestation du licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 52 — Rupture conventionnelle', 'Point clé : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contra...', 'Cas pratique : Dans une entreprise à Toulouse, Sophie se demande comment appliquer Art. L1237-11. Solution : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Art. L1237-11 du Code du travail', 'L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-11 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture conventionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 53 — Durée légale du travail', 'Point clé : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par ...', 'Cas pratique : Dans une entreprise à Toulouse, Marc se demande comment appliquer Art. L3121-27. Solution : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Art. L3121-27 du Code du travail', 'La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-27 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée légale du travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 54 — Temps de travail effectif', 'Point clé : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employ...', 'Cas pratique : Dans une entreprise à Toulouse, Léa se demande comment appliquer Art. L3121-1. Solution : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Art. L3121-1 du Code du travail', 'La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de travail effectif', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 55 — Temps de pause', 'Point clé : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d...', 'Cas pratique : Dans une entreprise à Nice, Thomas se demande comment appliquer Art. L3121-16. Solution : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Art. L3121-16 du Code du travail', 'Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-16 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de pause', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 56 — Durée quotidienne maximale', 'Point clé : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures....', 'Cas pratique : Dans une entreprise à Nice, Karim se demande comment appliquer Art. L3121-18. Solution : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Art. L3121-18 du Code du travail', 'Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-18 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée quotidienne maximale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 57 — Durée maximale hebdomadaire', 'Point clé : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures....', 'Cas pratique : Dans une entreprise à Nice, Awa se demande comment appliquer Art. L3121-20. Solution : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Art. L3121-20 du Code du travail', 'Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-20 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée maximale hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 58 — Travail de nuit', 'Point clé : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la ...', 'Cas pratique : Dans une entreprise à Montpellier, Julien se demande comment appliquer Art. L3122-1. Solution : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Art. L3122-1 du Code du travail', 'Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Conseil Expert : Assurez-vous que l''application de Art. L3122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'travail de nuit', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 59 — Repos quotidien', 'Point clé : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives....', 'Cas pratique : Dans une entreprise à Montpellier, Nadia se demande comment appliquer Art. L3131-1. Solution : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Art. L3131-1 du Code du travail', 'Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3131-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos quotidien', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 60 — Repos hebdomadaire', 'Point clé : Il est interdit de faire travailler un même salarié plus de six jours par semaine....', 'Cas pratique : Dans une entreprise à Montpellier, Camille se demande comment appliquer Art. L3132-1. Solution : Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Art. L3132-1 du Code du travail', 'Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 61 — Repos dominical', 'Point clé : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche....', 'Cas pratique : Dans une entreprise à Paris, Jean se demande comment appliquer Art. L3132-3. Solution : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Art. L3132-3 du Code du travail', 'Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos dominical', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 62 — Congés annuels', 'Point clé : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur....', 'Cas pratique : Dans une entreprise à Paris, Sophie se demande comment appliquer Art. L3141-1. Solution : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Art. L3141-1 du Code du travail', 'Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés annuels', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 63 — Calcul des congés', 'Point clé : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le m...', 'Cas pratique : Dans une entreprise à Paris, Marc se demande comment appliquer Art. L3141-3. Solution : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Art. L3141-3 du Code du travail', 'Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'calcul des congés', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 64 — Égalité de rémunération', 'Point clé : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunér...', 'Cas pratique : Dans une entreprise à Lyon, Léa se demande comment appliquer Art. L3221-2. Solution : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Art. L3221-2 du Code du travail', 'Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Conseil Expert : Assurez-vous que l''application de Art. L3221-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'égalité de rémunération', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 65 — Mensualisation du salaire', 'Point clé : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une qu...', 'Cas pratique : Dans une entreprise à Lyon, Thomas se demande comment appliquer Art. L3242-1. Solution : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Art. L3242-1 du Code du travail', 'Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Conseil Expert : Assurez-vous que l''application de Art. L3242-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'mensualisation du salaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 66 — Obligation de sécurité', 'Point clé : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et ...', 'Cas pratique : Dans une entreprise à Lyon, Karim se demande comment appliquer Art. L4121-1. Solution : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Art. L4121-1 du Code du travail', 'L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Conseil Expert : Assurez-vous que l''application de Art. L4121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation de sécurité', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 67 — Obligation du salarié (Sécurité)', 'Point clé : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilit...', 'Cas pratique : Dans une entreprise à Marseille, Awa se demande comment appliquer Art. L4122-1. Solution : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Art. L4122-1 du Code du travail', 'Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation du salarié (sécurité)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 68 — Définition de la sanction disciplinaire', 'Point clé : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la...', 'Cas pratique : Dans une entreprise à Marseille, Julien se demande comment appliquer Art. L1331-1. Solution : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Art. L1331-1 du Code du travail', 'Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Conseil Expert : Assurez-vous que l''application de Art. L1331-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'définition de la sanction disciplinaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 69 — Non-discrimination', 'Point clé : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun ...', 'Cas pratique : Dans une entreprise à Marseille, Nadia se demande comment appliquer Art. L1132-1. Solution : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Art. L1132-1 du Code du travail', 'Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Conseil Expert : Assurez-vous que l''application de Art. L1132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'non-discrimination', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 70 — Harcèlement moral', 'Point clé : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour ...', 'Cas pratique : Dans une entreprise à Lille, Camille se demande comment appliquer Art. L1152-1. Solution : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Art. L1152-1 du Code du travail', 'Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1152-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement moral', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 71 — Harcèlement sexuel', 'Point clé : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou c...', 'Cas pratique : Dans une entreprise à Lille, Jean se demande comment appliquer Art. L1153-1. Solution : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Art. L1153-1 du Code du travail', 'Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Conseil Expert : Assurez-vous que l''application de Art. L1153-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement sexuel', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 72 — Informations demandées au candidat', 'Point clé : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir...', 'Cas pratique : Dans une entreprise à Lille, Sophie se demande comment appliquer Art. L1221-6. Solution : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Art. L1221-6 du Code du travail', 'Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-6 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'informations demandées au candidat', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 73 — Protection maternité (Licenciement)', 'Point clé : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de gross...', 'Cas pratique : Dans une entreprise à Bordeaux, Marc se demande comment appliquer Art. L1225-4. Solution : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Art. L1225-4 du Code du travail', 'Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1225-4 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'protection maternité (licenciement)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 74 — Inaptitude non-professionnelle', 'Point clé : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait ...', 'Cas pratique : Dans une entreprise à Bordeaux, Léa se demande comment appliquer Art. L1226-2. Solution : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Art. L1226-2 du Code du travail', 'Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Conseil Expert : Assurez-vous que l''application de Art. L1226-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'inaptitude non-professionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 75 — Démission', 'Point clé : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention...', 'Cas pratique : Dans une entreprise à Bordeaux, Thomas se demande comment appliquer Art. L1237-1. Solution : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Art. L1237-1 du Code du travail', 'En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'démission', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 76 — Liberté syndicale', 'Point clé : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''...', 'Cas pratique : Dans une entreprise à Nantes, Karim se demande comment appliquer Art. L2141-1. Solution : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Art. L2141-1 du Code du travail', 'Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Conseil Expert : Assurez-vous que l''application de Art. L2141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'liberté syndicale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 77 — Application convention collective', 'Point clé : La convention collective applicable est celle dont relève l''activité principale exercée par l''employ...', 'Cas pratique : Dans une entreprise à Nantes, Awa se demande comment appliquer Art. L2261-2. Solution : La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Art. L2261-2 du Code du travail', 'La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L2261-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'application convention collective', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 78 — Missions du CSE', 'Point clé : Le comité social et économique a pour mission d''assurer une expression collective des salariés perme...', 'Cas pratique : Dans une entreprise à Nantes, Julien se demande comment appliquer Art. L2312-1. Solution : Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Art. L2312-1 du Code du travail', 'Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Conseil Expert : Assurez-vous que l''application de Art. L2312-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'missions du cse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 79 — Congés événements familiaux', 'Point clé : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mar...', 'Cas pratique : Dans une entreprise à Strasbourg, Nadia se demande comment appliquer Art. L3142-1. Solution : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Art. L3142-1 du Code du travail', 'Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Conseil Expert : Assurez-vous que l''application de Art. L3142-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés événements familiaux', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 80 — Visite d''information et de prévention', 'Point clé : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des profes...', 'Cas pratique : Dans une entreprise à Strasbourg, Camille se demande comment appliquer Art. L4612-1. Solution : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Art. L4612-1 du Code du travail', 'Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4612-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'visite d''information et de prévention', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 81 — La formation du contrat de travail', 'Point clé : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes qu...', 'Cas pratique : Dans une entreprise à Strasbourg, Jean se demande comment appliquer Art. L1221-1. Solution : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Art. L1221-1 du Code du travail', 'Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la formation du contrat de travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 82 — La période d''essai du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale...', 'Cas pratique : Dans une entreprise à Toulouse, Sophie se demande comment appliquer Art. L1221-19. Solution : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Art. L1221-19 du Code du travail', 'Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-19 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la période d''essai du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 83 — Renouvellement de la période d''essai', 'Point clé : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet acco...', 'Cas pratique : Dans une entreprise à Toulouse, Marc se demande comment appliquer Art. L1221-21. Solution : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Art. L1221-21 du Code du travail', 'La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-21 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'renouvellement de la période d''essai', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 84 — Délai de prévenance (Rupture période d''essai)', 'Point clé : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le sala...', 'Cas pratique : Dans une entreprise à Toulouse, Léa se demande comment appliquer Art. L1221-25. Solution : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Art. L1221-25 du Code du travail', 'Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-25 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'délai de prévenance (rupture période d''essai)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 85 — Exécution de bonne foi', 'Point clé : Le contrat de travail est exécuté de bonne foi....', 'Cas pratique : Dans une entreprise à Nice, Thomas se demande comment appliquer Art. L1222-1. Solution : Le contrat de travail est exécuté de bonne foi.', 'Art. L1222-1 du Code du travail', 'Le contrat de travail est exécuté de bonne foi.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'exécution de bonne foi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 86 — Le télétravail', 'Point clé : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait éga...', 'Cas pratique : Dans une entreprise à Nice, Karim se demande comment appliquer Art. L1222-9. Solution : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Art. L1222-9 du Code du travail', 'Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-9 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'le télétravail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 87 — Rupture du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salar...', 'Cas pratique : Dans une entreprise à Nice, Awa se demande comment appliquer Art. L1231-1. Solution : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Art. L1231-1 du Code du travail', 'Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Conseil Expert : Assurez-vous que l''application de Art. L1231-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 88 — Cause réelle et sérieuse', 'Point clé : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse....', 'Cas pratique : Dans une entreprise à Montpellier, Julien se demande comment appliquer Art. L1232-1. Solution : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Art. L1232-1 du Code du travail', 'Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Conseil Expert : Assurez-vous que l''application de Art. L1232-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'cause réelle et sérieuse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 89 — Licenciement économique', 'Point clé : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou...', 'Cas pratique : Dans une entreprise à Montpellier, Nadia se demande comment appliquer Art. L1233-3. Solution : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Art. L1233-3 du Code du travail', 'Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1233-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'licenciement économique', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 90 — Préavis de licenciement', 'Point clé : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est dé...', 'Cas pratique : Dans une entreprise à Montpellier, Camille se demande comment appliquer Art. L1234-1. Solution : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Art. L1234-1 du Code du travail', 'Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Conseil Expert : Assurez-vous que l''application de Art. L1234-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'préavis de licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 91 — Contestation du licenciement', 'Point clé : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et l...', 'Cas pratique : Dans une entreprise à Paris, Jean se demande comment appliquer Art. L1235-1. Solution : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Art. L1235-1 du Code du travail', 'En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1235-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'contestation du licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 92 — Rupture conventionnelle', 'Point clé : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contra...', 'Cas pratique : Dans une entreprise à Paris, Sophie se demande comment appliquer Art. L1237-11. Solution : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Art. L1237-11 du Code du travail', 'L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-11 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture conventionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 93 — Durée légale du travail', 'Point clé : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par ...', 'Cas pratique : Dans une entreprise à Paris, Marc se demande comment appliquer Art. L3121-27. Solution : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Art. L3121-27 du Code du travail', 'La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-27 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée légale du travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 94 — Temps de travail effectif', 'Point clé : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employ...', 'Cas pratique : Dans une entreprise à Lyon, Léa se demande comment appliquer Art. L3121-1. Solution : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Art. L3121-1 du Code du travail', 'La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de travail effectif', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 95 — Temps de pause', 'Point clé : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d...', 'Cas pratique : Dans une entreprise à Lyon, Thomas se demande comment appliquer Art. L3121-16. Solution : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Art. L3121-16 du Code du travail', 'Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-16 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de pause', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 96 — Durée quotidienne maximale', 'Point clé : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures....', 'Cas pratique : Dans une entreprise à Lyon, Karim se demande comment appliquer Art. L3121-18. Solution : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Art. L3121-18 du Code du travail', 'Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-18 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée quotidienne maximale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 97 — Durée maximale hebdomadaire', 'Point clé : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures....', 'Cas pratique : Dans une entreprise à Marseille, Awa se demande comment appliquer Art. L3121-20. Solution : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Art. L3121-20 du Code du travail', 'Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-20 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée maximale hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 98 — Travail de nuit', 'Point clé : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la ...', 'Cas pratique : Dans une entreprise à Marseille, Julien se demande comment appliquer Art. L3122-1. Solution : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Art. L3122-1 du Code du travail', 'Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Conseil Expert : Assurez-vous que l''application de Art. L3122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'travail de nuit', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 99 — Repos quotidien', 'Point clé : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives....', 'Cas pratique : Dans une entreprise à Marseille, Nadia se demande comment appliquer Art. L3131-1. Solution : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Art. L3131-1 du Code du travail', 'Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3131-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos quotidien', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 100 — Repos hebdomadaire', 'Point clé : Il est interdit de faire travailler un même salarié plus de six jours par semaine....', 'Cas pratique : Dans une entreprise à Lille, Camille se demande comment appliquer Art. L3132-1. Solution : Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Art. L3132-1 du Code du travail', 'Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 101 — Repos dominical', 'Point clé : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche....', 'Cas pratique : Dans une entreprise à Lille, Jean se demande comment appliquer Art. L3132-3. Solution : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Art. L3132-3 du Code du travail', 'Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos dominical', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 102 — Congés annuels', 'Point clé : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur....', 'Cas pratique : Dans une entreprise à Lille, Sophie se demande comment appliquer Art. L3141-1. Solution : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Art. L3141-1 du Code du travail', 'Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés annuels', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 103 — Calcul des congés', 'Point clé : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le m...', 'Cas pratique : Dans une entreprise à Bordeaux, Marc se demande comment appliquer Art. L3141-3. Solution : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Art. L3141-3 du Code du travail', 'Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'calcul des congés', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 104 — Égalité de rémunération', 'Point clé : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunér...', 'Cas pratique : Dans une entreprise à Bordeaux, Léa se demande comment appliquer Art. L3221-2. Solution : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Art. L3221-2 du Code du travail', 'Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Conseil Expert : Assurez-vous que l''application de Art. L3221-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'égalité de rémunération', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 105 — Mensualisation du salaire', 'Point clé : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une qu...', 'Cas pratique : Dans une entreprise à Bordeaux, Thomas se demande comment appliquer Art. L3242-1. Solution : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Art. L3242-1 du Code du travail', 'Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Conseil Expert : Assurez-vous que l''application de Art. L3242-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'mensualisation du salaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 106 — Obligation de sécurité', 'Point clé : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et ...', 'Cas pratique : Dans une entreprise à Nantes, Karim se demande comment appliquer Art. L4121-1. Solution : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Art. L4121-1 du Code du travail', 'L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Conseil Expert : Assurez-vous que l''application de Art. L4121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation de sécurité', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 107 — Obligation du salarié (Sécurité)', 'Point clé : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilit...', 'Cas pratique : Dans une entreprise à Nantes, Awa se demande comment appliquer Art. L4122-1. Solution : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Art. L4122-1 du Code du travail', 'Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation du salarié (sécurité)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 108 — Définition de la sanction disciplinaire', 'Point clé : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la...', 'Cas pratique : Dans une entreprise à Nantes, Julien se demande comment appliquer Art. L1331-1. Solution : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Art. L1331-1 du Code du travail', 'Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Conseil Expert : Assurez-vous que l''application de Art. L1331-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'définition de la sanction disciplinaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 109 — Non-discrimination', 'Point clé : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun ...', 'Cas pratique : Dans une entreprise à Strasbourg, Nadia se demande comment appliquer Art. L1132-1. Solution : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Art. L1132-1 du Code du travail', 'Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Conseil Expert : Assurez-vous que l''application de Art. L1132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'non-discrimination', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 110 — Harcèlement moral', 'Point clé : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour ...', 'Cas pratique : Dans une entreprise à Strasbourg, Camille se demande comment appliquer Art. L1152-1. Solution : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Art. L1152-1 du Code du travail', 'Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1152-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement moral', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 111 — Harcèlement sexuel', 'Point clé : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou c...', 'Cas pratique : Dans une entreprise à Strasbourg, Jean se demande comment appliquer Art. L1153-1. Solution : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Art. L1153-1 du Code du travail', 'Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Conseil Expert : Assurez-vous que l''application de Art. L1153-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement sexuel', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 112 — Informations demandées au candidat', 'Point clé : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir...', 'Cas pratique : Dans une entreprise à Toulouse, Sophie se demande comment appliquer Art. L1221-6. Solution : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Art. L1221-6 du Code du travail', 'Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-6 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'informations demandées au candidat', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 113 — Protection maternité (Licenciement)', 'Point clé : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de gross...', 'Cas pratique : Dans une entreprise à Toulouse, Marc se demande comment appliquer Art. L1225-4. Solution : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Art. L1225-4 du Code du travail', 'Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1225-4 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'protection maternité (licenciement)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 114 — Inaptitude non-professionnelle', 'Point clé : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait ...', 'Cas pratique : Dans une entreprise à Toulouse, Léa se demande comment appliquer Art. L1226-2. Solution : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Art. L1226-2 du Code du travail', 'Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Conseil Expert : Assurez-vous que l''application de Art. L1226-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'inaptitude non-professionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 115 — Démission', 'Point clé : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention...', 'Cas pratique : Dans une entreprise à Nice, Thomas se demande comment appliquer Art. L1237-1. Solution : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Art. L1237-1 du Code du travail', 'En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'démission', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 116 — Liberté syndicale', 'Point clé : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''...', 'Cas pratique : Dans une entreprise à Nice, Karim se demande comment appliquer Art. L2141-1. Solution : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Art. L2141-1 du Code du travail', 'Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Conseil Expert : Assurez-vous que l''application de Art. L2141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'liberté syndicale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 117 — Application convention collective', 'Point clé : La convention collective applicable est celle dont relève l''activité principale exercée par l''employ...', 'Cas pratique : Dans une entreprise à Nice, Awa se demande comment appliquer Art. L2261-2. Solution : La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Art. L2261-2 du Code du travail', 'La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L2261-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'application convention collective', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 118 — Missions du CSE', 'Point clé : Le comité social et économique a pour mission d''assurer une expression collective des salariés perme...', 'Cas pratique : Dans une entreprise à Montpellier, Julien se demande comment appliquer Art. L2312-1. Solution : Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Art. L2312-1 du Code du travail', 'Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Conseil Expert : Assurez-vous que l''application de Art. L2312-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'missions du cse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 119 — Congés événements familiaux', 'Point clé : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mar...', 'Cas pratique : Dans une entreprise à Montpellier, Nadia se demande comment appliquer Art. L3142-1. Solution : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Art. L3142-1 du Code du travail', 'Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Conseil Expert : Assurez-vous que l''application de Art. L3142-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés événements familiaux', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 120 — Visite d''information et de prévention', 'Point clé : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des profes...', 'Cas pratique : Dans une entreprise à Montpellier, Camille se demande comment appliquer Art. L4612-1. Solution : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Art. L4612-1 du Code du travail', 'Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4612-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'visite d''information et de prévention', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 121 — La formation du contrat de travail', 'Point clé : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes qu...', 'Cas pratique : Dans une entreprise à Paris, Jean se demande comment appliquer Art. L1221-1. Solution : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Art. L1221-1 du Code du travail', 'Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la formation du contrat de travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 122 — La période d''essai du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale...', 'Cas pratique : Dans une entreprise à Paris, Sophie se demande comment appliquer Art. L1221-19. Solution : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Art. L1221-19 du Code du travail', 'Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-19 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la période d''essai du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 123 — Renouvellement de la période d''essai', 'Point clé : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet acco...', 'Cas pratique : Dans une entreprise à Paris, Marc se demande comment appliquer Art. L1221-21. Solution : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Art. L1221-21 du Code du travail', 'La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-21 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'renouvellement de la période d''essai', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 124 — Délai de prévenance (Rupture période d''essai)', 'Point clé : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le sala...', 'Cas pratique : Dans une entreprise à Lyon, Léa se demande comment appliquer Art. L1221-25. Solution : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Art. L1221-25 du Code du travail', 'Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-25 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'délai de prévenance (rupture période d''essai)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 125 — Exécution de bonne foi', 'Point clé : Le contrat de travail est exécuté de bonne foi....', 'Cas pratique : Dans une entreprise à Lyon, Thomas se demande comment appliquer Art. L1222-1. Solution : Le contrat de travail est exécuté de bonne foi.', 'Art. L1222-1 du Code du travail', 'Le contrat de travail est exécuté de bonne foi.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'exécution de bonne foi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 126 — Le télétravail', 'Point clé : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait éga...', 'Cas pratique : Dans une entreprise à Lyon, Karim se demande comment appliquer Art. L1222-9. Solution : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Art. L1222-9 du Code du travail', 'Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-9 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'le télétravail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 127 — Rupture du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salar...', 'Cas pratique : Dans une entreprise à Marseille, Awa se demande comment appliquer Art. L1231-1. Solution : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Art. L1231-1 du Code du travail', 'Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Conseil Expert : Assurez-vous que l''application de Art. L1231-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 128 — Cause réelle et sérieuse', 'Point clé : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse....', 'Cas pratique : Dans une entreprise à Marseille, Julien se demande comment appliquer Art. L1232-1. Solution : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Art. L1232-1 du Code du travail', 'Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Conseil Expert : Assurez-vous que l''application de Art. L1232-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'cause réelle et sérieuse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 129 — Licenciement économique', 'Point clé : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou...', 'Cas pratique : Dans une entreprise à Marseille, Nadia se demande comment appliquer Art. L1233-3. Solution : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Art. L1233-3 du Code du travail', 'Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1233-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'licenciement économique', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 130 — Préavis de licenciement', 'Point clé : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est dé...', 'Cas pratique : Dans une entreprise à Lille, Camille se demande comment appliquer Art. L1234-1. Solution : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Art. L1234-1 du Code du travail', 'Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Conseil Expert : Assurez-vous que l''application de Art. L1234-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'préavis de licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 131 — Contestation du licenciement', 'Point clé : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et l...', 'Cas pratique : Dans une entreprise à Lille, Jean se demande comment appliquer Art. L1235-1. Solution : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Art. L1235-1 du Code du travail', 'En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1235-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'contestation du licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 132 — Rupture conventionnelle', 'Point clé : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contra...', 'Cas pratique : Dans une entreprise à Lille, Sophie se demande comment appliquer Art. L1237-11. Solution : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Art. L1237-11 du Code du travail', 'L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-11 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture conventionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 133 — Durée légale du travail', 'Point clé : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par ...', 'Cas pratique : Dans une entreprise à Bordeaux, Marc se demande comment appliquer Art. L3121-27. Solution : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Art. L3121-27 du Code du travail', 'La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-27 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée légale du travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 134 — Temps de travail effectif', 'Point clé : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employ...', 'Cas pratique : Dans une entreprise à Bordeaux, Léa se demande comment appliquer Art. L3121-1. Solution : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Art. L3121-1 du Code du travail', 'La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de travail effectif', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 135 — Temps de pause', 'Point clé : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d...', 'Cas pratique : Dans une entreprise à Bordeaux, Thomas se demande comment appliquer Art. L3121-16. Solution : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Art. L3121-16 du Code du travail', 'Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-16 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de pause', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 136 — Durée quotidienne maximale', 'Point clé : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures....', 'Cas pratique : Dans une entreprise à Nantes, Karim se demande comment appliquer Art. L3121-18. Solution : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Art. L3121-18 du Code du travail', 'Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-18 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée quotidienne maximale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 137 — Durée maximale hebdomadaire', 'Point clé : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures....', 'Cas pratique : Dans une entreprise à Nantes, Awa se demande comment appliquer Art. L3121-20. Solution : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Art. L3121-20 du Code du travail', 'Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-20 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée maximale hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 138 — Travail de nuit', 'Point clé : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la ...', 'Cas pratique : Dans une entreprise à Nantes, Julien se demande comment appliquer Art. L3122-1. Solution : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Art. L3122-1 du Code du travail', 'Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Conseil Expert : Assurez-vous que l''application de Art. L3122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'travail de nuit', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 139 — Repos quotidien', 'Point clé : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives....', 'Cas pratique : Dans une entreprise à Strasbourg, Nadia se demande comment appliquer Art. L3131-1. Solution : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Art. L3131-1 du Code du travail', 'Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3131-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos quotidien', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 140 — Repos hebdomadaire', 'Point clé : Il est interdit de faire travailler un même salarié plus de six jours par semaine....', 'Cas pratique : Dans une entreprise à Strasbourg, Camille se demande comment appliquer Art. L3132-1. Solution : Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Art. L3132-1 du Code du travail', 'Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 141 — Repos dominical', 'Point clé : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche....', 'Cas pratique : Dans une entreprise à Strasbourg, Jean se demande comment appliquer Art. L3132-3. Solution : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Art. L3132-3 du Code du travail', 'Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos dominical', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 142 — Congés annuels', 'Point clé : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur....', 'Cas pratique : Dans une entreprise à Toulouse, Sophie se demande comment appliquer Art. L3141-1. Solution : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Art. L3141-1 du Code du travail', 'Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés annuels', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 143 — Calcul des congés', 'Point clé : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le m...', 'Cas pratique : Dans une entreprise à Toulouse, Marc se demande comment appliquer Art. L3141-3. Solution : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Art. L3141-3 du Code du travail', 'Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'calcul des congés', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 144 — Égalité de rémunération', 'Point clé : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunér...', 'Cas pratique : Dans une entreprise à Toulouse, Léa se demande comment appliquer Art. L3221-2. Solution : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Art. L3221-2 du Code du travail', 'Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Conseil Expert : Assurez-vous que l''application de Art. L3221-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'égalité de rémunération', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 145 — Mensualisation du salaire', 'Point clé : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une qu...', 'Cas pratique : Dans une entreprise à Nice, Thomas se demande comment appliquer Art. L3242-1. Solution : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Art. L3242-1 du Code du travail', 'Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Conseil Expert : Assurez-vous que l''application de Art. L3242-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'mensualisation du salaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 146 — Obligation de sécurité', 'Point clé : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et ...', 'Cas pratique : Dans une entreprise à Nice, Karim se demande comment appliquer Art. L4121-1. Solution : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Art. L4121-1 du Code du travail', 'L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Conseil Expert : Assurez-vous que l''application de Art. L4121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation de sécurité', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 147 — Obligation du salarié (Sécurité)', 'Point clé : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilit...', 'Cas pratique : Dans une entreprise à Nice, Awa se demande comment appliquer Art. L4122-1. Solution : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Art. L4122-1 du Code du travail', 'Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation du salarié (sécurité)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 148 — Définition de la sanction disciplinaire', 'Point clé : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la...', 'Cas pratique : Dans une entreprise à Montpellier, Julien se demande comment appliquer Art. L1331-1. Solution : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Art. L1331-1 du Code du travail', 'Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Conseil Expert : Assurez-vous que l''application de Art. L1331-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'définition de la sanction disciplinaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 149 — Non-discrimination', 'Point clé : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun ...', 'Cas pratique : Dans une entreprise à Montpellier, Nadia se demande comment appliquer Art. L1132-1. Solution : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Art. L1132-1 du Code du travail', 'Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Conseil Expert : Assurez-vous que l''application de Art. L1132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'non-discrimination', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 150 — Harcèlement moral', 'Point clé : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour ...', 'Cas pratique : Dans une entreprise à Montpellier, Camille se demande comment appliquer Art. L1152-1. Solution : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Art. L1152-1 du Code du travail', 'Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1152-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement moral', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 151 — Harcèlement sexuel', 'Point clé : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou c...', 'Cas pratique : Dans une entreprise à Paris, Jean se demande comment appliquer Art. L1153-1. Solution : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Art. L1153-1 du Code du travail', 'Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Conseil Expert : Assurez-vous que l''application de Art. L1153-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement sexuel', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 152 — Informations demandées au candidat', 'Point clé : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir...', 'Cas pratique : Dans une entreprise à Paris, Sophie se demande comment appliquer Art. L1221-6. Solution : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Art. L1221-6 du Code du travail', 'Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-6 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'informations demandées au candidat', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 153 — Protection maternité (Licenciement)', 'Point clé : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de gross...', 'Cas pratique : Dans une entreprise à Paris, Marc se demande comment appliquer Art. L1225-4. Solution : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Art. L1225-4 du Code du travail', 'Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1225-4 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'protection maternité (licenciement)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 154 — Inaptitude non-professionnelle', 'Point clé : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait ...', 'Cas pratique : Dans une entreprise à Lyon, Léa se demande comment appliquer Art. L1226-2. Solution : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Art. L1226-2 du Code du travail', 'Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Conseil Expert : Assurez-vous que l''application de Art. L1226-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'inaptitude non-professionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 155 — Démission', 'Point clé : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention...', 'Cas pratique : Dans une entreprise à Lyon, Thomas se demande comment appliquer Art. L1237-1. Solution : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Art. L1237-1 du Code du travail', 'En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'démission', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 156 — Liberté syndicale', 'Point clé : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''...', 'Cas pratique : Dans une entreprise à Lyon, Karim se demande comment appliquer Art. L2141-1. Solution : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Art. L2141-1 du Code du travail', 'Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Conseil Expert : Assurez-vous que l''application de Art. L2141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'liberté syndicale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 157 — Application convention collective', 'Point clé : La convention collective applicable est celle dont relève l''activité principale exercée par l''employ...', 'Cas pratique : Dans une entreprise à Marseille, Awa se demande comment appliquer Art. L2261-2. Solution : La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Art. L2261-2 du Code du travail', 'La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L2261-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'application convention collective', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 158 — Missions du CSE', 'Point clé : Le comité social et économique a pour mission d''assurer une expression collective des salariés perme...', 'Cas pratique : Dans une entreprise à Marseille, Julien se demande comment appliquer Art. L2312-1. Solution : Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Art. L2312-1 du Code du travail', 'Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Conseil Expert : Assurez-vous que l''application de Art. L2312-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'missions du cse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 159 — Congés événements familiaux', 'Point clé : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mar...', 'Cas pratique : Dans une entreprise à Marseille, Nadia se demande comment appliquer Art. L3142-1. Solution : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Art. L3142-1 du Code du travail', 'Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Conseil Expert : Assurez-vous que l''application de Art. L3142-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés événements familiaux', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 160 — Visite d''information et de prévention', 'Point clé : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des profes...', 'Cas pratique : Dans une entreprise à Lille, Camille se demande comment appliquer Art. L4612-1. Solution : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Art. L4612-1 du Code du travail', 'Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4612-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'visite d''information et de prévention', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 161 — La formation du contrat de travail', 'Point clé : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes qu...', 'Cas pratique : Dans une entreprise à Lille, Jean se demande comment appliquer Art. L1221-1. Solution : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Art. L1221-1 du Code du travail', 'Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la formation du contrat de travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 162 — La période d''essai du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale...', 'Cas pratique : Dans une entreprise à Lille, Sophie se demande comment appliquer Art. L1221-19. Solution : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Art. L1221-19 du Code du travail', 'Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-19 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la période d''essai du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 163 — Renouvellement de la période d''essai', 'Point clé : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet acco...', 'Cas pratique : Dans une entreprise à Bordeaux, Marc se demande comment appliquer Art. L1221-21. Solution : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Art. L1221-21 du Code du travail', 'La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-21 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'renouvellement de la période d''essai', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 164 — Délai de prévenance (Rupture période d''essai)', 'Point clé : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le sala...', 'Cas pratique : Dans une entreprise à Bordeaux, Léa se demande comment appliquer Art. L1221-25. Solution : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Art. L1221-25 du Code du travail', 'Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-25 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'délai de prévenance (rupture période d''essai)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 165 — Exécution de bonne foi', 'Point clé : Le contrat de travail est exécuté de bonne foi....', 'Cas pratique : Dans une entreprise à Bordeaux, Thomas se demande comment appliquer Art. L1222-1. Solution : Le contrat de travail est exécuté de bonne foi.', 'Art. L1222-1 du Code du travail', 'Le contrat de travail est exécuté de bonne foi.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'exécution de bonne foi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 166 — Le télétravail', 'Point clé : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait éga...', 'Cas pratique : Dans une entreprise à Nantes, Karim se demande comment appliquer Art. L1222-9. Solution : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Art. L1222-9 du Code du travail', 'Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-9 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'le télétravail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 167 — Rupture du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salar...', 'Cas pratique : Dans une entreprise à Nantes, Awa se demande comment appliquer Art. L1231-1. Solution : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Art. L1231-1 du Code du travail', 'Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Conseil Expert : Assurez-vous que l''application de Art. L1231-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 168 — Cause réelle et sérieuse', 'Point clé : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse....', 'Cas pratique : Dans une entreprise à Nantes, Julien se demande comment appliquer Art. L1232-1. Solution : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Art. L1232-1 du Code du travail', 'Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Conseil Expert : Assurez-vous que l''application de Art. L1232-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'cause réelle et sérieuse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 169 — Licenciement économique', 'Point clé : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou...', 'Cas pratique : Dans une entreprise à Strasbourg, Nadia se demande comment appliquer Art. L1233-3. Solution : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Art. L1233-3 du Code du travail', 'Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1233-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'licenciement économique', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 170 — Préavis de licenciement', 'Point clé : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est dé...', 'Cas pratique : Dans une entreprise à Strasbourg, Camille se demande comment appliquer Art. L1234-1. Solution : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Art. L1234-1 du Code du travail', 'Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Conseil Expert : Assurez-vous que l''application de Art. L1234-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'préavis de licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 171 — Contestation du licenciement', 'Point clé : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et l...', 'Cas pratique : Dans une entreprise à Strasbourg, Jean se demande comment appliquer Art. L1235-1. Solution : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Art. L1235-1 du Code du travail', 'En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1235-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'contestation du licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 172 — Rupture conventionnelle', 'Point clé : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contra...', 'Cas pratique : Dans une entreprise à Toulouse, Sophie se demande comment appliquer Art. L1237-11. Solution : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Art. L1237-11 du Code du travail', 'L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-11 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture conventionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 173 — Durée légale du travail', 'Point clé : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par ...', 'Cas pratique : Dans une entreprise à Toulouse, Marc se demande comment appliquer Art. L3121-27. Solution : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Art. L3121-27 du Code du travail', 'La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-27 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée légale du travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 174 — Temps de travail effectif', 'Point clé : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employ...', 'Cas pratique : Dans une entreprise à Toulouse, Léa se demande comment appliquer Art. L3121-1. Solution : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Art. L3121-1 du Code du travail', 'La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de travail effectif', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 175 — Temps de pause', 'Point clé : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d...', 'Cas pratique : Dans une entreprise à Nice, Thomas se demande comment appliquer Art. L3121-16. Solution : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Art. L3121-16 du Code du travail', 'Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-16 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de pause', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 176 — Durée quotidienne maximale', 'Point clé : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures....', 'Cas pratique : Dans une entreprise à Nice, Karim se demande comment appliquer Art. L3121-18. Solution : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Art. L3121-18 du Code du travail', 'Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-18 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée quotidienne maximale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 177 — Durée maximale hebdomadaire', 'Point clé : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures....', 'Cas pratique : Dans une entreprise à Nice, Awa se demande comment appliquer Art. L3121-20. Solution : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Art. L3121-20 du Code du travail', 'Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-20 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée maximale hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 178 — Travail de nuit', 'Point clé : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la ...', 'Cas pratique : Dans une entreprise à Montpellier, Julien se demande comment appliquer Art. L3122-1. Solution : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Art. L3122-1 du Code du travail', 'Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Conseil Expert : Assurez-vous que l''application de Art. L3122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'travail de nuit', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 179 — Repos quotidien', 'Point clé : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives....', 'Cas pratique : Dans une entreprise à Montpellier, Nadia se demande comment appliquer Art. L3131-1. Solution : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Art. L3131-1 du Code du travail', 'Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3131-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos quotidien', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 180 — Repos hebdomadaire', 'Point clé : Il est interdit de faire travailler un même salarié plus de six jours par semaine....', 'Cas pratique : Dans une entreprise à Montpellier, Camille se demande comment appliquer Art. L3132-1. Solution : Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Art. L3132-1 du Code du travail', 'Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 181 — Repos dominical', 'Point clé : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche....', 'Cas pratique : Dans une entreprise à Paris, Jean se demande comment appliquer Art. L3132-3. Solution : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Art. L3132-3 du Code du travail', 'Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos dominical', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 182 — Congés annuels', 'Point clé : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur....', 'Cas pratique : Dans une entreprise à Paris, Sophie se demande comment appliquer Art. L3141-1. Solution : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Art. L3141-1 du Code du travail', 'Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés annuels', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 183 — Calcul des congés', 'Point clé : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le m...', 'Cas pratique : Dans une entreprise à Paris, Marc se demande comment appliquer Art. L3141-3. Solution : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Art. L3141-3 du Code du travail', 'Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'calcul des congés', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 184 — Égalité de rémunération', 'Point clé : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunér...', 'Cas pratique : Dans une entreprise à Lyon, Léa se demande comment appliquer Art. L3221-2. Solution : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Art. L3221-2 du Code du travail', 'Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Conseil Expert : Assurez-vous que l''application de Art. L3221-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'égalité de rémunération', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 185 — Mensualisation du salaire', 'Point clé : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une qu...', 'Cas pratique : Dans une entreprise à Lyon, Thomas se demande comment appliquer Art. L3242-1. Solution : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Art. L3242-1 du Code du travail', 'Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Conseil Expert : Assurez-vous que l''application de Art. L3242-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'mensualisation du salaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 186 — Obligation de sécurité', 'Point clé : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et ...', 'Cas pratique : Dans une entreprise à Lyon, Karim se demande comment appliquer Art. L4121-1. Solution : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Art. L4121-1 du Code du travail', 'L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Conseil Expert : Assurez-vous que l''application de Art. L4121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation de sécurité', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 187 — Obligation du salarié (Sécurité)', 'Point clé : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilit...', 'Cas pratique : Dans une entreprise à Marseille, Awa se demande comment appliquer Art. L4122-1. Solution : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Art. L4122-1 du Code du travail', 'Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation du salarié (sécurité)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 188 — Définition de la sanction disciplinaire', 'Point clé : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la...', 'Cas pratique : Dans une entreprise à Marseille, Julien se demande comment appliquer Art. L1331-1. Solution : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Art. L1331-1 du Code du travail', 'Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Conseil Expert : Assurez-vous que l''application de Art. L1331-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'définition de la sanction disciplinaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 189 — Non-discrimination', 'Point clé : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun ...', 'Cas pratique : Dans une entreprise à Marseille, Nadia se demande comment appliquer Art. L1132-1. Solution : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Art. L1132-1 du Code du travail', 'Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Conseil Expert : Assurez-vous que l''application de Art. L1132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'non-discrimination', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 190 — Harcèlement moral', 'Point clé : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour ...', 'Cas pratique : Dans une entreprise à Lille, Camille se demande comment appliquer Art. L1152-1. Solution : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Art. L1152-1 du Code du travail', 'Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1152-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement moral', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 191 — Harcèlement sexuel', 'Point clé : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou c...', 'Cas pratique : Dans une entreprise à Lille, Jean se demande comment appliquer Art. L1153-1. Solution : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Art. L1153-1 du Code du travail', 'Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Conseil Expert : Assurez-vous que l''application de Art. L1153-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement sexuel', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 192 — Informations demandées au candidat', 'Point clé : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir...', 'Cas pratique : Dans une entreprise à Lille, Sophie se demande comment appliquer Art. L1221-6. Solution : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Art. L1221-6 du Code du travail', 'Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-6 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'informations demandées au candidat', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 193 — Protection maternité (Licenciement)', 'Point clé : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de gross...', 'Cas pratique : Dans une entreprise à Bordeaux, Marc se demande comment appliquer Art. L1225-4. Solution : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Art. L1225-4 du Code du travail', 'Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1225-4 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'protection maternité (licenciement)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 194 — Inaptitude non-professionnelle', 'Point clé : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait ...', 'Cas pratique : Dans une entreprise à Bordeaux, Léa se demande comment appliquer Art. L1226-2. Solution : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Art. L1226-2 du Code du travail', 'Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Conseil Expert : Assurez-vous que l''application de Art. L1226-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'inaptitude non-professionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 195 — Démission', 'Point clé : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention...', 'Cas pratique : Dans une entreprise à Bordeaux, Thomas se demande comment appliquer Art. L1237-1. Solution : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Art. L1237-1 du Code du travail', 'En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'démission', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 196 — Liberté syndicale', 'Point clé : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''...', 'Cas pratique : Dans une entreprise à Nantes, Karim se demande comment appliquer Art. L2141-1. Solution : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Art. L2141-1 du Code du travail', 'Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Conseil Expert : Assurez-vous que l''application de Art. L2141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'liberté syndicale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 197 — Application convention collective', 'Point clé : La convention collective applicable est celle dont relève l''activité principale exercée par l''employ...', 'Cas pratique : Dans une entreprise à Nantes, Awa se demande comment appliquer Art. L2261-2. Solution : La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Art. L2261-2 du Code du travail', 'La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L2261-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'application convention collective', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 198 — Missions du CSE', 'Point clé : Le comité social et économique a pour mission d''assurer une expression collective des salariés perme...', 'Cas pratique : Dans une entreprise à Nantes, Julien se demande comment appliquer Art. L2312-1. Solution : Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Art. L2312-1 du Code du travail', 'Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Conseil Expert : Assurez-vous que l''application de Art. L2312-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'missions du cse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 199 — Congés événements familiaux', 'Point clé : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mar...', 'Cas pratique : Dans une entreprise à Strasbourg, Nadia se demande comment appliquer Art. L3142-1. Solution : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Art. L3142-1 du Code du travail', 'Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Conseil Expert : Assurez-vous que l''application de Art. L3142-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés événements familiaux', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 200 — Visite d''information et de prévention', 'Point clé : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des profes...', 'Cas pratique : Dans une entreprise à Strasbourg, Camille se demande comment appliquer Art. L4612-1. Solution : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Art. L4612-1 du Code du travail', 'Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4612-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'visite d''information et de prévention', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 201 — La formation du contrat de travail', 'Point clé : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes qu...', 'Cas pratique : Dans une entreprise à Strasbourg, Jean se demande comment appliquer Art. L1221-1. Solution : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Art. L1221-1 du Code du travail', 'Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la formation du contrat de travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 202 — La période d''essai du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale...', 'Cas pratique : Dans une entreprise à Toulouse, Sophie se demande comment appliquer Art. L1221-19. Solution : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Art. L1221-19 du Code du travail', 'Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-19 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la période d''essai du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 203 — Renouvellement de la période d''essai', 'Point clé : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet acco...', 'Cas pratique : Dans une entreprise à Toulouse, Marc se demande comment appliquer Art. L1221-21. Solution : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Art. L1221-21 du Code du travail', 'La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-21 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'renouvellement de la période d''essai', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 204 — Délai de prévenance (Rupture période d''essai)', 'Point clé : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le sala...', 'Cas pratique : Dans une entreprise à Toulouse, Léa se demande comment appliquer Art. L1221-25. Solution : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Art. L1221-25 du Code du travail', 'Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-25 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'délai de prévenance (rupture période d''essai)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 205 — Exécution de bonne foi', 'Point clé : Le contrat de travail est exécuté de bonne foi....', 'Cas pratique : Dans une entreprise à Nice, Thomas se demande comment appliquer Art. L1222-1. Solution : Le contrat de travail est exécuté de bonne foi.', 'Art. L1222-1 du Code du travail', 'Le contrat de travail est exécuté de bonne foi.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'exécution de bonne foi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 206 — Le télétravail', 'Point clé : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait éga...', 'Cas pratique : Dans une entreprise à Nice, Karim se demande comment appliquer Art. L1222-9. Solution : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Art. L1222-9 du Code du travail', 'Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-9 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'le télétravail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 207 — Rupture du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salar...', 'Cas pratique : Dans une entreprise à Nice, Awa se demande comment appliquer Art. L1231-1. Solution : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Art. L1231-1 du Code du travail', 'Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Conseil Expert : Assurez-vous que l''application de Art. L1231-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 208 — Cause réelle et sérieuse', 'Point clé : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse....', 'Cas pratique : Dans une entreprise à Montpellier, Julien se demande comment appliquer Art. L1232-1. Solution : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Art. L1232-1 du Code du travail', 'Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Conseil Expert : Assurez-vous que l''application de Art. L1232-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'cause réelle et sérieuse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 209 — Licenciement économique', 'Point clé : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou...', 'Cas pratique : Dans une entreprise à Montpellier, Nadia se demande comment appliquer Art. L1233-3. Solution : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Art. L1233-3 du Code du travail', 'Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1233-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'licenciement économique', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 210 — Préavis de licenciement', 'Point clé : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est dé...', 'Cas pratique : Dans une entreprise à Montpellier, Camille se demande comment appliquer Art. L1234-1. Solution : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Art. L1234-1 du Code du travail', 'Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Conseil Expert : Assurez-vous que l''application de Art. L1234-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'préavis de licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 211 — Contestation du licenciement', 'Point clé : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et l...', 'Cas pratique : Dans une entreprise à Paris, Jean se demande comment appliquer Art. L1235-1. Solution : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Art. L1235-1 du Code du travail', 'En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1235-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'contestation du licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 212 — Rupture conventionnelle', 'Point clé : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contra...', 'Cas pratique : Dans une entreprise à Paris, Sophie se demande comment appliquer Art. L1237-11. Solution : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Art. L1237-11 du Code du travail', 'L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-11 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture conventionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 213 — Durée légale du travail', 'Point clé : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par ...', 'Cas pratique : Dans une entreprise à Paris, Marc se demande comment appliquer Art. L3121-27. Solution : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Art. L3121-27 du Code du travail', 'La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-27 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée légale du travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 214 — Temps de travail effectif', 'Point clé : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employ...', 'Cas pratique : Dans une entreprise à Lyon, Léa se demande comment appliquer Art. L3121-1. Solution : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Art. L3121-1 du Code du travail', 'La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de travail effectif', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 215 — Temps de pause', 'Point clé : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d...', 'Cas pratique : Dans une entreprise à Lyon, Thomas se demande comment appliquer Art. L3121-16. Solution : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Art. L3121-16 du Code du travail', 'Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-16 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de pause', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 216 — Durée quotidienne maximale', 'Point clé : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures....', 'Cas pratique : Dans une entreprise à Lyon, Karim se demande comment appliquer Art. L3121-18. Solution : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Art. L3121-18 du Code du travail', 'Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-18 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée quotidienne maximale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 217 — Durée maximale hebdomadaire', 'Point clé : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures....', 'Cas pratique : Dans une entreprise à Marseille, Awa se demande comment appliquer Art. L3121-20. Solution : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Art. L3121-20 du Code du travail', 'Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-20 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée maximale hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 218 — Travail de nuit', 'Point clé : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la ...', 'Cas pratique : Dans une entreprise à Marseille, Julien se demande comment appliquer Art. L3122-1. Solution : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Art. L3122-1 du Code du travail', 'Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Conseil Expert : Assurez-vous que l''application de Art. L3122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'travail de nuit', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 219 — Repos quotidien', 'Point clé : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives....', 'Cas pratique : Dans une entreprise à Marseille, Nadia se demande comment appliquer Art. L3131-1. Solution : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Art. L3131-1 du Code du travail', 'Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3131-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos quotidien', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 220 — Repos hebdomadaire', 'Point clé : Il est interdit de faire travailler un même salarié plus de six jours par semaine....', 'Cas pratique : Dans une entreprise à Lille, Camille se demande comment appliquer Art. L3132-1. Solution : Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Art. L3132-1 du Code du travail', 'Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 221 — Repos dominical', 'Point clé : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche....', 'Cas pratique : Dans une entreprise à Lille, Jean se demande comment appliquer Art. L3132-3. Solution : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Art. L3132-3 du Code du travail', 'Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos dominical', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 222 — Congés annuels', 'Point clé : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur....', 'Cas pratique : Dans une entreprise à Lille, Sophie se demande comment appliquer Art. L3141-1. Solution : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Art. L3141-1 du Code du travail', 'Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés annuels', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 223 — Calcul des congés', 'Point clé : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le m...', 'Cas pratique : Dans une entreprise à Bordeaux, Marc se demande comment appliquer Art. L3141-3. Solution : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Art. L3141-3 du Code du travail', 'Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'calcul des congés', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 224 — Égalité de rémunération', 'Point clé : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunér...', 'Cas pratique : Dans une entreprise à Bordeaux, Léa se demande comment appliquer Art. L3221-2. Solution : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Art. L3221-2 du Code du travail', 'Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Conseil Expert : Assurez-vous que l''application de Art. L3221-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'égalité de rémunération', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 225 — Mensualisation du salaire', 'Point clé : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une qu...', 'Cas pratique : Dans une entreprise à Bordeaux, Thomas se demande comment appliquer Art. L3242-1. Solution : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Art. L3242-1 du Code du travail', 'Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Conseil Expert : Assurez-vous que l''application de Art. L3242-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'mensualisation du salaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 226 — Obligation de sécurité', 'Point clé : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et ...', 'Cas pratique : Dans une entreprise à Nantes, Karim se demande comment appliquer Art. L4121-1. Solution : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Art. L4121-1 du Code du travail', 'L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Conseil Expert : Assurez-vous que l''application de Art. L4121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation de sécurité', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 227 — Obligation du salarié (Sécurité)', 'Point clé : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilit...', 'Cas pratique : Dans une entreprise à Nantes, Awa se demande comment appliquer Art. L4122-1. Solution : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Art. L4122-1 du Code du travail', 'Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation du salarié (sécurité)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 228 — Définition de la sanction disciplinaire', 'Point clé : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la...', 'Cas pratique : Dans une entreprise à Nantes, Julien se demande comment appliquer Art. L1331-1. Solution : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Art. L1331-1 du Code du travail', 'Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Conseil Expert : Assurez-vous que l''application de Art. L1331-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'définition de la sanction disciplinaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 229 — Non-discrimination', 'Point clé : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun ...', 'Cas pratique : Dans une entreprise à Strasbourg, Nadia se demande comment appliquer Art. L1132-1. Solution : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Art. L1132-1 du Code du travail', 'Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Conseil Expert : Assurez-vous que l''application de Art. L1132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'non-discrimination', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 230 — Harcèlement moral', 'Point clé : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour ...', 'Cas pratique : Dans une entreprise à Strasbourg, Camille se demande comment appliquer Art. L1152-1. Solution : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Art. L1152-1 du Code du travail', 'Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1152-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement moral', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 231 — Harcèlement sexuel', 'Point clé : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou c...', 'Cas pratique : Dans une entreprise à Strasbourg, Jean se demande comment appliquer Art. L1153-1. Solution : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Art. L1153-1 du Code du travail', 'Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Conseil Expert : Assurez-vous que l''application de Art. L1153-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement sexuel', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 232 — Informations demandées au candidat', 'Point clé : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir...', 'Cas pratique : Dans une entreprise à Toulouse, Sophie se demande comment appliquer Art. L1221-6. Solution : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Art. L1221-6 du Code du travail', 'Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-6 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'informations demandées au candidat', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 233 — Protection maternité (Licenciement)', 'Point clé : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de gross...', 'Cas pratique : Dans une entreprise à Toulouse, Marc se demande comment appliquer Art. L1225-4. Solution : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Art. L1225-4 du Code du travail', 'Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1225-4 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'protection maternité (licenciement)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 234 — Inaptitude non-professionnelle', 'Point clé : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait ...', 'Cas pratique : Dans une entreprise à Toulouse, Léa se demande comment appliquer Art. L1226-2. Solution : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Art. L1226-2 du Code du travail', 'Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Conseil Expert : Assurez-vous que l''application de Art. L1226-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'inaptitude non-professionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 235 — Démission', 'Point clé : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention...', 'Cas pratique : Dans une entreprise à Nice, Thomas se demande comment appliquer Art. L1237-1. Solution : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Art. L1237-1 du Code du travail', 'En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'démission', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 236 — Liberté syndicale', 'Point clé : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''...', 'Cas pratique : Dans une entreprise à Nice, Karim se demande comment appliquer Art. L2141-1. Solution : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Art. L2141-1 du Code du travail', 'Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Conseil Expert : Assurez-vous que l''application de Art. L2141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'liberté syndicale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 237 — Application convention collective', 'Point clé : La convention collective applicable est celle dont relève l''activité principale exercée par l''employ...', 'Cas pratique : Dans une entreprise à Nice, Awa se demande comment appliquer Art. L2261-2. Solution : La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Art. L2261-2 du Code du travail', 'La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L2261-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'application convention collective', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 238 — Missions du CSE', 'Point clé : Le comité social et économique a pour mission d''assurer une expression collective des salariés perme...', 'Cas pratique : Dans une entreprise à Montpellier, Julien se demande comment appliquer Art. L2312-1. Solution : Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Art. L2312-1 du Code du travail', 'Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Conseil Expert : Assurez-vous que l''application de Art. L2312-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'missions du cse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 239 — Congés événements familiaux', 'Point clé : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mar...', 'Cas pratique : Dans une entreprise à Montpellier, Nadia se demande comment appliquer Art. L3142-1. Solution : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Art. L3142-1 du Code du travail', 'Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Conseil Expert : Assurez-vous que l''application de Art. L3142-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés événements familiaux', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 240 — Visite d''information et de prévention', 'Point clé : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des profes...', 'Cas pratique : Dans une entreprise à Montpellier, Camille se demande comment appliquer Art. L4612-1. Solution : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Art. L4612-1 du Code du travail', 'Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4612-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'visite d''information et de prévention', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 241 — La formation du contrat de travail', 'Point clé : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes qu...', 'Cas pratique : Dans une entreprise à Paris, Jean se demande comment appliquer Art. L1221-1. Solution : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Art. L1221-1 du Code du travail', 'Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la formation du contrat de travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 242 — La période d''essai du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale...', 'Cas pratique : Dans une entreprise à Paris, Sophie se demande comment appliquer Art. L1221-19. Solution : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Art. L1221-19 du Code du travail', 'Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-19 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la période d''essai du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 243 — Renouvellement de la période d''essai', 'Point clé : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet acco...', 'Cas pratique : Dans une entreprise à Paris, Marc se demande comment appliquer Art. L1221-21. Solution : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Art. L1221-21 du Code du travail', 'La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-21 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'renouvellement de la période d''essai', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 244 — Délai de prévenance (Rupture période d''essai)', 'Point clé : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le sala...', 'Cas pratique : Dans une entreprise à Lyon, Léa se demande comment appliquer Art. L1221-25. Solution : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Art. L1221-25 du Code du travail', 'Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-25 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'délai de prévenance (rupture période d''essai)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 245 — Exécution de bonne foi', 'Point clé : Le contrat de travail est exécuté de bonne foi....', 'Cas pratique : Dans une entreprise à Lyon, Thomas se demande comment appliquer Art. L1222-1. Solution : Le contrat de travail est exécuté de bonne foi.', 'Art. L1222-1 du Code du travail', 'Le contrat de travail est exécuté de bonne foi.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'exécution de bonne foi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 246 — Le télétravail', 'Point clé : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait éga...', 'Cas pratique : Dans une entreprise à Lyon, Karim se demande comment appliquer Art. L1222-9. Solution : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Art. L1222-9 du Code du travail', 'Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-9 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'le télétravail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 247 — Rupture du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salar...', 'Cas pratique : Dans une entreprise à Marseille, Awa se demande comment appliquer Art. L1231-1. Solution : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Art. L1231-1 du Code du travail', 'Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Conseil Expert : Assurez-vous que l''application de Art. L1231-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 248 — Cause réelle et sérieuse', 'Point clé : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse....', 'Cas pratique : Dans une entreprise à Marseille, Julien se demande comment appliquer Art. L1232-1. Solution : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Art. L1232-1 du Code du travail', 'Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Conseil Expert : Assurez-vous que l''application de Art. L1232-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'cause réelle et sérieuse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 249 — Licenciement économique', 'Point clé : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou...', 'Cas pratique : Dans une entreprise à Marseille, Nadia se demande comment appliquer Art. L1233-3. Solution : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Art. L1233-3 du Code du travail', 'Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1233-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'licenciement économique', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 250 — Préavis de licenciement', 'Point clé : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est dé...', 'Cas pratique : Dans une entreprise à Lille, Camille se demande comment appliquer Art. L1234-1. Solution : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Art. L1234-1 du Code du travail', 'Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Conseil Expert : Assurez-vous que l''application de Art. L1234-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'préavis de licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 251 — Contestation du licenciement', 'Point clé : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et l...', 'Cas pratique : Dans une entreprise à Lille, Jean se demande comment appliquer Art. L1235-1. Solution : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Art. L1235-1 du Code du travail', 'En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1235-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'contestation du licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 252 — Rupture conventionnelle', 'Point clé : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contra...', 'Cas pratique : Dans une entreprise à Lille, Sophie se demande comment appliquer Art. L1237-11. Solution : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Art. L1237-11 du Code du travail', 'L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-11 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture conventionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 253 — Durée légale du travail', 'Point clé : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par ...', 'Cas pratique : Dans une entreprise à Bordeaux, Marc se demande comment appliquer Art. L3121-27. Solution : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Art. L3121-27 du Code du travail', 'La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-27 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée légale du travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 254 — Temps de travail effectif', 'Point clé : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employ...', 'Cas pratique : Dans une entreprise à Bordeaux, Léa se demande comment appliquer Art. L3121-1. Solution : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Art. L3121-1 du Code du travail', 'La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de travail effectif', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 255 — Temps de pause', 'Point clé : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d...', 'Cas pratique : Dans une entreprise à Bordeaux, Thomas se demande comment appliquer Art. L3121-16. Solution : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Art. L3121-16 du Code du travail', 'Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-16 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de pause', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 256 — Durée quotidienne maximale', 'Point clé : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures....', 'Cas pratique : Dans une entreprise à Nantes, Karim se demande comment appliquer Art. L3121-18. Solution : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Art. L3121-18 du Code du travail', 'Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-18 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée quotidienne maximale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 257 — Durée maximale hebdomadaire', 'Point clé : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures....', 'Cas pratique : Dans une entreprise à Nantes, Awa se demande comment appliquer Art. L3121-20. Solution : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Art. L3121-20 du Code du travail', 'Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-20 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée maximale hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 258 — Travail de nuit', 'Point clé : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la ...', 'Cas pratique : Dans une entreprise à Nantes, Julien se demande comment appliquer Art. L3122-1. Solution : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Art. L3122-1 du Code du travail', 'Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Conseil Expert : Assurez-vous que l''application de Art. L3122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'travail de nuit', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 259 — Repos quotidien', 'Point clé : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives....', 'Cas pratique : Dans une entreprise à Strasbourg, Nadia se demande comment appliquer Art. L3131-1. Solution : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Art. L3131-1 du Code du travail', 'Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3131-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos quotidien', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 260 — Repos hebdomadaire', 'Point clé : Il est interdit de faire travailler un même salarié plus de six jours par semaine....', 'Cas pratique : Dans une entreprise à Strasbourg, Camille se demande comment appliquer Art. L3132-1. Solution : Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Art. L3132-1 du Code du travail', 'Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 261 — Repos dominical', 'Point clé : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche....', 'Cas pratique : Dans une entreprise à Strasbourg, Jean se demande comment appliquer Art. L3132-3. Solution : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Art. L3132-3 du Code du travail', 'Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos dominical', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 262 — Congés annuels', 'Point clé : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur....', 'Cas pratique : Dans une entreprise à Toulouse, Sophie se demande comment appliquer Art. L3141-1. Solution : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Art. L3141-1 du Code du travail', 'Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés annuels', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 263 — Calcul des congés', 'Point clé : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le m...', 'Cas pratique : Dans une entreprise à Toulouse, Marc se demande comment appliquer Art. L3141-3. Solution : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Art. L3141-3 du Code du travail', 'Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'calcul des congés', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 264 — Égalité de rémunération', 'Point clé : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunér...', 'Cas pratique : Dans une entreprise à Toulouse, Léa se demande comment appliquer Art. L3221-2. Solution : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Art. L3221-2 du Code du travail', 'Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Conseil Expert : Assurez-vous que l''application de Art. L3221-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'égalité de rémunération', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 265 — Mensualisation du salaire', 'Point clé : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une qu...', 'Cas pratique : Dans une entreprise à Nice, Thomas se demande comment appliquer Art. L3242-1. Solution : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Art. L3242-1 du Code du travail', 'Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Conseil Expert : Assurez-vous que l''application de Art. L3242-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'mensualisation du salaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 266 — Obligation de sécurité', 'Point clé : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et ...', 'Cas pratique : Dans une entreprise à Nice, Karim se demande comment appliquer Art. L4121-1. Solution : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Art. L4121-1 du Code du travail', 'L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Conseil Expert : Assurez-vous que l''application de Art. L4121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation de sécurité', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 267 — Obligation du salarié (Sécurité)', 'Point clé : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilit...', 'Cas pratique : Dans une entreprise à Nice, Awa se demande comment appliquer Art. L4122-1. Solution : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Art. L4122-1 du Code du travail', 'Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation du salarié (sécurité)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 268 — Définition de la sanction disciplinaire', 'Point clé : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la...', 'Cas pratique : Dans une entreprise à Montpellier, Julien se demande comment appliquer Art. L1331-1. Solution : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Art. L1331-1 du Code du travail', 'Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Conseil Expert : Assurez-vous que l''application de Art. L1331-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'définition de la sanction disciplinaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 269 — Non-discrimination', 'Point clé : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun ...', 'Cas pratique : Dans une entreprise à Montpellier, Nadia se demande comment appliquer Art. L1132-1. Solution : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Art. L1132-1 du Code du travail', 'Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Conseil Expert : Assurez-vous que l''application de Art. L1132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'non-discrimination', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 270 — Harcèlement moral', 'Point clé : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour ...', 'Cas pratique : Dans une entreprise à Montpellier, Camille se demande comment appliquer Art. L1152-1. Solution : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Art. L1152-1 du Code du travail', 'Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1152-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement moral', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 271 — Harcèlement sexuel', 'Point clé : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou c...', 'Cas pratique : Dans une entreprise à Paris, Jean se demande comment appliquer Art. L1153-1. Solution : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Art. L1153-1 du Code du travail', 'Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Conseil Expert : Assurez-vous que l''application de Art. L1153-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement sexuel', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 272 — Informations demandées au candidat', 'Point clé : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir...', 'Cas pratique : Dans une entreprise à Paris, Sophie se demande comment appliquer Art. L1221-6. Solution : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Art. L1221-6 du Code du travail', 'Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-6 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'informations demandées au candidat', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 273 — Protection maternité (Licenciement)', 'Point clé : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de gross...', 'Cas pratique : Dans une entreprise à Paris, Marc se demande comment appliquer Art. L1225-4. Solution : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Art. L1225-4 du Code du travail', 'Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1225-4 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'protection maternité (licenciement)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 274 — Inaptitude non-professionnelle', 'Point clé : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait ...', 'Cas pratique : Dans une entreprise à Lyon, Léa se demande comment appliquer Art. L1226-2. Solution : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Art. L1226-2 du Code du travail', 'Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Conseil Expert : Assurez-vous que l''application de Art. L1226-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'inaptitude non-professionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 275 — Démission', 'Point clé : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention...', 'Cas pratique : Dans une entreprise à Lyon, Thomas se demande comment appliquer Art. L1237-1. Solution : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Art. L1237-1 du Code du travail', 'En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'démission', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 276 — Liberté syndicale', 'Point clé : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''...', 'Cas pratique : Dans une entreprise à Lyon, Karim se demande comment appliquer Art. L2141-1. Solution : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Art. L2141-1 du Code du travail', 'Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Conseil Expert : Assurez-vous que l''application de Art. L2141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'liberté syndicale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 277 — Application convention collective', 'Point clé : La convention collective applicable est celle dont relève l''activité principale exercée par l''employ...', 'Cas pratique : Dans une entreprise à Marseille, Awa se demande comment appliquer Art. L2261-2. Solution : La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Art. L2261-2 du Code du travail', 'La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L2261-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'application convention collective', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 278 — Missions du CSE', 'Point clé : Le comité social et économique a pour mission d''assurer une expression collective des salariés perme...', 'Cas pratique : Dans une entreprise à Marseille, Julien se demande comment appliquer Art. L2312-1. Solution : Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Art. L2312-1 du Code du travail', 'Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Conseil Expert : Assurez-vous que l''application de Art. L2312-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'missions du cse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 279 — Congés événements familiaux', 'Point clé : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mar...', 'Cas pratique : Dans une entreprise à Marseille, Nadia se demande comment appliquer Art. L3142-1. Solution : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Art. L3142-1 du Code du travail', 'Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Conseil Expert : Assurez-vous que l''application de Art. L3142-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés événements familiaux', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 280 — Visite d''information et de prévention', 'Point clé : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des profes...', 'Cas pratique : Dans une entreprise à Lille, Camille se demande comment appliquer Art. L4612-1. Solution : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Art. L4612-1 du Code du travail', 'Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4612-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'visite d''information et de prévention', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 281 — La formation du contrat de travail', 'Point clé : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes qu...', 'Cas pratique : Dans une entreprise à Lille, Jean se demande comment appliquer Art. L1221-1. Solution : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Art. L1221-1 du Code du travail', 'Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la formation du contrat de travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 282 — La période d''essai du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale...', 'Cas pratique : Dans une entreprise à Lille, Sophie se demande comment appliquer Art. L1221-19. Solution : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Art. L1221-19 du Code du travail', 'Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-19 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la période d''essai du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 283 — Renouvellement de la période d''essai', 'Point clé : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet acco...', 'Cas pratique : Dans une entreprise à Bordeaux, Marc se demande comment appliquer Art. L1221-21. Solution : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Art. L1221-21 du Code du travail', 'La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-21 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'renouvellement de la période d''essai', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 284 — Délai de prévenance (Rupture période d''essai)', 'Point clé : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le sala...', 'Cas pratique : Dans une entreprise à Bordeaux, Léa se demande comment appliquer Art. L1221-25. Solution : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Art. L1221-25 du Code du travail', 'Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-25 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'délai de prévenance (rupture période d''essai)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 285 — Exécution de bonne foi', 'Point clé : Le contrat de travail est exécuté de bonne foi....', 'Cas pratique : Dans une entreprise à Bordeaux, Thomas se demande comment appliquer Art. L1222-1. Solution : Le contrat de travail est exécuté de bonne foi.', 'Art. L1222-1 du Code du travail', 'Le contrat de travail est exécuté de bonne foi.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'exécution de bonne foi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 286 — Le télétravail', 'Point clé : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait éga...', 'Cas pratique : Dans une entreprise à Nantes, Karim se demande comment appliquer Art. L1222-9. Solution : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Art. L1222-9 du Code du travail', 'Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-9 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'le télétravail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 287 — Rupture du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salar...', 'Cas pratique : Dans une entreprise à Nantes, Awa se demande comment appliquer Art. L1231-1. Solution : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Art. L1231-1 du Code du travail', 'Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Conseil Expert : Assurez-vous que l''application de Art. L1231-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 288 — Cause réelle et sérieuse', 'Point clé : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse....', 'Cas pratique : Dans une entreprise à Nantes, Julien se demande comment appliquer Art. L1232-1. Solution : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Art. L1232-1 du Code du travail', 'Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Conseil Expert : Assurez-vous que l''application de Art. L1232-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'cause réelle et sérieuse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 289 — Licenciement économique', 'Point clé : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou...', 'Cas pratique : Dans une entreprise à Strasbourg, Nadia se demande comment appliquer Art. L1233-3. Solution : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Art. L1233-3 du Code du travail', 'Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1233-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'licenciement économique', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 290 — Préavis de licenciement', 'Point clé : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est dé...', 'Cas pratique : Dans une entreprise à Strasbourg, Camille se demande comment appliquer Art. L1234-1. Solution : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Art. L1234-1 du Code du travail', 'Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Conseil Expert : Assurez-vous que l''application de Art. L1234-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'préavis de licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 291 — Contestation du licenciement', 'Point clé : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et l...', 'Cas pratique : Dans une entreprise à Strasbourg, Jean se demande comment appliquer Art. L1235-1. Solution : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Art. L1235-1 du Code du travail', 'En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1235-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'contestation du licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 292 — Rupture conventionnelle', 'Point clé : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contra...', 'Cas pratique : Dans une entreprise à Toulouse, Sophie se demande comment appliquer Art. L1237-11. Solution : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Art. L1237-11 du Code du travail', 'L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-11 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture conventionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 293 — Durée légale du travail', 'Point clé : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par ...', 'Cas pratique : Dans une entreprise à Toulouse, Marc se demande comment appliquer Art. L3121-27. Solution : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Art. L3121-27 du Code du travail', 'La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-27 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée légale du travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 294 — Temps de travail effectif', 'Point clé : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employ...', 'Cas pratique : Dans une entreprise à Toulouse, Léa se demande comment appliquer Art. L3121-1. Solution : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Art. L3121-1 du Code du travail', 'La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de travail effectif', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 295 — Temps de pause', 'Point clé : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d...', 'Cas pratique : Dans une entreprise à Nice, Thomas se demande comment appliquer Art. L3121-16. Solution : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Art. L3121-16 du Code du travail', 'Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-16 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de pause', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 296 — Durée quotidienne maximale', 'Point clé : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures....', 'Cas pratique : Dans une entreprise à Nice, Karim se demande comment appliquer Art. L3121-18. Solution : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Art. L3121-18 du Code du travail', 'Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-18 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée quotidienne maximale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 297 — Durée maximale hebdomadaire', 'Point clé : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures....', 'Cas pratique : Dans une entreprise à Nice, Awa se demande comment appliquer Art. L3121-20. Solution : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Art. L3121-20 du Code du travail', 'Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-20 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée maximale hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 298 — Travail de nuit', 'Point clé : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la ...', 'Cas pratique : Dans une entreprise à Montpellier, Julien se demande comment appliquer Art. L3122-1. Solution : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Art. L3122-1 du Code du travail', 'Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Conseil Expert : Assurez-vous que l''application de Art. L3122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'travail de nuit', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 299 — Repos quotidien', 'Point clé : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives....', 'Cas pratique : Dans une entreprise à Montpellier, Nadia se demande comment appliquer Art. L3131-1. Solution : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Art. L3131-1 du Code du travail', 'Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3131-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos quotidien', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 300 — Repos hebdomadaire', 'Point clé : Il est interdit de faire travailler un même salarié plus de six jours par semaine....', 'Cas pratique : Dans une entreprise à Montpellier, Camille se demande comment appliquer Art. L3132-1. Solution : Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Art. L3132-1 du Code du travail', 'Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 301 — Repos dominical', 'Point clé : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche....', 'Cas pratique : Dans une entreprise à Paris, Jean se demande comment appliquer Art. L3132-3. Solution : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Art. L3132-3 du Code du travail', 'Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos dominical', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 302 — Congés annuels', 'Point clé : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur....', 'Cas pratique : Dans une entreprise à Paris, Sophie se demande comment appliquer Art. L3141-1. Solution : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Art. L3141-1 du Code du travail', 'Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés annuels', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 303 — Calcul des congés', 'Point clé : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le m...', 'Cas pratique : Dans une entreprise à Paris, Marc se demande comment appliquer Art. L3141-3. Solution : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Art. L3141-3 du Code du travail', 'Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'calcul des congés', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 304 — Égalité de rémunération', 'Point clé : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunér...', 'Cas pratique : Dans une entreprise à Lyon, Léa se demande comment appliquer Art. L3221-2. Solution : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Art. L3221-2 du Code du travail', 'Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Conseil Expert : Assurez-vous que l''application de Art. L3221-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'égalité de rémunération', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 305 — Mensualisation du salaire', 'Point clé : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une qu...', 'Cas pratique : Dans une entreprise à Lyon, Thomas se demande comment appliquer Art. L3242-1. Solution : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Art. L3242-1 du Code du travail', 'Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Conseil Expert : Assurez-vous que l''application de Art. L3242-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'mensualisation du salaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 306 — Obligation de sécurité', 'Point clé : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et ...', 'Cas pratique : Dans une entreprise à Lyon, Karim se demande comment appliquer Art. L4121-1. Solution : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Art. L4121-1 du Code du travail', 'L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Conseil Expert : Assurez-vous que l''application de Art. L4121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation de sécurité', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 307 — Obligation du salarié (Sécurité)', 'Point clé : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilit...', 'Cas pratique : Dans une entreprise à Marseille, Awa se demande comment appliquer Art. L4122-1. Solution : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Art. L4122-1 du Code du travail', 'Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation du salarié (sécurité)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 308 — Définition de la sanction disciplinaire', 'Point clé : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la...', 'Cas pratique : Dans une entreprise à Marseille, Julien se demande comment appliquer Art. L1331-1. Solution : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Art. L1331-1 du Code du travail', 'Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Conseil Expert : Assurez-vous que l''application de Art. L1331-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'définition de la sanction disciplinaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 309 — Non-discrimination', 'Point clé : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun ...', 'Cas pratique : Dans une entreprise à Marseille, Nadia se demande comment appliquer Art. L1132-1. Solution : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Art. L1132-1 du Code du travail', 'Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Conseil Expert : Assurez-vous que l''application de Art. L1132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'non-discrimination', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 310 — Harcèlement moral', 'Point clé : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour ...', 'Cas pratique : Dans une entreprise à Lille, Camille se demande comment appliquer Art. L1152-1. Solution : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Art. L1152-1 du Code du travail', 'Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1152-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement moral', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 311 — Harcèlement sexuel', 'Point clé : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou c...', 'Cas pratique : Dans une entreprise à Lille, Jean se demande comment appliquer Art. L1153-1. Solution : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Art. L1153-1 du Code du travail', 'Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Conseil Expert : Assurez-vous que l''application de Art. L1153-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement sexuel', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 312 — Informations demandées au candidat', 'Point clé : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir...', 'Cas pratique : Dans une entreprise à Lille, Sophie se demande comment appliquer Art. L1221-6. Solution : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Art. L1221-6 du Code du travail', 'Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-6 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'informations demandées au candidat', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 313 — Protection maternité (Licenciement)', 'Point clé : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de gross...', 'Cas pratique : Dans une entreprise à Bordeaux, Marc se demande comment appliquer Art. L1225-4. Solution : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Art. L1225-4 du Code du travail', 'Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1225-4 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'protection maternité (licenciement)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 314 — Inaptitude non-professionnelle', 'Point clé : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait ...', 'Cas pratique : Dans une entreprise à Bordeaux, Léa se demande comment appliquer Art. L1226-2. Solution : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Art. L1226-2 du Code du travail', 'Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Conseil Expert : Assurez-vous que l''application de Art. L1226-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'inaptitude non-professionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 315 — Démission', 'Point clé : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention...', 'Cas pratique : Dans une entreprise à Bordeaux, Thomas se demande comment appliquer Art. L1237-1. Solution : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Art. L1237-1 du Code du travail', 'En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'démission', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 316 — Liberté syndicale', 'Point clé : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''...', 'Cas pratique : Dans une entreprise à Nantes, Karim se demande comment appliquer Art. L2141-1. Solution : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Art. L2141-1 du Code du travail', 'Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Conseil Expert : Assurez-vous que l''application de Art. L2141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'liberté syndicale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 317 — Application convention collective', 'Point clé : La convention collective applicable est celle dont relève l''activité principale exercée par l''employ...', 'Cas pratique : Dans une entreprise à Nantes, Awa se demande comment appliquer Art. L2261-2. Solution : La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Art. L2261-2 du Code du travail', 'La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L2261-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'application convention collective', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 318 — Missions du CSE', 'Point clé : Le comité social et économique a pour mission d''assurer une expression collective des salariés perme...', 'Cas pratique : Dans une entreprise à Nantes, Julien se demande comment appliquer Art. L2312-1. Solution : Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Art. L2312-1 du Code du travail', 'Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Conseil Expert : Assurez-vous que l''application de Art. L2312-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'missions du cse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 319 — Congés événements familiaux', 'Point clé : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mar...', 'Cas pratique : Dans une entreprise à Strasbourg, Nadia se demande comment appliquer Art. L3142-1. Solution : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Art. L3142-1 du Code du travail', 'Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Conseil Expert : Assurez-vous que l''application de Art. L3142-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés événements familiaux', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 320 — Visite d''information et de prévention', 'Point clé : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des profes...', 'Cas pratique : Dans une entreprise à Strasbourg, Camille se demande comment appliquer Art. L4612-1. Solution : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Art. L4612-1 du Code du travail', 'Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4612-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'visite d''information et de prévention', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 321 — La formation du contrat de travail', 'Point clé : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes qu...', 'Cas pratique : Dans une entreprise à Strasbourg, Jean se demande comment appliquer Art. L1221-1. Solution : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Art. L1221-1 du Code du travail', 'Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la formation du contrat de travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 322 — La période d''essai du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale...', 'Cas pratique : Dans une entreprise à Toulouse, Sophie se demande comment appliquer Art. L1221-19. Solution : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Art. L1221-19 du Code du travail', 'Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-19 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la période d''essai du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 323 — Renouvellement de la période d''essai', 'Point clé : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet acco...', 'Cas pratique : Dans une entreprise à Toulouse, Marc se demande comment appliquer Art. L1221-21. Solution : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Art. L1221-21 du Code du travail', 'La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-21 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'renouvellement de la période d''essai', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 324 — Délai de prévenance (Rupture période d''essai)', 'Point clé : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le sala...', 'Cas pratique : Dans une entreprise à Toulouse, Léa se demande comment appliquer Art. L1221-25. Solution : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Art. L1221-25 du Code du travail', 'Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-25 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'délai de prévenance (rupture période d''essai)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 325 — Exécution de bonne foi', 'Point clé : Le contrat de travail est exécuté de bonne foi....', 'Cas pratique : Dans une entreprise à Nice, Thomas se demande comment appliquer Art. L1222-1. Solution : Le contrat de travail est exécuté de bonne foi.', 'Art. L1222-1 du Code du travail', 'Le contrat de travail est exécuté de bonne foi.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'exécution de bonne foi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 326 — Le télétravail', 'Point clé : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait éga...', 'Cas pratique : Dans une entreprise à Nice, Karim se demande comment appliquer Art. L1222-9. Solution : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Art. L1222-9 du Code du travail', 'Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-9 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'le télétravail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 327 — Rupture du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salar...', 'Cas pratique : Dans une entreprise à Nice, Awa se demande comment appliquer Art. L1231-1. Solution : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Art. L1231-1 du Code du travail', 'Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Conseil Expert : Assurez-vous que l''application de Art. L1231-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 328 — Cause réelle et sérieuse', 'Point clé : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse....', 'Cas pratique : Dans une entreprise à Montpellier, Julien se demande comment appliquer Art. L1232-1. Solution : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Art. L1232-1 du Code du travail', 'Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Conseil Expert : Assurez-vous que l''application de Art. L1232-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'cause réelle et sérieuse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 329 — Licenciement économique', 'Point clé : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou...', 'Cas pratique : Dans une entreprise à Montpellier, Nadia se demande comment appliquer Art. L1233-3. Solution : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Art. L1233-3 du Code du travail', 'Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1233-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'licenciement économique', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 330 — Préavis de licenciement', 'Point clé : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est dé...', 'Cas pratique : Dans une entreprise à Montpellier, Camille se demande comment appliquer Art. L1234-1. Solution : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Art. L1234-1 du Code du travail', 'Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Conseil Expert : Assurez-vous que l''application de Art. L1234-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'préavis de licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 331 — Contestation du licenciement', 'Point clé : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et l...', 'Cas pratique : Dans une entreprise à Paris, Jean se demande comment appliquer Art. L1235-1. Solution : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Art. L1235-1 du Code du travail', 'En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1235-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'contestation du licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 332 — Rupture conventionnelle', 'Point clé : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contra...', 'Cas pratique : Dans une entreprise à Paris, Sophie se demande comment appliquer Art. L1237-11. Solution : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Art. L1237-11 du Code du travail', 'L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-11 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture conventionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 333 — Durée légale du travail', 'Point clé : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par ...', 'Cas pratique : Dans une entreprise à Paris, Marc se demande comment appliquer Art. L3121-27. Solution : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Art. L3121-27 du Code du travail', 'La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-27 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée légale du travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 334 — Temps de travail effectif', 'Point clé : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employ...', 'Cas pratique : Dans une entreprise à Lyon, Léa se demande comment appliquer Art. L3121-1. Solution : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Art. L3121-1 du Code du travail', 'La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de travail effectif', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 335 — Temps de pause', 'Point clé : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d...', 'Cas pratique : Dans une entreprise à Lyon, Thomas se demande comment appliquer Art. L3121-16. Solution : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Art. L3121-16 du Code du travail', 'Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-16 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de pause', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 336 — Durée quotidienne maximale', 'Point clé : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures....', 'Cas pratique : Dans une entreprise à Lyon, Karim se demande comment appliquer Art. L3121-18. Solution : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Art. L3121-18 du Code du travail', 'Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-18 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée quotidienne maximale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 337 — Durée maximale hebdomadaire', 'Point clé : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures....', 'Cas pratique : Dans une entreprise à Marseille, Awa se demande comment appliquer Art. L3121-20. Solution : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Art. L3121-20 du Code du travail', 'Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-20 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée maximale hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 338 — Travail de nuit', 'Point clé : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la ...', 'Cas pratique : Dans une entreprise à Marseille, Julien se demande comment appliquer Art. L3122-1. Solution : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Art. L3122-1 du Code du travail', 'Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Conseil Expert : Assurez-vous que l''application de Art. L3122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'travail de nuit', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 339 — Repos quotidien', 'Point clé : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives....', 'Cas pratique : Dans une entreprise à Marseille, Nadia se demande comment appliquer Art. L3131-1. Solution : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Art. L3131-1 du Code du travail', 'Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3131-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos quotidien', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 340 — Repos hebdomadaire', 'Point clé : Il est interdit de faire travailler un même salarié plus de six jours par semaine....', 'Cas pratique : Dans une entreprise à Lille, Camille se demande comment appliquer Art. L3132-1. Solution : Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Art. L3132-1 du Code du travail', 'Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 341 — Repos dominical', 'Point clé : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche....', 'Cas pratique : Dans une entreprise à Lille, Jean se demande comment appliquer Art. L3132-3. Solution : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Art. L3132-3 du Code du travail', 'Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos dominical', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 342 — Congés annuels', 'Point clé : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur....', 'Cas pratique : Dans une entreprise à Lille, Sophie se demande comment appliquer Art. L3141-1. Solution : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Art. L3141-1 du Code du travail', 'Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés annuels', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 343 — Calcul des congés', 'Point clé : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le m...', 'Cas pratique : Dans une entreprise à Bordeaux, Marc se demande comment appliquer Art. L3141-3. Solution : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Art. L3141-3 du Code du travail', 'Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'calcul des congés', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 344 — Égalité de rémunération', 'Point clé : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunér...', 'Cas pratique : Dans une entreprise à Bordeaux, Léa se demande comment appliquer Art. L3221-2. Solution : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Art. L3221-2 du Code du travail', 'Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Conseil Expert : Assurez-vous que l''application de Art. L3221-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'égalité de rémunération', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 345 — Mensualisation du salaire', 'Point clé : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une qu...', 'Cas pratique : Dans une entreprise à Bordeaux, Thomas se demande comment appliquer Art. L3242-1. Solution : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Art. L3242-1 du Code du travail', 'Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Conseil Expert : Assurez-vous que l''application de Art. L3242-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'mensualisation du salaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 346 — Obligation de sécurité', 'Point clé : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et ...', 'Cas pratique : Dans une entreprise à Nantes, Karim se demande comment appliquer Art. L4121-1. Solution : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Art. L4121-1 du Code du travail', 'L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Conseil Expert : Assurez-vous que l''application de Art. L4121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation de sécurité', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 347 — Obligation du salarié (Sécurité)', 'Point clé : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilit...', 'Cas pratique : Dans une entreprise à Nantes, Awa se demande comment appliquer Art. L4122-1. Solution : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Art. L4122-1 du Code du travail', 'Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation du salarié (sécurité)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 348 — Définition de la sanction disciplinaire', 'Point clé : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la...', 'Cas pratique : Dans une entreprise à Nantes, Julien se demande comment appliquer Art. L1331-1. Solution : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Art. L1331-1 du Code du travail', 'Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Conseil Expert : Assurez-vous que l''application de Art. L1331-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'définition de la sanction disciplinaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 349 — Non-discrimination', 'Point clé : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun ...', 'Cas pratique : Dans une entreprise à Strasbourg, Nadia se demande comment appliquer Art. L1132-1. Solution : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Art. L1132-1 du Code du travail', 'Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Conseil Expert : Assurez-vous que l''application de Art. L1132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'non-discrimination', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 350 — Harcèlement moral', 'Point clé : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour ...', 'Cas pratique : Dans une entreprise à Strasbourg, Camille se demande comment appliquer Art. L1152-1. Solution : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Art. L1152-1 du Code du travail', 'Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1152-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement moral', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 351 — Harcèlement sexuel', 'Point clé : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou c...', 'Cas pratique : Dans une entreprise à Strasbourg, Jean se demande comment appliquer Art. L1153-1. Solution : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Art. L1153-1 du Code du travail', 'Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Conseil Expert : Assurez-vous que l''application de Art. L1153-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement sexuel', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 352 — Informations demandées au candidat', 'Point clé : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir...', 'Cas pratique : Dans une entreprise à Toulouse, Sophie se demande comment appliquer Art. L1221-6. Solution : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Art. L1221-6 du Code du travail', 'Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-6 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'informations demandées au candidat', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 353 — Protection maternité (Licenciement)', 'Point clé : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de gross...', 'Cas pratique : Dans une entreprise à Toulouse, Marc se demande comment appliquer Art. L1225-4. Solution : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Art. L1225-4 du Code du travail', 'Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1225-4 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'protection maternité (licenciement)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 354 — Inaptitude non-professionnelle', 'Point clé : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait ...', 'Cas pratique : Dans une entreprise à Toulouse, Léa se demande comment appliquer Art. L1226-2. Solution : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Art. L1226-2 du Code du travail', 'Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Conseil Expert : Assurez-vous que l''application de Art. L1226-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'inaptitude non-professionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 355 — Démission', 'Point clé : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention...', 'Cas pratique : Dans une entreprise à Nice, Thomas se demande comment appliquer Art. L1237-1. Solution : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Art. L1237-1 du Code du travail', 'En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'démission', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 356 — Liberté syndicale', 'Point clé : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''...', 'Cas pratique : Dans une entreprise à Nice, Karim se demande comment appliquer Art. L2141-1. Solution : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Art. L2141-1 du Code du travail', 'Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Conseil Expert : Assurez-vous que l''application de Art. L2141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'liberté syndicale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 357 — Application convention collective', 'Point clé : La convention collective applicable est celle dont relève l''activité principale exercée par l''employ...', 'Cas pratique : Dans une entreprise à Nice, Awa se demande comment appliquer Art. L2261-2. Solution : La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Art. L2261-2 du Code du travail', 'La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L2261-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'application convention collective', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 358 — Missions du CSE', 'Point clé : Le comité social et économique a pour mission d''assurer une expression collective des salariés perme...', 'Cas pratique : Dans une entreprise à Montpellier, Julien se demande comment appliquer Art. L2312-1. Solution : Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Art. L2312-1 du Code du travail', 'Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Conseil Expert : Assurez-vous que l''application de Art. L2312-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'missions du cse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 359 — Congés événements familiaux', 'Point clé : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mar...', 'Cas pratique : Dans une entreprise à Montpellier, Nadia se demande comment appliquer Art. L3142-1. Solution : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Art. L3142-1 du Code du travail', 'Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Conseil Expert : Assurez-vous que l''application de Art. L3142-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés événements familiaux', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 360 — Visite d''information et de prévention', 'Point clé : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des profes...', 'Cas pratique : Dans une entreprise à Montpellier, Camille se demande comment appliquer Art. L4612-1. Solution : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Art. L4612-1 du Code du travail', 'Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4612-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'visite d''information et de prévention', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 361 — La formation du contrat de travail', 'Point clé : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes qu...', 'Cas pratique : Dans une entreprise à Paris, Jean se demande comment appliquer Art. L1221-1. Solution : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Art. L1221-1 du Code du travail', 'Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la formation du contrat de travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 362 — La période d''essai du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale...', 'Cas pratique : Dans une entreprise à Paris, Sophie se demande comment appliquer Art. L1221-19. Solution : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Art. L1221-19 du Code du travail', 'Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-19 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la période d''essai du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 363 — Renouvellement de la période d''essai', 'Point clé : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet acco...', 'Cas pratique : Dans une entreprise à Paris, Marc se demande comment appliquer Art. L1221-21. Solution : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Art. L1221-21 du Code du travail', 'La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-21 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'renouvellement de la période d''essai', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 364 — Délai de prévenance (Rupture période d''essai)', 'Point clé : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le sala...', 'Cas pratique : Dans une entreprise à Lyon, Léa se demande comment appliquer Art. L1221-25. Solution : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Art. L1221-25 du Code du travail', 'Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-25 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'délai de prévenance (rupture période d''essai)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 365 — Exécution de bonne foi', 'Point clé : Le contrat de travail est exécuté de bonne foi....', 'Cas pratique : Dans une entreprise à Lyon, Thomas se demande comment appliquer Art. L1222-1. Solution : Le contrat de travail est exécuté de bonne foi.', 'Art. L1222-1 du Code du travail', 'Le contrat de travail est exécuté de bonne foi.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'exécution de bonne foi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 366 — Le télétravail', 'Point clé : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait éga...', 'Cas pratique : Dans une entreprise à Lyon, Karim se demande comment appliquer Art. L1222-9. Solution : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Art. L1222-9 du Code du travail', 'Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-9 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'le télétravail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 367 — Rupture du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salar...', 'Cas pratique : Dans une entreprise à Marseille, Awa se demande comment appliquer Art. L1231-1. Solution : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Art. L1231-1 du Code du travail', 'Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Conseil Expert : Assurez-vous que l''application de Art. L1231-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 368 — Cause réelle et sérieuse', 'Point clé : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse....', 'Cas pratique : Dans une entreprise à Marseille, Julien se demande comment appliquer Art. L1232-1. Solution : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Art. L1232-1 du Code du travail', 'Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Conseil Expert : Assurez-vous que l''application de Art. L1232-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'cause réelle et sérieuse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 369 — Licenciement économique', 'Point clé : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou...', 'Cas pratique : Dans une entreprise à Marseille, Nadia se demande comment appliquer Art. L1233-3. Solution : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Art. L1233-3 du Code du travail', 'Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1233-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'licenciement économique', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 370 — Préavis de licenciement', 'Point clé : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est dé...', 'Cas pratique : Dans une entreprise à Lille, Camille se demande comment appliquer Art. L1234-1. Solution : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Art. L1234-1 du Code du travail', 'Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Conseil Expert : Assurez-vous que l''application de Art. L1234-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'préavis de licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 371 — Contestation du licenciement', 'Point clé : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et l...', 'Cas pratique : Dans une entreprise à Lille, Jean se demande comment appliquer Art. L1235-1. Solution : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Art. L1235-1 du Code du travail', 'En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1235-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'contestation du licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 372 — Rupture conventionnelle', 'Point clé : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contra...', 'Cas pratique : Dans une entreprise à Lille, Sophie se demande comment appliquer Art. L1237-11. Solution : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Art. L1237-11 du Code du travail', 'L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-11 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture conventionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 373 — Durée légale du travail', 'Point clé : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par ...', 'Cas pratique : Dans une entreprise à Bordeaux, Marc se demande comment appliquer Art. L3121-27. Solution : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Art. L3121-27 du Code du travail', 'La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-27 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée légale du travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 374 — Temps de travail effectif', 'Point clé : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employ...', 'Cas pratique : Dans une entreprise à Bordeaux, Léa se demande comment appliquer Art. L3121-1. Solution : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Art. L3121-1 du Code du travail', 'La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de travail effectif', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 375 — Temps de pause', 'Point clé : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d...', 'Cas pratique : Dans une entreprise à Bordeaux, Thomas se demande comment appliquer Art. L3121-16. Solution : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Art. L3121-16 du Code du travail', 'Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-16 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de pause', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 376 — Durée quotidienne maximale', 'Point clé : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures....', 'Cas pratique : Dans une entreprise à Nantes, Karim se demande comment appliquer Art. L3121-18. Solution : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Art. L3121-18 du Code du travail', 'Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-18 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée quotidienne maximale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 377 — Durée maximale hebdomadaire', 'Point clé : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures....', 'Cas pratique : Dans une entreprise à Nantes, Awa se demande comment appliquer Art. L3121-20. Solution : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Art. L3121-20 du Code du travail', 'Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-20 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée maximale hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 378 — Travail de nuit', 'Point clé : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la ...', 'Cas pratique : Dans une entreprise à Nantes, Julien se demande comment appliquer Art. L3122-1. Solution : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Art. L3122-1 du Code du travail', 'Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Conseil Expert : Assurez-vous que l''application de Art. L3122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'travail de nuit', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 379 — Repos quotidien', 'Point clé : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives....', 'Cas pratique : Dans une entreprise à Strasbourg, Nadia se demande comment appliquer Art. L3131-1. Solution : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Art. L3131-1 du Code du travail', 'Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3131-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos quotidien', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 380 — Repos hebdomadaire', 'Point clé : Il est interdit de faire travailler un même salarié plus de six jours par semaine....', 'Cas pratique : Dans une entreprise à Strasbourg, Camille se demande comment appliquer Art. L3132-1. Solution : Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Art. L3132-1 du Code du travail', 'Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 381 — Repos dominical', 'Point clé : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche....', 'Cas pratique : Dans une entreprise à Strasbourg, Jean se demande comment appliquer Art. L3132-3. Solution : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Art. L3132-3 du Code du travail', 'Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos dominical', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 382 — Congés annuels', 'Point clé : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur....', 'Cas pratique : Dans une entreprise à Toulouse, Sophie se demande comment appliquer Art. L3141-1. Solution : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Art. L3141-1 du Code du travail', 'Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés annuels', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 383 — Calcul des congés', 'Point clé : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le m...', 'Cas pratique : Dans une entreprise à Toulouse, Marc se demande comment appliquer Art. L3141-3. Solution : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Art. L3141-3 du Code du travail', 'Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'calcul des congés', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 384 — Égalité de rémunération', 'Point clé : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunér...', 'Cas pratique : Dans une entreprise à Toulouse, Léa se demande comment appliquer Art. L3221-2. Solution : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Art. L3221-2 du Code du travail', 'Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Conseil Expert : Assurez-vous que l''application de Art. L3221-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'égalité de rémunération', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 385 — Mensualisation du salaire', 'Point clé : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une qu...', 'Cas pratique : Dans une entreprise à Nice, Thomas se demande comment appliquer Art. L3242-1. Solution : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Art. L3242-1 du Code du travail', 'Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Conseil Expert : Assurez-vous que l''application de Art. L3242-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'mensualisation du salaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 386 — Obligation de sécurité', 'Point clé : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et ...', 'Cas pratique : Dans une entreprise à Nice, Karim se demande comment appliquer Art. L4121-1. Solution : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Art. L4121-1 du Code du travail', 'L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Conseil Expert : Assurez-vous que l''application de Art. L4121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation de sécurité', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 387 — Obligation du salarié (Sécurité)', 'Point clé : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilit...', 'Cas pratique : Dans une entreprise à Nice, Awa se demande comment appliquer Art. L4122-1. Solution : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Art. L4122-1 du Code du travail', 'Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation du salarié (sécurité)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 388 — Définition de la sanction disciplinaire', 'Point clé : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la...', 'Cas pratique : Dans une entreprise à Montpellier, Julien se demande comment appliquer Art. L1331-1. Solution : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Art. L1331-1 du Code du travail', 'Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Conseil Expert : Assurez-vous que l''application de Art. L1331-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'définition de la sanction disciplinaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 389 — Non-discrimination', 'Point clé : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun ...', 'Cas pratique : Dans une entreprise à Montpellier, Nadia se demande comment appliquer Art. L1132-1. Solution : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Art. L1132-1 du Code du travail', 'Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Conseil Expert : Assurez-vous que l''application de Art. L1132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'non-discrimination', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 390 — Harcèlement moral', 'Point clé : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour ...', 'Cas pratique : Dans une entreprise à Montpellier, Camille se demande comment appliquer Art. L1152-1. Solution : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Art. L1152-1 du Code du travail', 'Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1152-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement moral', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 391 — Harcèlement sexuel', 'Point clé : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou c...', 'Cas pratique : Dans une entreprise à Paris, Jean se demande comment appliquer Art. L1153-1. Solution : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Art. L1153-1 du Code du travail', 'Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Conseil Expert : Assurez-vous que l''application de Art. L1153-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement sexuel', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 392 — Informations demandées au candidat', 'Point clé : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir...', 'Cas pratique : Dans une entreprise à Paris, Sophie se demande comment appliquer Art. L1221-6. Solution : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Art. L1221-6 du Code du travail', 'Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-6 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'informations demandées au candidat', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 393 — Protection maternité (Licenciement)', 'Point clé : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de gross...', 'Cas pratique : Dans une entreprise à Paris, Marc se demande comment appliquer Art. L1225-4. Solution : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Art. L1225-4 du Code du travail', 'Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1225-4 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'protection maternité (licenciement)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 394 — Inaptitude non-professionnelle', 'Point clé : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait ...', 'Cas pratique : Dans une entreprise à Lyon, Léa se demande comment appliquer Art. L1226-2. Solution : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Art. L1226-2 du Code du travail', 'Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Conseil Expert : Assurez-vous que l''application de Art. L1226-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'inaptitude non-professionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 395 — Démission', 'Point clé : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention...', 'Cas pratique : Dans une entreprise à Lyon, Thomas se demande comment appliquer Art. L1237-1. Solution : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Art. L1237-1 du Code du travail', 'En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'démission', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 396 — Liberté syndicale', 'Point clé : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''...', 'Cas pratique : Dans une entreprise à Lyon, Karim se demande comment appliquer Art. L2141-1. Solution : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Art. L2141-1 du Code du travail', 'Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Conseil Expert : Assurez-vous que l''application de Art. L2141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'liberté syndicale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 397 — Application convention collective', 'Point clé : La convention collective applicable est celle dont relève l''activité principale exercée par l''employ...', 'Cas pratique : Dans une entreprise à Marseille, Awa se demande comment appliquer Art. L2261-2. Solution : La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Art. L2261-2 du Code du travail', 'La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L2261-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'application convention collective', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 398 — Missions du CSE', 'Point clé : Le comité social et économique a pour mission d''assurer une expression collective des salariés perme...', 'Cas pratique : Dans une entreprise à Marseille, Julien se demande comment appliquer Art. L2312-1. Solution : Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Art. L2312-1 du Code du travail', 'Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Conseil Expert : Assurez-vous que l''application de Art. L2312-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'missions du cse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 399 — Congés événements familiaux', 'Point clé : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mar...', 'Cas pratique : Dans une entreprise à Marseille, Nadia se demande comment appliquer Art. L3142-1. Solution : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Art. L3142-1 du Code du travail', 'Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Conseil Expert : Assurez-vous que l''application de Art. L3142-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés événements familiaux', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 400 — Visite d''information et de prévention', 'Point clé : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des profes...', 'Cas pratique : Dans une entreprise à Lille, Camille se demande comment appliquer Art. L4612-1. Solution : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Art. L4612-1 du Code du travail', 'Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4612-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'visite d''information et de prévention', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 401 — La formation du contrat de travail', 'Point clé : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes qu...', 'Cas pratique : Dans une entreprise à Lille, Jean se demande comment appliquer Art. L1221-1. Solution : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Art. L1221-1 du Code du travail', 'Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la formation du contrat de travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 402 — La période d''essai du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale...', 'Cas pratique : Dans une entreprise à Lille, Sophie se demande comment appliquer Art. L1221-19. Solution : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Art. L1221-19 du Code du travail', 'Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-19 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la période d''essai du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 403 — Renouvellement de la période d''essai', 'Point clé : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet acco...', 'Cas pratique : Dans une entreprise à Bordeaux, Marc se demande comment appliquer Art. L1221-21. Solution : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Art. L1221-21 du Code du travail', 'La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-21 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'renouvellement de la période d''essai', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 404 — Délai de prévenance (Rupture période d''essai)', 'Point clé : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le sala...', 'Cas pratique : Dans une entreprise à Bordeaux, Léa se demande comment appliquer Art. L1221-25. Solution : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Art. L1221-25 du Code du travail', 'Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-25 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'délai de prévenance (rupture période d''essai)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 405 — Exécution de bonne foi', 'Point clé : Le contrat de travail est exécuté de bonne foi....', 'Cas pratique : Dans une entreprise à Bordeaux, Thomas se demande comment appliquer Art. L1222-1. Solution : Le contrat de travail est exécuté de bonne foi.', 'Art. L1222-1 du Code du travail', 'Le contrat de travail est exécuté de bonne foi.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'exécution de bonne foi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 406 — Le télétravail', 'Point clé : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait éga...', 'Cas pratique : Dans une entreprise à Nantes, Karim se demande comment appliquer Art. L1222-9. Solution : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Art. L1222-9 du Code du travail', 'Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-9 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'le télétravail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 407 — Rupture du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salar...', 'Cas pratique : Dans une entreprise à Nantes, Awa se demande comment appliquer Art. L1231-1. Solution : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Art. L1231-1 du Code du travail', 'Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Conseil Expert : Assurez-vous que l''application de Art. L1231-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 408 — Cause réelle et sérieuse', 'Point clé : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse....', 'Cas pratique : Dans une entreprise à Nantes, Julien se demande comment appliquer Art. L1232-1. Solution : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Art. L1232-1 du Code du travail', 'Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Conseil Expert : Assurez-vous que l''application de Art. L1232-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'cause réelle et sérieuse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 409 — Licenciement économique', 'Point clé : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou...', 'Cas pratique : Dans une entreprise à Strasbourg, Nadia se demande comment appliquer Art. L1233-3. Solution : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Art. L1233-3 du Code du travail', 'Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1233-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'licenciement économique', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 410 — Préavis de licenciement', 'Point clé : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est dé...', 'Cas pratique : Dans une entreprise à Strasbourg, Camille se demande comment appliquer Art. L1234-1. Solution : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Art. L1234-1 du Code du travail', 'Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Conseil Expert : Assurez-vous que l''application de Art. L1234-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'préavis de licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 411 — Contestation du licenciement', 'Point clé : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et l...', 'Cas pratique : Dans une entreprise à Strasbourg, Jean se demande comment appliquer Art. L1235-1. Solution : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Art. L1235-1 du Code du travail', 'En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1235-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'contestation du licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 412 — Rupture conventionnelle', 'Point clé : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contra...', 'Cas pratique : Dans une entreprise à Toulouse, Sophie se demande comment appliquer Art. L1237-11. Solution : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Art. L1237-11 du Code du travail', 'L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-11 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture conventionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 413 — Durée légale du travail', 'Point clé : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par ...', 'Cas pratique : Dans une entreprise à Toulouse, Marc se demande comment appliquer Art. L3121-27. Solution : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Art. L3121-27 du Code du travail', 'La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-27 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée légale du travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 414 — Temps de travail effectif', 'Point clé : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employ...', 'Cas pratique : Dans une entreprise à Toulouse, Léa se demande comment appliquer Art. L3121-1. Solution : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Art. L3121-1 du Code du travail', 'La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de travail effectif', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 415 — Temps de pause', 'Point clé : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d...', 'Cas pratique : Dans une entreprise à Nice, Thomas se demande comment appliquer Art. L3121-16. Solution : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Art. L3121-16 du Code du travail', 'Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-16 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de pause', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 416 — Durée quotidienne maximale', 'Point clé : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures....', 'Cas pratique : Dans une entreprise à Nice, Karim se demande comment appliquer Art. L3121-18. Solution : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Art. L3121-18 du Code du travail', 'Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-18 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée quotidienne maximale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 417 — Durée maximale hebdomadaire', 'Point clé : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures....', 'Cas pratique : Dans une entreprise à Nice, Awa se demande comment appliquer Art. L3121-20. Solution : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Art. L3121-20 du Code du travail', 'Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-20 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée maximale hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 418 — Travail de nuit', 'Point clé : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la ...', 'Cas pratique : Dans une entreprise à Montpellier, Julien se demande comment appliquer Art. L3122-1. Solution : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Art. L3122-1 du Code du travail', 'Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Conseil Expert : Assurez-vous que l''application de Art. L3122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'travail de nuit', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 419 — Repos quotidien', 'Point clé : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives....', 'Cas pratique : Dans une entreprise à Montpellier, Nadia se demande comment appliquer Art. L3131-1. Solution : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Art. L3131-1 du Code du travail', 'Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3131-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos quotidien', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 420 — Repos hebdomadaire', 'Point clé : Il est interdit de faire travailler un même salarié plus de six jours par semaine....', 'Cas pratique : Dans une entreprise à Montpellier, Camille se demande comment appliquer Art. L3132-1. Solution : Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Art. L3132-1 du Code du travail', 'Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 421 — Repos dominical', 'Point clé : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche....', 'Cas pratique : Dans une entreprise à Paris, Jean se demande comment appliquer Art. L3132-3. Solution : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Art. L3132-3 du Code du travail', 'Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos dominical', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 422 — Congés annuels', 'Point clé : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur....', 'Cas pratique : Dans une entreprise à Paris, Sophie se demande comment appliquer Art. L3141-1. Solution : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Art. L3141-1 du Code du travail', 'Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés annuels', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 423 — Calcul des congés', 'Point clé : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le m...', 'Cas pratique : Dans une entreprise à Paris, Marc se demande comment appliquer Art. L3141-3. Solution : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Art. L3141-3 du Code du travail', 'Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'calcul des congés', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 424 — Égalité de rémunération', 'Point clé : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunér...', 'Cas pratique : Dans une entreprise à Lyon, Léa se demande comment appliquer Art. L3221-2. Solution : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Art. L3221-2 du Code du travail', 'Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Conseil Expert : Assurez-vous que l''application de Art. L3221-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'égalité de rémunération', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 425 — Mensualisation du salaire', 'Point clé : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une qu...', 'Cas pratique : Dans une entreprise à Lyon, Thomas se demande comment appliquer Art. L3242-1. Solution : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Art. L3242-1 du Code du travail', 'Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Conseil Expert : Assurez-vous que l''application de Art. L3242-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'mensualisation du salaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 426 — Obligation de sécurité', 'Point clé : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et ...', 'Cas pratique : Dans une entreprise à Lyon, Karim se demande comment appliquer Art. L4121-1. Solution : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Art. L4121-1 du Code du travail', 'L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Conseil Expert : Assurez-vous que l''application de Art. L4121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation de sécurité', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 427 — Obligation du salarié (Sécurité)', 'Point clé : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilit...', 'Cas pratique : Dans une entreprise à Marseille, Awa se demande comment appliquer Art. L4122-1. Solution : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Art. L4122-1 du Code du travail', 'Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation du salarié (sécurité)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 428 — Définition de la sanction disciplinaire', 'Point clé : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la...', 'Cas pratique : Dans une entreprise à Marseille, Julien se demande comment appliquer Art. L1331-1. Solution : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Art. L1331-1 du Code du travail', 'Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Conseil Expert : Assurez-vous que l''application de Art. L1331-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'définition de la sanction disciplinaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 429 — Non-discrimination', 'Point clé : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun ...', 'Cas pratique : Dans une entreprise à Marseille, Nadia se demande comment appliquer Art. L1132-1. Solution : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Art. L1132-1 du Code du travail', 'Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Conseil Expert : Assurez-vous que l''application de Art. L1132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'non-discrimination', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 430 — Harcèlement moral', 'Point clé : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour ...', 'Cas pratique : Dans une entreprise à Lille, Camille se demande comment appliquer Art. L1152-1. Solution : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Art. L1152-1 du Code du travail', 'Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1152-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement moral', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 431 — Harcèlement sexuel', 'Point clé : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou c...', 'Cas pratique : Dans une entreprise à Lille, Jean se demande comment appliquer Art. L1153-1. Solution : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Art. L1153-1 du Code du travail', 'Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Conseil Expert : Assurez-vous que l''application de Art. L1153-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement sexuel', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 432 — Informations demandées au candidat', 'Point clé : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir...', 'Cas pratique : Dans une entreprise à Lille, Sophie se demande comment appliquer Art. L1221-6. Solution : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Art. L1221-6 du Code du travail', 'Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-6 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'informations demandées au candidat', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 433 — Protection maternité (Licenciement)', 'Point clé : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de gross...', 'Cas pratique : Dans une entreprise à Bordeaux, Marc se demande comment appliquer Art. L1225-4. Solution : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Art. L1225-4 du Code du travail', 'Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1225-4 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'protection maternité (licenciement)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 434 — Inaptitude non-professionnelle', 'Point clé : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait ...', 'Cas pratique : Dans une entreprise à Bordeaux, Léa se demande comment appliquer Art. L1226-2. Solution : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Art. L1226-2 du Code du travail', 'Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Conseil Expert : Assurez-vous que l''application de Art. L1226-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'inaptitude non-professionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 435 — Démission', 'Point clé : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention...', 'Cas pratique : Dans une entreprise à Bordeaux, Thomas se demande comment appliquer Art. L1237-1. Solution : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Art. L1237-1 du Code du travail', 'En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'démission', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 436 — Liberté syndicale', 'Point clé : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''...', 'Cas pratique : Dans une entreprise à Nantes, Karim se demande comment appliquer Art. L2141-1. Solution : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Art. L2141-1 du Code du travail', 'Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Conseil Expert : Assurez-vous que l''application de Art. L2141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'liberté syndicale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 437 — Application convention collective', 'Point clé : La convention collective applicable est celle dont relève l''activité principale exercée par l''employ...', 'Cas pratique : Dans une entreprise à Nantes, Awa se demande comment appliquer Art. L2261-2. Solution : La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Art. L2261-2 du Code du travail', 'La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L2261-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'application convention collective', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 438 — Missions du CSE', 'Point clé : Le comité social et économique a pour mission d''assurer une expression collective des salariés perme...', 'Cas pratique : Dans une entreprise à Nantes, Julien se demande comment appliquer Art. L2312-1. Solution : Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Art. L2312-1 du Code du travail', 'Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Conseil Expert : Assurez-vous que l''application de Art. L2312-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'missions du cse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 439 — Congés événements familiaux', 'Point clé : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mar...', 'Cas pratique : Dans une entreprise à Strasbourg, Nadia se demande comment appliquer Art. L3142-1. Solution : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Art. L3142-1 du Code du travail', 'Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Conseil Expert : Assurez-vous que l''application de Art. L3142-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés événements familiaux', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 440 — Visite d''information et de prévention', 'Point clé : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des profes...', 'Cas pratique : Dans une entreprise à Strasbourg, Camille se demande comment appliquer Art. L4612-1. Solution : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Art. L4612-1 du Code du travail', 'Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4612-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'visite d''information et de prévention', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 441 — La formation du contrat de travail', 'Point clé : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes qu...', 'Cas pratique : Dans une entreprise à Strasbourg, Jean se demande comment appliquer Art. L1221-1. Solution : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Art. L1221-1 du Code du travail', 'Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la formation du contrat de travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 442 — La période d''essai du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale...', 'Cas pratique : Dans une entreprise à Toulouse, Sophie se demande comment appliquer Art. L1221-19. Solution : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Art. L1221-19 du Code du travail', 'Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-19 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la période d''essai du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 443 — Renouvellement de la période d''essai', 'Point clé : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet acco...', 'Cas pratique : Dans une entreprise à Toulouse, Marc se demande comment appliquer Art. L1221-21. Solution : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Art. L1221-21 du Code du travail', 'La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-21 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'renouvellement de la période d''essai', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 444 — Délai de prévenance (Rupture période d''essai)', 'Point clé : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le sala...', 'Cas pratique : Dans une entreprise à Toulouse, Léa se demande comment appliquer Art. L1221-25. Solution : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Art. L1221-25 du Code du travail', 'Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-25 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'délai de prévenance (rupture période d''essai)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 445 — Exécution de bonne foi', 'Point clé : Le contrat de travail est exécuté de bonne foi....', 'Cas pratique : Dans une entreprise à Nice, Thomas se demande comment appliquer Art. L1222-1. Solution : Le contrat de travail est exécuté de bonne foi.', 'Art. L1222-1 du Code du travail', 'Le contrat de travail est exécuté de bonne foi.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'exécution de bonne foi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 446 — Le télétravail', 'Point clé : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait éga...', 'Cas pratique : Dans une entreprise à Nice, Karim se demande comment appliquer Art. L1222-9. Solution : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Art. L1222-9 du Code du travail', 'Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-9 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'le télétravail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 447 — Rupture du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salar...', 'Cas pratique : Dans une entreprise à Nice, Awa se demande comment appliquer Art. L1231-1. Solution : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Art. L1231-1 du Code du travail', 'Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Conseil Expert : Assurez-vous que l''application de Art. L1231-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 448 — Cause réelle et sérieuse', 'Point clé : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse....', 'Cas pratique : Dans une entreprise à Montpellier, Julien se demande comment appliquer Art. L1232-1. Solution : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Art. L1232-1 du Code du travail', 'Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Conseil Expert : Assurez-vous que l''application de Art. L1232-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'cause réelle et sérieuse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 449 — Licenciement économique', 'Point clé : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou...', 'Cas pratique : Dans une entreprise à Montpellier, Nadia se demande comment appliquer Art. L1233-3. Solution : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Art. L1233-3 du Code du travail', 'Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1233-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'licenciement économique', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 450 — Préavis de licenciement', 'Point clé : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est dé...', 'Cas pratique : Dans une entreprise à Montpellier, Camille se demande comment appliquer Art. L1234-1. Solution : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Art. L1234-1 du Code du travail', 'Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Conseil Expert : Assurez-vous que l''application de Art. L1234-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'préavis de licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 451 — Contestation du licenciement', 'Point clé : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et l...', 'Cas pratique : Dans une entreprise à Paris, Jean se demande comment appliquer Art. L1235-1. Solution : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Art. L1235-1 du Code du travail', 'En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1235-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'contestation du licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 452 — Rupture conventionnelle', 'Point clé : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contra...', 'Cas pratique : Dans une entreprise à Paris, Sophie se demande comment appliquer Art. L1237-11. Solution : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Art. L1237-11 du Code du travail', 'L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-11 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture conventionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 453 — Durée légale du travail', 'Point clé : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par ...', 'Cas pratique : Dans une entreprise à Paris, Marc se demande comment appliquer Art. L3121-27. Solution : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Art. L3121-27 du Code du travail', 'La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-27 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée légale du travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 454 — Temps de travail effectif', 'Point clé : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employ...', 'Cas pratique : Dans une entreprise à Lyon, Léa se demande comment appliquer Art. L3121-1. Solution : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Art. L3121-1 du Code du travail', 'La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de travail effectif', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 455 — Temps de pause', 'Point clé : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d...', 'Cas pratique : Dans une entreprise à Lyon, Thomas se demande comment appliquer Art. L3121-16. Solution : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Art. L3121-16 du Code du travail', 'Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-16 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de pause', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 456 — Durée quotidienne maximale', 'Point clé : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures....', 'Cas pratique : Dans une entreprise à Lyon, Karim se demande comment appliquer Art. L3121-18. Solution : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Art. L3121-18 du Code du travail', 'Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-18 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée quotidienne maximale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 457 — Durée maximale hebdomadaire', 'Point clé : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures....', 'Cas pratique : Dans une entreprise à Marseille, Awa se demande comment appliquer Art. L3121-20. Solution : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Art. L3121-20 du Code du travail', 'Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-20 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée maximale hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 458 — Travail de nuit', 'Point clé : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la ...', 'Cas pratique : Dans une entreprise à Marseille, Julien se demande comment appliquer Art. L3122-1. Solution : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Art. L3122-1 du Code du travail', 'Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Conseil Expert : Assurez-vous que l''application de Art. L3122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'travail de nuit', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 459 — Repos quotidien', 'Point clé : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives....', 'Cas pratique : Dans une entreprise à Marseille, Nadia se demande comment appliquer Art. L3131-1. Solution : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Art. L3131-1 du Code du travail', 'Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3131-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos quotidien', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 460 — Repos hebdomadaire', 'Point clé : Il est interdit de faire travailler un même salarié plus de six jours par semaine....', 'Cas pratique : Dans une entreprise à Lille, Camille se demande comment appliquer Art. L3132-1. Solution : Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Art. L3132-1 du Code du travail', 'Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 461 — Repos dominical', 'Point clé : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche....', 'Cas pratique : Dans une entreprise à Lille, Jean se demande comment appliquer Art. L3132-3. Solution : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Art. L3132-3 du Code du travail', 'Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos dominical', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 462 — Congés annuels', 'Point clé : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur....', 'Cas pratique : Dans une entreprise à Lille, Sophie se demande comment appliquer Art. L3141-1. Solution : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Art. L3141-1 du Code du travail', 'Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés annuels', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 463 — Calcul des congés', 'Point clé : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le m...', 'Cas pratique : Dans une entreprise à Bordeaux, Marc se demande comment appliquer Art. L3141-3. Solution : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Art. L3141-3 du Code du travail', 'Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'calcul des congés', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 464 — Égalité de rémunération', 'Point clé : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunér...', 'Cas pratique : Dans une entreprise à Bordeaux, Léa se demande comment appliquer Art. L3221-2. Solution : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Art. L3221-2 du Code du travail', 'Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Conseil Expert : Assurez-vous que l''application de Art. L3221-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'égalité de rémunération', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 465 — Mensualisation du salaire', 'Point clé : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une qu...', 'Cas pratique : Dans une entreprise à Bordeaux, Thomas se demande comment appliquer Art. L3242-1. Solution : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Art. L3242-1 du Code du travail', 'Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Conseil Expert : Assurez-vous que l''application de Art. L3242-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'mensualisation du salaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 466 — Obligation de sécurité', 'Point clé : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et ...', 'Cas pratique : Dans une entreprise à Nantes, Karim se demande comment appliquer Art. L4121-1. Solution : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Art. L4121-1 du Code du travail', 'L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Conseil Expert : Assurez-vous que l''application de Art. L4121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation de sécurité', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 467 — Obligation du salarié (Sécurité)', 'Point clé : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilit...', 'Cas pratique : Dans une entreprise à Nantes, Awa se demande comment appliquer Art. L4122-1. Solution : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Art. L4122-1 du Code du travail', 'Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation du salarié (sécurité)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 468 — Définition de la sanction disciplinaire', 'Point clé : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la...', 'Cas pratique : Dans une entreprise à Nantes, Julien se demande comment appliquer Art. L1331-1. Solution : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Art. L1331-1 du Code du travail', 'Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Conseil Expert : Assurez-vous que l''application de Art. L1331-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'définition de la sanction disciplinaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 469 — Non-discrimination', 'Point clé : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun ...', 'Cas pratique : Dans une entreprise à Strasbourg, Nadia se demande comment appliquer Art. L1132-1. Solution : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Art. L1132-1 du Code du travail', 'Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Conseil Expert : Assurez-vous que l''application de Art. L1132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'non-discrimination', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 470 — Harcèlement moral', 'Point clé : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour ...', 'Cas pratique : Dans une entreprise à Strasbourg, Camille se demande comment appliquer Art. L1152-1. Solution : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Art. L1152-1 du Code du travail', 'Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1152-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement moral', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 471 — Harcèlement sexuel', 'Point clé : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou c...', 'Cas pratique : Dans une entreprise à Strasbourg, Jean se demande comment appliquer Art. L1153-1. Solution : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Art. L1153-1 du Code du travail', 'Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Conseil Expert : Assurez-vous que l''application de Art. L1153-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement sexuel', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 472 — Informations demandées au candidat', 'Point clé : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir...', 'Cas pratique : Dans une entreprise à Toulouse, Sophie se demande comment appliquer Art. L1221-6. Solution : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Art. L1221-6 du Code du travail', 'Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-6 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'informations demandées au candidat', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 473 — Protection maternité (Licenciement)', 'Point clé : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de gross...', 'Cas pratique : Dans une entreprise à Toulouse, Marc se demande comment appliquer Art. L1225-4. Solution : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Art. L1225-4 du Code du travail', 'Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1225-4 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'protection maternité (licenciement)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 474 — Inaptitude non-professionnelle', 'Point clé : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait ...', 'Cas pratique : Dans une entreprise à Toulouse, Léa se demande comment appliquer Art. L1226-2. Solution : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Art. L1226-2 du Code du travail', 'Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Conseil Expert : Assurez-vous que l''application de Art. L1226-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'inaptitude non-professionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 475 — Démission', 'Point clé : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention...', 'Cas pratique : Dans une entreprise à Nice, Thomas se demande comment appliquer Art. L1237-1. Solution : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Art. L1237-1 du Code du travail', 'En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'démission', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 476 — Liberté syndicale', 'Point clé : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''...', 'Cas pratique : Dans une entreprise à Nice, Karim se demande comment appliquer Art. L2141-1. Solution : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Art. L2141-1 du Code du travail', 'Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Conseil Expert : Assurez-vous que l''application de Art. L2141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'liberté syndicale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 477 — Application convention collective', 'Point clé : La convention collective applicable est celle dont relève l''activité principale exercée par l''employ...', 'Cas pratique : Dans une entreprise à Nice, Awa se demande comment appliquer Art. L2261-2. Solution : La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Art. L2261-2 du Code du travail', 'La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L2261-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'application convention collective', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 478 — Missions du CSE', 'Point clé : Le comité social et économique a pour mission d''assurer une expression collective des salariés perme...', 'Cas pratique : Dans une entreprise à Montpellier, Julien se demande comment appliquer Art. L2312-1. Solution : Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Art. L2312-1 du Code du travail', 'Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Conseil Expert : Assurez-vous que l''application de Art. L2312-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'missions du cse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 479 — Congés événements familiaux', 'Point clé : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mar...', 'Cas pratique : Dans une entreprise à Montpellier, Nadia se demande comment appliquer Art. L3142-1. Solution : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Art. L3142-1 du Code du travail', 'Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Conseil Expert : Assurez-vous que l''application de Art. L3142-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés événements familiaux', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 480 — Visite d''information et de prévention', 'Point clé : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des profes...', 'Cas pratique : Dans une entreprise à Montpellier, Camille se demande comment appliquer Art. L4612-1. Solution : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Art. L4612-1 du Code du travail', 'Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4612-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'visite d''information et de prévention', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 481 — La formation du contrat de travail', 'Point clé : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes qu...', 'Cas pratique : Dans une entreprise à Paris, Jean se demande comment appliquer Art. L1221-1. Solution : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Art. L1221-1 du Code du travail', 'Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la formation du contrat de travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 482 — La période d''essai du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale...', 'Cas pratique : Dans une entreprise à Paris, Sophie se demande comment appliquer Art. L1221-19. Solution : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Art. L1221-19 du Code du travail', 'Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-19 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la période d''essai du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 483 — Renouvellement de la période d''essai', 'Point clé : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet acco...', 'Cas pratique : Dans une entreprise à Paris, Marc se demande comment appliquer Art. L1221-21. Solution : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Art. L1221-21 du Code du travail', 'La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-21 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'renouvellement de la période d''essai', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 484 — Délai de prévenance (Rupture période d''essai)', 'Point clé : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le sala...', 'Cas pratique : Dans une entreprise à Lyon, Léa se demande comment appliquer Art. L1221-25. Solution : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Art. L1221-25 du Code du travail', 'Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-25 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'délai de prévenance (rupture période d''essai)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 485 — Exécution de bonne foi', 'Point clé : Le contrat de travail est exécuté de bonne foi....', 'Cas pratique : Dans une entreprise à Lyon, Thomas se demande comment appliquer Art. L1222-1. Solution : Le contrat de travail est exécuté de bonne foi.', 'Art. L1222-1 du Code du travail', 'Le contrat de travail est exécuté de bonne foi.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'exécution de bonne foi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 486 — Le télétravail', 'Point clé : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait éga...', 'Cas pratique : Dans une entreprise à Lyon, Karim se demande comment appliquer Art. L1222-9. Solution : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Art. L1222-9 du Code du travail', 'Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-9 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'le télétravail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 487 — Rupture du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salar...', 'Cas pratique : Dans une entreprise à Marseille, Awa se demande comment appliquer Art. L1231-1. Solution : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Art. L1231-1 du Code du travail', 'Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Conseil Expert : Assurez-vous que l''application de Art. L1231-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 488 — Cause réelle et sérieuse', 'Point clé : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse....', 'Cas pratique : Dans une entreprise à Marseille, Julien se demande comment appliquer Art. L1232-1. Solution : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Art. L1232-1 du Code du travail', 'Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Conseil Expert : Assurez-vous que l''application de Art. L1232-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'cause réelle et sérieuse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 489 — Licenciement économique', 'Point clé : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou...', 'Cas pratique : Dans une entreprise à Marseille, Nadia se demande comment appliquer Art. L1233-3. Solution : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Art. L1233-3 du Code du travail', 'Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1233-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'licenciement économique', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 490 — Préavis de licenciement', 'Point clé : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est dé...', 'Cas pratique : Dans une entreprise à Lille, Camille se demande comment appliquer Art. L1234-1. Solution : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Art. L1234-1 du Code du travail', 'Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Conseil Expert : Assurez-vous que l''application de Art. L1234-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'préavis de licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 491 — Contestation du licenciement', 'Point clé : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et l...', 'Cas pratique : Dans une entreprise à Lille, Jean se demande comment appliquer Art. L1235-1. Solution : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Art. L1235-1 du Code du travail', 'En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1235-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'contestation du licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 492 — Rupture conventionnelle', 'Point clé : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contra...', 'Cas pratique : Dans une entreprise à Lille, Sophie se demande comment appliquer Art. L1237-11. Solution : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Art. L1237-11 du Code du travail', 'L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-11 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture conventionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 493 — Durée légale du travail', 'Point clé : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par ...', 'Cas pratique : Dans une entreprise à Bordeaux, Marc se demande comment appliquer Art. L3121-27. Solution : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Art. L3121-27 du Code du travail', 'La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-27 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée légale du travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 494 — Temps de travail effectif', 'Point clé : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employ...', 'Cas pratique : Dans une entreprise à Bordeaux, Léa se demande comment appliquer Art. L3121-1. Solution : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Art. L3121-1 du Code du travail', 'La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de travail effectif', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 495 — Temps de pause', 'Point clé : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d...', 'Cas pratique : Dans une entreprise à Bordeaux, Thomas se demande comment appliquer Art. L3121-16. Solution : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Art. L3121-16 du Code du travail', 'Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-16 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de pause', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 496 — Durée quotidienne maximale', 'Point clé : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures....', 'Cas pratique : Dans une entreprise à Nantes, Karim se demande comment appliquer Art. L3121-18. Solution : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Art. L3121-18 du Code du travail', 'Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-18 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée quotidienne maximale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 497 — Durée maximale hebdomadaire', 'Point clé : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures....', 'Cas pratique : Dans une entreprise à Nantes, Awa se demande comment appliquer Art. L3121-20. Solution : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Art. L3121-20 du Code du travail', 'Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-20 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée maximale hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 498 — Travail de nuit', 'Point clé : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la ...', 'Cas pratique : Dans une entreprise à Nantes, Julien se demande comment appliquer Art. L3122-1. Solution : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Art. L3122-1 du Code du travail', 'Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Conseil Expert : Assurez-vous que l''application de Art. L3122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'travail de nuit', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 499 — Repos quotidien', 'Point clé : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives....', 'Cas pratique : Dans une entreprise à Strasbourg, Nadia se demande comment appliquer Art. L3131-1. Solution : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Art. L3131-1 du Code du travail', 'Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3131-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos quotidien', true);
