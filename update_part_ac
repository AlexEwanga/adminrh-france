INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 1000 — Visite d''information et de prévention', 'Point clé : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des profes...', 'Cas pratique : Dans une entreprise à Lille, Camille se demande comment appliquer Art. L4612-1. Solution : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Art. L4612-1 du Code du travail', 'Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4612-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'visite d''information et de prévention', true);
