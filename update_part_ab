INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 500 — Repos hebdomadaire', 'Point clé : Il est interdit de faire travailler un même salarié plus de six jours par semaine....', 'Cas pratique : Dans une entreprise à Strasbourg, Camille se demande comment appliquer Art. L3132-1. Solution : Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Art. L3132-1 du Code du travail', 'Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 501 — Repos dominical', 'Point clé : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche....', 'Cas pratique : Dans une entreprise à Strasbourg, Jean se demande comment appliquer Art. L3132-3. Solution : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Art. L3132-3 du Code du travail', 'Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos dominical', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 502 — Congés annuels', 'Point clé : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur....', 'Cas pratique : Dans une entreprise à Toulouse, Sophie se demande comment appliquer Art. L3141-1. Solution : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Art. L3141-1 du Code du travail', 'Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés annuels', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 503 — Calcul des congés', 'Point clé : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le m...', 'Cas pratique : Dans une entreprise à Toulouse, Marc se demande comment appliquer Art. L3141-3. Solution : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Art. L3141-3 du Code du travail', 'Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'calcul des congés', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 504 — Égalité de rémunération', 'Point clé : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunér...', 'Cas pratique : Dans une entreprise à Toulouse, Léa se demande comment appliquer Art. L3221-2. Solution : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Art. L3221-2 du Code du travail', 'Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Conseil Expert : Assurez-vous que l''application de Art. L3221-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'égalité de rémunération', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 505 — Mensualisation du salaire', 'Point clé : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une qu...', 'Cas pratique : Dans une entreprise à Nice, Thomas se demande comment appliquer Art. L3242-1. Solution : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Art. L3242-1 du Code du travail', 'Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Conseil Expert : Assurez-vous que l''application de Art. L3242-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'mensualisation du salaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 506 — Obligation de sécurité', 'Point clé : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et ...', 'Cas pratique : Dans une entreprise à Nice, Karim se demande comment appliquer Art. L4121-1. Solution : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Art. L4121-1 du Code du travail', 'L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Conseil Expert : Assurez-vous que l''application de Art. L4121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation de sécurité', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 507 — Obligation du salarié (Sécurité)', 'Point clé : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilit...', 'Cas pratique : Dans une entreprise à Nice, Awa se demande comment appliquer Art. L4122-1. Solution : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Art. L4122-1 du Code du travail', 'Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation du salarié (sécurité)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 508 — Définition de la sanction disciplinaire', 'Point clé : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la...', 'Cas pratique : Dans une entreprise à Montpellier, Julien se demande comment appliquer Art. L1331-1. Solution : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Art. L1331-1 du Code du travail', 'Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Conseil Expert : Assurez-vous que l''application de Art. L1331-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'définition de la sanction disciplinaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 509 — Non-discrimination', 'Point clé : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun ...', 'Cas pratique : Dans une entreprise à Montpellier, Nadia se demande comment appliquer Art. L1132-1. Solution : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Art. L1132-1 du Code du travail', 'Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Conseil Expert : Assurez-vous que l''application de Art. L1132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'non-discrimination', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 510 — Harcèlement moral', 'Point clé : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour ...', 'Cas pratique : Dans une entreprise à Montpellier, Camille se demande comment appliquer Art. L1152-1. Solution : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Art. L1152-1 du Code du travail', 'Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1152-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement moral', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 511 — Harcèlement sexuel', 'Point clé : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou c...', 'Cas pratique : Dans une entreprise à Paris, Jean se demande comment appliquer Art. L1153-1. Solution : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Art. L1153-1 du Code du travail', 'Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Conseil Expert : Assurez-vous que l''application de Art. L1153-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement sexuel', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 512 — Informations demandées au candidat', 'Point clé : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir...', 'Cas pratique : Dans une entreprise à Paris, Sophie se demande comment appliquer Art. L1221-6. Solution : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Art. L1221-6 du Code du travail', 'Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-6 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'informations demandées au candidat', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 513 — Protection maternité (Licenciement)', 'Point clé : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de gross...', 'Cas pratique : Dans une entreprise à Paris, Marc se demande comment appliquer Art. L1225-4. Solution : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Art. L1225-4 du Code du travail', 'Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1225-4 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'protection maternité (licenciement)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 514 — Inaptitude non-professionnelle', 'Point clé : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait ...', 'Cas pratique : Dans une entreprise à Lyon, Léa se demande comment appliquer Art. L1226-2. Solution : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Art. L1226-2 du Code du travail', 'Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Conseil Expert : Assurez-vous que l''application de Art. L1226-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'inaptitude non-professionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 515 — Démission', 'Point clé : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention...', 'Cas pratique : Dans une entreprise à Lyon, Thomas se demande comment appliquer Art. L1237-1. Solution : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Art. L1237-1 du Code du travail', 'En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'démission', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 516 — Liberté syndicale', 'Point clé : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''...', 'Cas pratique : Dans une entreprise à Lyon, Karim se demande comment appliquer Art. L2141-1. Solution : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Art. L2141-1 du Code du travail', 'Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Conseil Expert : Assurez-vous que l''application de Art. L2141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'liberté syndicale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 517 — Application convention collective', 'Point clé : La convention collective applicable est celle dont relève l''activité principale exercée par l''employ...', 'Cas pratique : Dans une entreprise à Marseille, Awa se demande comment appliquer Art. L2261-2. Solution : La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Art. L2261-2 du Code du travail', 'La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L2261-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'application convention collective', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 518 — Missions du CSE', 'Point clé : Le comité social et économique a pour mission d''assurer une expression collective des salariés perme...', 'Cas pratique : Dans une entreprise à Marseille, Julien se demande comment appliquer Art. L2312-1. Solution : Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Art. L2312-1 du Code du travail', 'Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Conseil Expert : Assurez-vous que l''application de Art. L2312-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'missions du cse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 519 — Congés événements familiaux', 'Point clé : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mar...', 'Cas pratique : Dans une entreprise à Marseille, Nadia se demande comment appliquer Art. L3142-1. Solution : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Art. L3142-1 du Code du travail', 'Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Conseil Expert : Assurez-vous que l''application de Art. L3142-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés événements familiaux', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 520 — Visite d''information et de prévention', 'Point clé : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des profes...', 'Cas pratique : Dans une entreprise à Lille, Camille se demande comment appliquer Art. L4612-1. Solution : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Art. L4612-1 du Code du travail', 'Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4612-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'visite d''information et de prévention', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 521 — La formation du contrat de travail', 'Point clé : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes qu...', 'Cas pratique : Dans une entreprise à Lille, Jean se demande comment appliquer Art. L1221-1. Solution : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Art. L1221-1 du Code du travail', 'Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la formation du contrat de travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 522 — La période d''essai du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale...', 'Cas pratique : Dans une entreprise à Lille, Sophie se demande comment appliquer Art. L1221-19. Solution : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Art. L1221-19 du Code du travail', 'Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-19 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la période d''essai du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 523 — Renouvellement de la période d''essai', 'Point clé : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet acco...', 'Cas pratique : Dans une entreprise à Bordeaux, Marc se demande comment appliquer Art. L1221-21. Solution : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Art. L1221-21 du Code du travail', 'La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-21 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'renouvellement de la période d''essai', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 524 — Délai de prévenance (Rupture période d''essai)', 'Point clé : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le sala...', 'Cas pratique : Dans une entreprise à Bordeaux, Léa se demande comment appliquer Art. L1221-25. Solution : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Art. L1221-25 du Code du travail', 'Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-25 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'délai de prévenance (rupture période d''essai)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 525 — Exécution de bonne foi', 'Point clé : Le contrat de travail est exécuté de bonne foi....', 'Cas pratique : Dans une entreprise à Bordeaux, Thomas se demande comment appliquer Art. L1222-1. Solution : Le contrat de travail est exécuté de bonne foi.', 'Art. L1222-1 du Code du travail', 'Le contrat de travail est exécuté de bonne foi.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'exécution de bonne foi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 526 — Le télétravail', 'Point clé : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait éga...', 'Cas pratique : Dans une entreprise à Nantes, Karim se demande comment appliquer Art. L1222-9. Solution : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Art. L1222-9 du Code du travail', 'Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-9 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'le télétravail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 527 — Rupture du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salar...', 'Cas pratique : Dans une entreprise à Nantes, Awa se demande comment appliquer Art. L1231-1. Solution : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Art. L1231-1 du Code du travail', 'Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Conseil Expert : Assurez-vous que l''application de Art. L1231-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 528 — Cause réelle et sérieuse', 'Point clé : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse....', 'Cas pratique : Dans une entreprise à Nantes, Julien se demande comment appliquer Art. L1232-1. Solution : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Art. L1232-1 du Code du travail', 'Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Conseil Expert : Assurez-vous que l''application de Art. L1232-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'cause réelle et sérieuse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 529 — Licenciement économique', 'Point clé : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou...', 'Cas pratique : Dans une entreprise à Strasbourg, Nadia se demande comment appliquer Art. L1233-3. Solution : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Art. L1233-3 du Code du travail', 'Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1233-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'licenciement économique', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 530 — Préavis de licenciement', 'Point clé : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est dé...', 'Cas pratique : Dans une entreprise à Strasbourg, Camille se demande comment appliquer Art. L1234-1. Solution : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Art. L1234-1 du Code du travail', 'Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Conseil Expert : Assurez-vous que l''application de Art. L1234-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'préavis de licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 531 — Contestation du licenciement', 'Point clé : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et l...', 'Cas pratique : Dans une entreprise à Strasbourg, Jean se demande comment appliquer Art. L1235-1. Solution : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Art. L1235-1 du Code du travail', 'En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1235-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'contestation du licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 532 — Rupture conventionnelle', 'Point clé : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contra...', 'Cas pratique : Dans une entreprise à Toulouse, Sophie se demande comment appliquer Art. L1237-11. Solution : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Art. L1237-11 du Code du travail', 'L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-11 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture conventionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 533 — Durée légale du travail', 'Point clé : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par ...', 'Cas pratique : Dans une entreprise à Toulouse, Marc se demande comment appliquer Art. L3121-27. Solution : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Art. L3121-27 du Code du travail', 'La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-27 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée légale du travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 534 — Temps de travail effectif', 'Point clé : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employ...', 'Cas pratique : Dans une entreprise à Toulouse, Léa se demande comment appliquer Art. L3121-1. Solution : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Art. L3121-1 du Code du travail', 'La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de travail effectif', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 535 — Temps de pause', 'Point clé : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d...', 'Cas pratique : Dans une entreprise à Nice, Thomas se demande comment appliquer Art. L3121-16. Solution : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Art. L3121-16 du Code du travail', 'Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-16 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de pause', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 536 — Durée quotidienne maximale', 'Point clé : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures....', 'Cas pratique : Dans une entreprise à Nice, Karim se demande comment appliquer Art. L3121-18. Solution : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Art. L3121-18 du Code du travail', 'Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-18 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée quotidienne maximale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 537 — Durée maximale hebdomadaire', 'Point clé : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures....', 'Cas pratique : Dans une entreprise à Nice, Awa se demande comment appliquer Art. L3121-20. Solution : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Art. L3121-20 du Code du travail', 'Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-20 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée maximale hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 538 — Travail de nuit', 'Point clé : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la ...', 'Cas pratique : Dans une entreprise à Montpellier, Julien se demande comment appliquer Art. L3122-1. Solution : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Art. L3122-1 du Code du travail', 'Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Conseil Expert : Assurez-vous que l''application de Art. L3122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'travail de nuit', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 539 — Repos quotidien', 'Point clé : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives....', 'Cas pratique : Dans une entreprise à Montpellier, Nadia se demande comment appliquer Art. L3131-1. Solution : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Art. L3131-1 du Code du travail', 'Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3131-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos quotidien', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 540 — Repos hebdomadaire', 'Point clé : Il est interdit de faire travailler un même salarié plus de six jours par semaine....', 'Cas pratique : Dans une entreprise à Montpellier, Camille se demande comment appliquer Art. L3132-1. Solution : Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Art. L3132-1 du Code du travail', 'Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 541 — Repos dominical', 'Point clé : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche....', 'Cas pratique : Dans une entreprise à Paris, Jean se demande comment appliquer Art. L3132-3. Solution : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Art. L3132-3 du Code du travail', 'Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos dominical', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 542 — Congés annuels', 'Point clé : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur....', 'Cas pratique : Dans une entreprise à Paris, Sophie se demande comment appliquer Art. L3141-1. Solution : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Art. L3141-1 du Code du travail', 'Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés annuels', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 543 — Calcul des congés', 'Point clé : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le m...', 'Cas pratique : Dans une entreprise à Paris, Marc se demande comment appliquer Art. L3141-3. Solution : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Art. L3141-3 du Code du travail', 'Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'calcul des congés', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 544 — Égalité de rémunération', 'Point clé : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunér...', 'Cas pratique : Dans une entreprise à Lyon, Léa se demande comment appliquer Art. L3221-2. Solution : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Art. L3221-2 du Code du travail', 'Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Conseil Expert : Assurez-vous que l''application de Art. L3221-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'égalité de rémunération', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 545 — Mensualisation du salaire', 'Point clé : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une qu...', 'Cas pratique : Dans une entreprise à Lyon, Thomas se demande comment appliquer Art. L3242-1. Solution : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Art. L3242-1 du Code du travail', 'Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Conseil Expert : Assurez-vous que l''application de Art. L3242-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'mensualisation du salaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 546 — Obligation de sécurité', 'Point clé : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et ...', 'Cas pratique : Dans une entreprise à Lyon, Karim se demande comment appliquer Art. L4121-1. Solution : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Art. L4121-1 du Code du travail', 'L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Conseil Expert : Assurez-vous que l''application de Art. L4121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation de sécurité', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 547 — Obligation du salarié (Sécurité)', 'Point clé : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilit...', 'Cas pratique : Dans une entreprise à Marseille, Awa se demande comment appliquer Art. L4122-1. Solution : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Art. L4122-1 du Code du travail', 'Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation du salarié (sécurité)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 548 — Définition de la sanction disciplinaire', 'Point clé : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la...', 'Cas pratique : Dans une entreprise à Marseille, Julien se demande comment appliquer Art. L1331-1. Solution : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Art. L1331-1 du Code du travail', 'Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Conseil Expert : Assurez-vous que l''application de Art. L1331-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'définition de la sanction disciplinaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 549 — Non-discrimination', 'Point clé : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun ...', 'Cas pratique : Dans une entreprise à Marseille, Nadia se demande comment appliquer Art. L1132-1. Solution : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Art. L1132-1 du Code du travail', 'Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Conseil Expert : Assurez-vous que l''application de Art. L1132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'non-discrimination', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 550 — Harcèlement moral', 'Point clé : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour ...', 'Cas pratique : Dans une entreprise à Lille, Camille se demande comment appliquer Art. L1152-1. Solution : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Art. L1152-1 du Code du travail', 'Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1152-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement moral', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 551 — Harcèlement sexuel', 'Point clé : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou c...', 'Cas pratique : Dans une entreprise à Lille, Jean se demande comment appliquer Art. L1153-1. Solution : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Art. L1153-1 du Code du travail', 'Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Conseil Expert : Assurez-vous que l''application de Art. L1153-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement sexuel', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 552 — Informations demandées au candidat', 'Point clé : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir...', 'Cas pratique : Dans une entreprise à Lille, Sophie se demande comment appliquer Art. L1221-6. Solution : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Art. L1221-6 du Code du travail', 'Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-6 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'informations demandées au candidat', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 553 — Protection maternité (Licenciement)', 'Point clé : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de gross...', 'Cas pratique : Dans une entreprise à Bordeaux, Marc se demande comment appliquer Art. L1225-4. Solution : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Art. L1225-4 du Code du travail', 'Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1225-4 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'protection maternité (licenciement)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 554 — Inaptitude non-professionnelle', 'Point clé : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait ...', 'Cas pratique : Dans une entreprise à Bordeaux, Léa se demande comment appliquer Art. L1226-2. Solution : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Art. L1226-2 du Code du travail', 'Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Conseil Expert : Assurez-vous que l''application de Art. L1226-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'inaptitude non-professionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 555 — Démission', 'Point clé : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention...', 'Cas pratique : Dans une entreprise à Bordeaux, Thomas se demande comment appliquer Art. L1237-1. Solution : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Art. L1237-1 du Code du travail', 'En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'démission', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 556 — Liberté syndicale', 'Point clé : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''...', 'Cas pratique : Dans une entreprise à Nantes, Karim se demande comment appliquer Art. L2141-1. Solution : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Art. L2141-1 du Code du travail', 'Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Conseil Expert : Assurez-vous que l''application de Art. L2141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'liberté syndicale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 557 — Application convention collective', 'Point clé : La convention collective applicable est celle dont relève l''activité principale exercée par l''employ...', 'Cas pratique : Dans une entreprise à Nantes, Awa se demande comment appliquer Art. L2261-2. Solution : La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Art. L2261-2 du Code du travail', 'La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L2261-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'application convention collective', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 558 — Missions du CSE', 'Point clé : Le comité social et économique a pour mission d''assurer une expression collective des salariés perme...', 'Cas pratique : Dans une entreprise à Nantes, Julien se demande comment appliquer Art. L2312-1. Solution : Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Art. L2312-1 du Code du travail', 'Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Conseil Expert : Assurez-vous que l''application de Art. L2312-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'missions du cse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 559 — Congés événements familiaux', 'Point clé : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mar...', 'Cas pratique : Dans une entreprise à Strasbourg, Nadia se demande comment appliquer Art. L3142-1. Solution : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Art. L3142-1 du Code du travail', 'Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Conseil Expert : Assurez-vous que l''application de Art. L3142-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés événements familiaux', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 560 — Visite d''information et de prévention', 'Point clé : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des profes...', 'Cas pratique : Dans une entreprise à Strasbourg, Camille se demande comment appliquer Art. L4612-1. Solution : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Art. L4612-1 du Code du travail', 'Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4612-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'visite d''information et de prévention', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 561 — La formation du contrat de travail', 'Point clé : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes qu...', 'Cas pratique : Dans une entreprise à Strasbourg, Jean se demande comment appliquer Art. L1221-1. Solution : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Art. L1221-1 du Code du travail', 'Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la formation du contrat de travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 562 — La période d''essai du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale...', 'Cas pratique : Dans une entreprise à Toulouse, Sophie se demande comment appliquer Art. L1221-19. Solution : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Art. L1221-19 du Code du travail', 'Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-19 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la période d''essai du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 563 — Renouvellement de la période d''essai', 'Point clé : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet acco...', 'Cas pratique : Dans une entreprise à Toulouse, Marc se demande comment appliquer Art. L1221-21. Solution : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Art. L1221-21 du Code du travail', 'La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-21 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'renouvellement de la période d''essai', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 564 — Délai de prévenance (Rupture période d''essai)', 'Point clé : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le sala...', 'Cas pratique : Dans une entreprise à Toulouse, Léa se demande comment appliquer Art. L1221-25. Solution : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Art. L1221-25 du Code du travail', 'Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-25 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'délai de prévenance (rupture période d''essai)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 565 — Exécution de bonne foi', 'Point clé : Le contrat de travail est exécuté de bonne foi....', 'Cas pratique : Dans une entreprise à Nice, Thomas se demande comment appliquer Art. L1222-1. Solution : Le contrat de travail est exécuté de bonne foi.', 'Art. L1222-1 du Code du travail', 'Le contrat de travail est exécuté de bonne foi.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'exécution de bonne foi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 566 — Le télétravail', 'Point clé : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait éga...', 'Cas pratique : Dans une entreprise à Nice, Karim se demande comment appliquer Art. L1222-9. Solution : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Art. L1222-9 du Code du travail', 'Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-9 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'le télétravail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 567 — Rupture du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salar...', 'Cas pratique : Dans une entreprise à Nice, Awa se demande comment appliquer Art. L1231-1. Solution : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Art. L1231-1 du Code du travail', 'Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Conseil Expert : Assurez-vous que l''application de Art. L1231-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 568 — Cause réelle et sérieuse', 'Point clé : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse....', 'Cas pratique : Dans une entreprise à Montpellier, Julien se demande comment appliquer Art. L1232-1. Solution : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Art. L1232-1 du Code du travail', 'Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Conseil Expert : Assurez-vous que l''application de Art. L1232-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'cause réelle et sérieuse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 569 — Licenciement économique', 'Point clé : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou...', 'Cas pratique : Dans une entreprise à Montpellier, Nadia se demande comment appliquer Art. L1233-3. Solution : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Art. L1233-3 du Code du travail', 'Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1233-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'licenciement économique', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 570 — Préavis de licenciement', 'Point clé : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est dé...', 'Cas pratique : Dans une entreprise à Montpellier, Camille se demande comment appliquer Art. L1234-1. Solution : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Art. L1234-1 du Code du travail', 'Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Conseil Expert : Assurez-vous que l''application de Art. L1234-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'préavis de licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 571 — Contestation du licenciement', 'Point clé : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et l...', 'Cas pratique : Dans une entreprise à Paris, Jean se demande comment appliquer Art. L1235-1. Solution : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Art. L1235-1 du Code du travail', 'En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1235-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'contestation du licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 572 — Rupture conventionnelle', 'Point clé : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contra...', 'Cas pratique : Dans une entreprise à Paris, Sophie se demande comment appliquer Art. L1237-11. Solution : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Art. L1237-11 du Code du travail', 'L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-11 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture conventionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 573 — Durée légale du travail', 'Point clé : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par ...', 'Cas pratique : Dans une entreprise à Paris, Marc se demande comment appliquer Art. L3121-27. Solution : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Art. L3121-27 du Code du travail', 'La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-27 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée légale du travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 574 — Temps de travail effectif', 'Point clé : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employ...', 'Cas pratique : Dans une entreprise à Lyon, Léa se demande comment appliquer Art. L3121-1. Solution : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Art. L3121-1 du Code du travail', 'La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de travail effectif', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 575 — Temps de pause', 'Point clé : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d...', 'Cas pratique : Dans une entreprise à Lyon, Thomas se demande comment appliquer Art. L3121-16. Solution : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Art. L3121-16 du Code du travail', 'Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-16 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de pause', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 576 — Durée quotidienne maximale', 'Point clé : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures....', 'Cas pratique : Dans une entreprise à Lyon, Karim se demande comment appliquer Art. L3121-18. Solution : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Art. L3121-18 du Code du travail', 'Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-18 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée quotidienne maximale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 577 — Durée maximale hebdomadaire', 'Point clé : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures....', 'Cas pratique : Dans une entreprise à Marseille, Awa se demande comment appliquer Art. L3121-20. Solution : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Art. L3121-20 du Code du travail', 'Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-20 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée maximale hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 578 — Travail de nuit', 'Point clé : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la ...', 'Cas pratique : Dans une entreprise à Marseille, Julien se demande comment appliquer Art. L3122-1. Solution : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Art. L3122-1 du Code du travail', 'Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Conseil Expert : Assurez-vous que l''application de Art. L3122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'travail de nuit', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 579 — Repos quotidien', 'Point clé : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives....', 'Cas pratique : Dans une entreprise à Marseille, Nadia se demande comment appliquer Art. L3131-1. Solution : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Art. L3131-1 du Code du travail', 'Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3131-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos quotidien', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 580 — Repos hebdomadaire', 'Point clé : Il est interdit de faire travailler un même salarié plus de six jours par semaine....', 'Cas pratique : Dans une entreprise à Lille, Camille se demande comment appliquer Art. L3132-1. Solution : Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Art. L3132-1 du Code du travail', 'Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 581 — Repos dominical', 'Point clé : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche....', 'Cas pratique : Dans une entreprise à Lille, Jean se demande comment appliquer Art. L3132-3. Solution : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Art. L3132-3 du Code du travail', 'Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos dominical', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 582 — Congés annuels', 'Point clé : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur....', 'Cas pratique : Dans une entreprise à Lille, Sophie se demande comment appliquer Art. L3141-1. Solution : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Art. L3141-1 du Code du travail', 'Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés annuels', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 583 — Calcul des congés', 'Point clé : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le m...', 'Cas pratique : Dans une entreprise à Bordeaux, Marc se demande comment appliquer Art. L3141-3. Solution : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Art. L3141-3 du Code du travail', 'Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'calcul des congés', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 584 — Égalité de rémunération', 'Point clé : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunér...', 'Cas pratique : Dans une entreprise à Bordeaux, Léa se demande comment appliquer Art. L3221-2. Solution : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Art. L3221-2 du Code du travail', 'Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Conseil Expert : Assurez-vous que l''application de Art. L3221-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'égalité de rémunération', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 585 — Mensualisation du salaire', 'Point clé : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une qu...', 'Cas pratique : Dans une entreprise à Bordeaux, Thomas se demande comment appliquer Art. L3242-1. Solution : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Art. L3242-1 du Code du travail', 'Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Conseil Expert : Assurez-vous que l''application de Art. L3242-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'mensualisation du salaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 586 — Obligation de sécurité', 'Point clé : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et ...', 'Cas pratique : Dans une entreprise à Nantes, Karim se demande comment appliquer Art. L4121-1. Solution : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Art. L4121-1 du Code du travail', 'L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Conseil Expert : Assurez-vous que l''application de Art. L4121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation de sécurité', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 587 — Obligation du salarié (Sécurité)', 'Point clé : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilit...', 'Cas pratique : Dans une entreprise à Nantes, Awa se demande comment appliquer Art. L4122-1. Solution : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Art. L4122-1 du Code du travail', 'Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation du salarié (sécurité)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 588 — Définition de la sanction disciplinaire', 'Point clé : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la...', 'Cas pratique : Dans une entreprise à Nantes, Julien se demande comment appliquer Art. L1331-1. Solution : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Art. L1331-1 du Code du travail', 'Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Conseil Expert : Assurez-vous que l''application de Art. L1331-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'définition de la sanction disciplinaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 589 — Non-discrimination', 'Point clé : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun ...', 'Cas pratique : Dans une entreprise à Strasbourg, Nadia se demande comment appliquer Art. L1132-1. Solution : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Art. L1132-1 du Code du travail', 'Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Conseil Expert : Assurez-vous que l''application de Art. L1132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'non-discrimination', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 590 — Harcèlement moral', 'Point clé : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour ...', 'Cas pratique : Dans une entreprise à Strasbourg, Camille se demande comment appliquer Art. L1152-1. Solution : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Art. L1152-1 du Code du travail', 'Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1152-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement moral', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 591 — Harcèlement sexuel', 'Point clé : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou c...', 'Cas pratique : Dans une entreprise à Strasbourg, Jean se demande comment appliquer Art. L1153-1. Solution : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Art. L1153-1 du Code du travail', 'Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Conseil Expert : Assurez-vous que l''application de Art. L1153-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement sexuel', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 592 — Informations demandées au candidat', 'Point clé : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir...', 'Cas pratique : Dans une entreprise à Toulouse, Sophie se demande comment appliquer Art. L1221-6. Solution : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Art. L1221-6 du Code du travail', 'Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-6 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'informations demandées au candidat', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 593 — Protection maternité (Licenciement)', 'Point clé : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de gross...', 'Cas pratique : Dans une entreprise à Toulouse, Marc se demande comment appliquer Art. L1225-4. Solution : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Art. L1225-4 du Code du travail', 'Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1225-4 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'protection maternité (licenciement)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 594 — Inaptitude non-professionnelle', 'Point clé : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait ...', 'Cas pratique : Dans une entreprise à Toulouse, Léa se demande comment appliquer Art. L1226-2. Solution : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Art. L1226-2 du Code du travail', 'Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Conseil Expert : Assurez-vous que l''application de Art. L1226-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'inaptitude non-professionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 595 — Démission', 'Point clé : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention...', 'Cas pratique : Dans une entreprise à Nice, Thomas se demande comment appliquer Art. L1237-1. Solution : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Art. L1237-1 du Code du travail', 'En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'démission', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 596 — Liberté syndicale', 'Point clé : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''...', 'Cas pratique : Dans une entreprise à Nice, Karim se demande comment appliquer Art. L2141-1. Solution : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Art. L2141-1 du Code du travail', 'Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Conseil Expert : Assurez-vous que l''application de Art. L2141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'liberté syndicale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 597 — Application convention collective', 'Point clé : La convention collective applicable est celle dont relève l''activité principale exercée par l''employ...', 'Cas pratique : Dans une entreprise à Nice, Awa se demande comment appliquer Art. L2261-2. Solution : La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Art. L2261-2 du Code du travail', 'La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L2261-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'application convention collective', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 598 — Missions du CSE', 'Point clé : Le comité social et économique a pour mission d''assurer une expression collective des salariés perme...', 'Cas pratique : Dans une entreprise à Montpellier, Julien se demande comment appliquer Art. L2312-1. Solution : Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Art. L2312-1 du Code du travail', 'Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Conseil Expert : Assurez-vous que l''application de Art. L2312-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'missions du cse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 599 — Congés événements familiaux', 'Point clé : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mar...', 'Cas pratique : Dans une entreprise à Montpellier, Nadia se demande comment appliquer Art. L3142-1. Solution : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Art. L3142-1 du Code du travail', 'Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Conseil Expert : Assurez-vous que l''application de Art. L3142-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés événements familiaux', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 600 — Visite d''information et de prévention', 'Point clé : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des profes...', 'Cas pratique : Dans une entreprise à Montpellier, Camille se demande comment appliquer Art. L4612-1. Solution : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Art. L4612-1 du Code du travail', 'Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4612-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'visite d''information et de prévention', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 601 — La formation du contrat de travail', 'Point clé : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes qu...', 'Cas pratique : Dans une entreprise à Paris, Jean se demande comment appliquer Art. L1221-1. Solution : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Art. L1221-1 du Code du travail', 'Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la formation du contrat de travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 602 — La période d''essai du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale...', 'Cas pratique : Dans une entreprise à Paris, Sophie se demande comment appliquer Art. L1221-19. Solution : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Art. L1221-19 du Code du travail', 'Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-19 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la période d''essai du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 603 — Renouvellement de la période d''essai', 'Point clé : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet acco...', 'Cas pratique : Dans une entreprise à Paris, Marc se demande comment appliquer Art. L1221-21. Solution : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Art. L1221-21 du Code du travail', 'La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-21 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'renouvellement de la période d''essai', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 604 — Délai de prévenance (Rupture période d''essai)', 'Point clé : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le sala...', 'Cas pratique : Dans une entreprise à Lyon, Léa se demande comment appliquer Art. L1221-25. Solution : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Art. L1221-25 du Code du travail', 'Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-25 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'délai de prévenance (rupture période d''essai)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 605 — Exécution de bonne foi', 'Point clé : Le contrat de travail est exécuté de bonne foi....', 'Cas pratique : Dans une entreprise à Lyon, Thomas se demande comment appliquer Art. L1222-1. Solution : Le contrat de travail est exécuté de bonne foi.', 'Art. L1222-1 du Code du travail', 'Le contrat de travail est exécuté de bonne foi.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'exécution de bonne foi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 606 — Le télétravail', 'Point clé : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait éga...', 'Cas pratique : Dans une entreprise à Lyon, Karim se demande comment appliquer Art. L1222-9. Solution : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Art. L1222-9 du Code du travail', 'Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-9 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'le télétravail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 607 — Rupture du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salar...', 'Cas pratique : Dans une entreprise à Marseille, Awa se demande comment appliquer Art. L1231-1. Solution : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Art. L1231-1 du Code du travail', 'Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Conseil Expert : Assurez-vous que l''application de Art. L1231-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 608 — Cause réelle et sérieuse', 'Point clé : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse....', 'Cas pratique : Dans une entreprise à Marseille, Julien se demande comment appliquer Art. L1232-1. Solution : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Art. L1232-1 du Code du travail', 'Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Conseil Expert : Assurez-vous que l''application de Art. L1232-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'cause réelle et sérieuse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 609 — Licenciement économique', 'Point clé : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou...', 'Cas pratique : Dans une entreprise à Marseille, Nadia se demande comment appliquer Art. L1233-3. Solution : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Art. L1233-3 du Code du travail', 'Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1233-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'licenciement économique', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 610 — Préavis de licenciement', 'Point clé : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est dé...', 'Cas pratique : Dans une entreprise à Lille, Camille se demande comment appliquer Art. L1234-1. Solution : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Art. L1234-1 du Code du travail', 'Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Conseil Expert : Assurez-vous que l''application de Art. L1234-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'préavis de licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 611 — Contestation du licenciement', 'Point clé : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et l...', 'Cas pratique : Dans une entreprise à Lille, Jean se demande comment appliquer Art. L1235-1. Solution : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Art. L1235-1 du Code du travail', 'En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1235-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'contestation du licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 612 — Rupture conventionnelle', 'Point clé : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contra...', 'Cas pratique : Dans une entreprise à Lille, Sophie se demande comment appliquer Art. L1237-11. Solution : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Art. L1237-11 du Code du travail', 'L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-11 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture conventionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 613 — Durée légale du travail', 'Point clé : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par ...', 'Cas pratique : Dans une entreprise à Bordeaux, Marc se demande comment appliquer Art. L3121-27. Solution : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Art. L3121-27 du Code du travail', 'La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-27 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée légale du travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 614 — Temps de travail effectif', 'Point clé : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employ...', 'Cas pratique : Dans une entreprise à Bordeaux, Léa se demande comment appliquer Art. L3121-1. Solution : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Art. L3121-1 du Code du travail', 'La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de travail effectif', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 615 — Temps de pause', 'Point clé : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d...', 'Cas pratique : Dans une entreprise à Bordeaux, Thomas se demande comment appliquer Art. L3121-16. Solution : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Art. L3121-16 du Code du travail', 'Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-16 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de pause', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 616 — Durée quotidienne maximale', 'Point clé : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures....', 'Cas pratique : Dans une entreprise à Nantes, Karim se demande comment appliquer Art. L3121-18. Solution : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Art. L3121-18 du Code du travail', 'Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-18 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée quotidienne maximale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 617 — Durée maximale hebdomadaire', 'Point clé : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures....', 'Cas pratique : Dans une entreprise à Nantes, Awa se demande comment appliquer Art. L3121-20. Solution : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Art. L3121-20 du Code du travail', 'Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-20 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée maximale hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 618 — Travail de nuit', 'Point clé : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la ...', 'Cas pratique : Dans une entreprise à Nantes, Julien se demande comment appliquer Art. L3122-1. Solution : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Art. L3122-1 du Code du travail', 'Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Conseil Expert : Assurez-vous que l''application de Art. L3122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'travail de nuit', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 619 — Repos quotidien', 'Point clé : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives....', 'Cas pratique : Dans une entreprise à Strasbourg, Nadia se demande comment appliquer Art. L3131-1. Solution : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Art. L3131-1 du Code du travail', 'Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3131-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos quotidien', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 620 — Repos hebdomadaire', 'Point clé : Il est interdit de faire travailler un même salarié plus de six jours par semaine....', 'Cas pratique : Dans une entreprise à Strasbourg, Camille se demande comment appliquer Art. L3132-1. Solution : Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Art. L3132-1 du Code du travail', 'Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 621 — Repos dominical', 'Point clé : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche....', 'Cas pratique : Dans une entreprise à Strasbourg, Jean se demande comment appliquer Art. L3132-3. Solution : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Art. L3132-3 du Code du travail', 'Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos dominical', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 622 — Congés annuels', 'Point clé : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur....', 'Cas pratique : Dans une entreprise à Toulouse, Sophie se demande comment appliquer Art. L3141-1. Solution : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Art. L3141-1 du Code du travail', 'Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés annuels', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 623 — Calcul des congés', 'Point clé : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le m...', 'Cas pratique : Dans une entreprise à Toulouse, Marc se demande comment appliquer Art. L3141-3. Solution : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Art. L3141-3 du Code du travail', 'Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'calcul des congés', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 624 — Égalité de rémunération', 'Point clé : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunér...', 'Cas pratique : Dans une entreprise à Toulouse, Léa se demande comment appliquer Art. L3221-2. Solution : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Art. L3221-2 du Code du travail', 'Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Conseil Expert : Assurez-vous que l''application de Art. L3221-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'égalité de rémunération', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 625 — Mensualisation du salaire', 'Point clé : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une qu...', 'Cas pratique : Dans une entreprise à Nice, Thomas se demande comment appliquer Art. L3242-1. Solution : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Art. L3242-1 du Code du travail', 'Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Conseil Expert : Assurez-vous que l''application de Art. L3242-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'mensualisation du salaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 626 — Obligation de sécurité', 'Point clé : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et ...', 'Cas pratique : Dans une entreprise à Nice, Karim se demande comment appliquer Art. L4121-1. Solution : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Art. L4121-1 du Code du travail', 'L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Conseil Expert : Assurez-vous que l''application de Art. L4121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation de sécurité', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 627 — Obligation du salarié (Sécurité)', 'Point clé : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilit...', 'Cas pratique : Dans une entreprise à Nice, Awa se demande comment appliquer Art. L4122-1. Solution : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Art. L4122-1 du Code du travail', 'Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation du salarié (sécurité)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 628 — Définition de la sanction disciplinaire', 'Point clé : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la...', 'Cas pratique : Dans une entreprise à Montpellier, Julien se demande comment appliquer Art. L1331-1. Solution : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Art. L1331-1 du Code du travail', 'Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Conseil Expert : Assurez-vous que l''application de Art. L1331-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'définition de la sanction disciplinaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 629 — Non-discrimination', 'Point clé : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun ...', 'Cas pratique : Dans une entreprise à Montpellier, Nadia se demande comment appliquer Art. L1132-1. Solution : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Art. L1132-1 du Code du travail', 'Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Conseil Expert : Assurez-vous que l''application de Art. L1132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'non-discrimination', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 630 — Harcèlement moral', 'Point clé : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour ...', 'Cas pratique : Dans une entreprise à Montpellier, Camille se demande comment appliquer Art. L1152-1. Solution : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Art. L1152-1 du Code du travail', 'Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1152-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement moral', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 631 — Harcèlement sexuel', 'Point clé : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou c...', 'Cas pratique : Dans une entreprise à Paris, Jean se demande comment appliquer Art. L1153-1. Solution : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Art. L1153-1 du Code du travail', 'Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Conseil Expert : Assurez-vous que l''application de Art. L1153-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement sexuel', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 632 — Informations demandées au candidat', 'Point clé : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir...', 'Cas pratique : Dans une entreprise à Paris, Sophie se demande comment appliquer Art. L1221-6. Solution : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Art. L1221-6 du Code du travail', 'Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-6 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'informations demandées au candidat', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 633 — Protection maternité (Licenciement)', 'Point clé : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de gross...', 'Cas pratique : Dans une entreprise à Paris, Marc se demande comment appliquer Art. L1225-4. Solution : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Art. L1225-4 du Code du travail', 'Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1225-4 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'protection maternité (licenciement)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 634 — Inaptitude non-professionnelle', 'Point clé : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait ...', 'Cas pratique : Dans une entreprise à Lyon, Léa se demande comment appliquer Art. L1226-2. Solution : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Art. L1226-2 du Code du travail', 'Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Conseil Expert : Assurez-vous que l''application de Art. L1226-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'inaptitude non-professionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 635 — Démission', 'Point clé : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention...', 'Cas pratique : Dans une entreprise à Lyon, Thomas se demande comment appliquer Art. L1237-1. Solution : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Art. L1237-1 du Code du travail', 'En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'démission', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 636 — Liberté syndicale', 'Point clé : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''...', 'Cas pratique : Dans une entreprise à Lyon, Karim se demande comment appliquer Art. L2141-1. Solution : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Art. L2141-1 du Code du travail', 'Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Conseil Expert : Assurez-vous que l''application de Art. L2141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'liberté syndicale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 637 — Application convention collective', 'Point clé : La convention collective applicable est celle dont relève l''activité principale exercée par l''employ...', 'Cas pratique : Dans une entreprise à Marseille, Awa se demande comment appliquer Art. L2261-2. Solution : La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Art. L2261-2 du Code du travail', 'La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L2261-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'application convention collective', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 638 — Missions du CSE', 'Point clé : Le comité social et économique a pour mission d''assurer une expression collective des salariés perme...', 'Cas pratique : Dans une entreprise à Marseille, Julien se demande comment appliquer Art. L2312-1. Solution : Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Art. L2312-1 du Code du travail', 'Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Conseil Expert : Assurez-vous que l''application de Art. L2312-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'missions du cse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 639 — Congés événements familiaux', 'Point clé : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mar...', 'Cas pratique : Dans une entreprise à Marseille, Nadia se demande comment appliquer Art. L3142-1. Solution : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Art. L3142-1 du Code du travail', 'Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Conseil Expert : Assurez-vous que l''application de Art. L3142-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés événements familiaux', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 640 — Visite d''information et de prévention', 'Point clé : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des profes...', 'Cas pratique : Dans une entreprise à Lille, Camille se demande comment appliquer Art. L4612-1. Solution : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Art. L4612-1 du Code du travail', 'Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4612-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'visite d''information et de prévention', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 641 — La formation du contrat de travail', 'Point clé : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes qu...', 'Cas pratique : Dans une entreprise à Lille, Jean se demande comment appliquer Art. L1221-1. Solution : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Art. L1221-1 du Code du travail', 'Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la formation du contrat de travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 642 — La période d''essai du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale...', 'Cas pratique : Dans une entreprise à Lille, Sophie se demande comment appliquer Art. L1221-19. Solution : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Art. L1221-19 du Code du travail', 'Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-19 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la période d''essai du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 643 — Renouvellement de la période d''essai', 'Point clé : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet acco...', 'Cas pratique : Dans une entreprise à Bordeaux, Marc se demande comment appliquer Art. L1221-21. Solution : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Art. L1221-21 du Code du travail', 'La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-21 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'renouvellement de la période d''essai', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 644 — Délai de prévenance (Rupture période d''essai)', 'Point clé : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le sala...', 'Cas pratique : Dans une entreprise à Bordeaux, Léa se demande comment appliquer Art. L1221-25. Solution : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Art. L1221-25 du Code du travail', 'Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-25 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'délai de prévenance (rupture période d''essai)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 645 — Exécution de bonne foi', 'Point clé : Le contrat de travail est exécuté de bonne foi....', 'Cas pratique : Dans une entreprise à Bordeaux, Thomas se demande comment appliquer Art. L1222-1. Solution : Le contrat de travail est exécuté de bonne foi.', 'Art. L1222-1 du Code du travail', 'Le contrat de travail est exécuté de bonne foi.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'exécution de bonne foi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 646 — Le télétravail', 'Point clé : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait éga...', 'Cas pratique : Dans une entreprise à Nantes, Karim se demande comment appliquer Art. L1222-9. Solution : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Art. L1222-9 du Code du travail', 'Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-9 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'le télétravail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 647 — Rupture du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salar...', 'Cas pratique : Dans une entreprise à Nantes, Awa se demande comment appliquer Art. L1231-1. Solution : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Art. L1231-1 du Code du travail', 'Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Conseil Expert : Assurez-vous que l''application de Art. L1231-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 648 — Cause réelle et sérieuse', 'Point clé : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse....', 'Cas pratique : Dans une entreprise à Nantes, Julien se demande comment appliquer Art. L1232-1. Solution : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Art. L1232-1 du Code du travail', 'Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Conseil Expert : Assurez-vous que l''application de Art. L1232-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'cause réelle et sérieuse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 649 — Licenciement économique', 'Point clé : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou...', 'Cas pratique : Dans une entreprise à Strasbourg, Nadia se demande comment appliquer Art. L1233-3. Solution : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Art. L1233-3 du Code du travail', 'Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1233-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'licenciement économique', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 650 — Préavis de licenciement', 'Point clé : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est dé...', 'Cas pratique : Dans une entreprise à Strasbourg, Camille se demande comment appliquer Art. L1234-1. Solution : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Art. L1234-1 du Code du travail', 'Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Conseil Expert : Assurez-vous que l''application de Art. L1234-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'préavis de licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 651 — Contestation du licenciement', 'Point clé : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et l...', 'Cas pratique : Dans une entreprise à Strasbourg, Jean se demande comment appliquer Art. L1235-1. Solution : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Art. L1235-1 du Code du travail', 'En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1235-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'contestation du licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 652 — Rupture conventionnelle', 'Point clé : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contra...', 'Cas pratique : Dans une entreprise à Toulouse, Sophie se demande comment appliquer Art. L1237-11. Solution : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Art. L1237-11 du Code du travail', 'L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-11 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture conventionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 653 — Durée légale du travail', 'Point clé : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par ...', 'Cas pratique : Dans une entreprise à Toulouse, Marc se demande comment appliquer Art. L3121-27. Solution : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Art. L3121-27 du Code du travail', 'La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-27 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée légale du travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 654 — Temps de travail effectif', 'Point clé : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employ...', 'Cas pratique : Dans une entreprise à Toulouse, Léa se demande comment appliquer Art. L3121-1. Solution : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Art. L3121-1 du Code du travail', 'La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de travail effectif', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 655 — Temps de pause', 'Point clé : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d...', 'Cas pratique : Dans une entreprise à Nice, Thomas se demande comment appliquer Art. L3121-16. Solution : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Art. L3121-16 du Code du travail', 'Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-16 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de pause', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 656 — Durée quotidienne maximale', 'Point clé : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures....', 'Cas pratique : Dans une entreprise à Nice, Karim se demande comment appliquer Art. L3121-18. Solution : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Art. L3121-18 du Code du travail', 'Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-18 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée quotidienne maximale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 657 — Durée maximale hebdomadaire', 'Point clé : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures....', 'Cas pratique : Dans une entreprise à Nice, Awa se demande comment appliquer Art. L3121-20. Solution : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Art. L3121-20 du Code du travail', 'Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-20 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée maximale hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 658 — Travail de nuit', 'Point clé : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la ...', 'Cas pratique : Dans une entreprise à Montpellier, Julien se demande comment appliquer Art. L3122-1. Solution : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Art. L3122-1 du Code du travail', 'Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Conseil Expert : Assurez-vous que l''application de Art. L3122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'travail de nuit', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 659 — Repos quotidien', 'Point clé : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives....', 'Cas pratique : Dans une entreprise à Montpellier, Nadia se demande comment appliquer Art. L3131-1. Solution : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Art. L3131-1 du Code du travail', 'Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3131-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos quotidien', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 660 — Repos hebdomadaire', 'Point clé : Il est interdit de faire travailler un même salarié plus de six jours par semaine....', 'Cas pratique : Dans une entreprise à Montpellier, Camille se demande comment appliquer Art. L3132-1. Solution : Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Art. L3132-1 du Code du travail', 'Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 661 — Repos dominical', 'Point clé : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche....', 'Cas pratique : Dans une entreprise à Paris, Jean se demande comment appliquer Art. L3132-3. Solution : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Art. L3132-3 du Code du travail', 'Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos dominical', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 662 — Congés annuels', 'Point clé : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur....', 'Cas pratique : Dans une entreprise à Paris, Sophie se demande comment appliquer Art. L3141-1. Solution : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Art. L3141-1 du Code du travail', 'Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés annuels', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 663 — Calcul des congés', 'Point clé : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le m...', 'Cas pratique : Dans une entreprise à Paris, Marc se demande comment appliquer Art. L3141-3. Solution : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Art. L3141-3 du Code du travail', 'Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'calcul des congés', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 664 — Égalité de rémunération', 'Point clé : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunér...', 'Cas pratique : Dans une entreprise à Lyon, Léa se demande comment appliquer Art. L3221-2. Solution : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Art. L3221-2 du Code du travail', 'Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Conseil Expert : Assurez-vous que l''application de Art. L3221-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'égalité de rémunération', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 665 — Mensualisation du salaire', 'Point clé : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une qu...', 'Cas pratique : Dans une entreprise à Lyon, Thomas se demande comment appliquer Art. L3242-1. Solution : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Art. L3242-1 du Code du travail', 'Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Conseil Expert : Assurez-vous que l''application de Art. L3242-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'mensualisation du salaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 666 — Obligation de sécurité', 'Point clé : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et ...', 'Cas pratique : Dans une entreprise à Lyon, Karim se demande comment appliquer Art. L4121-1. Solution : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Art. L4121-1 du Code du travail', 'L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Conseil Expert : Assurez-vous que l''application de Art. L4121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation de sécurité', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 667 — Obligation du salarié (Sécurité)', 'Point clé : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilit...', 'Cas pratique : Dans une entreprise à Marseille, Awa se demande comment appliquer Art. L4122-1. Solution : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Art. L4122-1 du Code du travail', 'Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation du salarié (sécurité)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 668 — Définition de la sanction disciplinaire', 'Point clé : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la...', 'Cas pratique : Dans une entreprise à Marseille, Julien se demande comment appliquer Art. L1331-1. Solution : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Art. L1331-1 du Code du travail', 'Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Conseil Expert : Assurez-vous que l''application de Art. L1331-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'définition de la sanction disciplinaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 669 — Non-discrimination', 'Point clé : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun ...', 'Cas pratique : Dans une entreprise à Marseille, Nadia se demande comment appliquer Art. L1132-1. Solution : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Art. L1132-1 du Code du travail', 'Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Conseil Expert : Assurez-vous que l''application de Art. L1132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'non-discrimination', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 670 — Harcèlement moral', 'Point clé : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour ...', 'Cas pratique : Dans une entreprise à Lille, Camille se demande comment appliquer Art. L1152-1. Solution : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Art. L1152-1 du Code du travail', 'Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1152-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement moral', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 671 — Harcèlement sexuel', 'Point clé : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou c...', 'Cas pratique : Dans une entreprise à Lille, Jean se demande comment appliquer Art. L1153-1. Solution : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Art. L1153-1 du Code du travail', 'Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Conseil Expert : Assurez-vous que l''application de Art. L1153-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement sexuel', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 672 — Informations demandées au candidat', 'Point clé : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir...', 'Cas pratique : Dans une entreprise à Lille, Sophie se demande comment appliquer Art. L1221-6. Solution : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Art. L1221-6 du Code du travail', 'Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-6 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'informations demandées au candidat', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 673 — Protection maternité (Licenciement)', 'Point clé : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de gross...', 'Cas pratique : Dans une entreprise à Bordeaux, Marc se demande comment appliquer Art. L1225-4. Solution : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Art. L1225-4 du Code du travail', 'Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1225-4 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'protection maternité (licenciement)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 674 — Inaptitude non-professionnelle', 'Point clé : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait ...', 'Cas pratique : Dans une entreprise à Bordeaux, Léa se demande comment appliquer Art. L1226-2. Solution : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Art. L1226-2 du Code du travail', 'Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Conseil Expert : Assurez-vous que l''application de Art. L1226-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'inaptitude non-professionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 675 — Démission', 'Point clé : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention...', 'Cas pratique : Dans une entreprise à Bordeaux, Thomas se demande comment appliquer Art. L1237-1. Solution : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Art. L1237-1 du Code du travail', 'En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'démission', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 676 — Liberté syndicale', 'Point clé : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''...', 'Cas pratique : Dans une entreprise à Nantes, Karim se demande comment appliquer Art. L2141-1. Solution : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Art. L2141-1 du Code du travail', 'Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Conseil Expert : Assurez-vous que l''application de Art. L2141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'liberté syndicale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 677 — Application convention collective', 'Point clé : La convention collective applicable est celle dont relève l''activité principale exercée par l''employ...', 'Cas pratique : Dans une entreprise à Nantes, Awa se demande comment appliquer Art. L2261-2. Solution : La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Art. L2261-2 du Code du travail', 'La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L2261-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'application convention collective', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 678 — Missions du CSE', 'Point clé : Le comité social et économique a pour mission d''assurer une expression collective des salariés perme...', 'Cas pratique : Dans une entreprise à Nantes, Julien se demande comment appliquer Art. L2312-1. Solution : Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Art. L2312-1 du Code du travail', 'Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Conseil Expert : Assurez-vous que l''application de Art. L2312-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'missions du cse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 679 — Congés événements familiaux', 'Point clé : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mar...', 'Cas pratique : Dans une entreprise à Strasbourg, Nadia se demande comment appliquer Art. L3142-1. Solution : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Art. L3142-1 du Code du travail', 'Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Conseil Expert : Assurez-vous que l''application de Art. L3142-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés événements familiaux', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 680 — Visite d''information et de prévention', 'Point clé : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des profes...', 'Cas pratique : Dans une entreprise à Strasbourg, Camille se demande comment appliquer Art. L4612-1. Solution : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Art. L4612-1 du Code du travail', 'Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4612-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'visite d''information et de prévention', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 681 — La formation du contrat de travail', 'Point clé : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes qu...', 'Cas pratique : Dans une entreprise à Strasbourg, Jean se demande comment appliquer Art. L1221-1. Solution : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Art. L1221-1 du Code du travail', 'Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la formation du contrat de travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 682 — La période d''essai du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale...', 'Cas pratique : Dans une entreprise à Toulouse, Sophie se demande comment appliquer Art. L1221-19. Solution : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Art. L1221-19 du Code du travail', 'Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-19 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la période d''essai du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 683 — Renouvellement de la période d''essai', 'Point clé : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet acco...', 'Cas pratique : Dans une entreprise à Toulouse, Marc se demande comment appliquer Art. L1221-21. Solution : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Art. L1221-21 du Code du travail', 'La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-21 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'renouvellement de la période d''essai', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 684 — Délai de prévenance (Rupture période d''essai)', 'Point clé : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le sala...', 'Cas pratique : Dans une entreprise à Toulouse, Léa se demande comment appliquer Art. L1221-25. Solution : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Art. L1221-25 du Code du travail', 'Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-25 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'délai de prévenance (rupture période d''essai)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 685 — Exécution de bonne foi', 'Point clé : Le contrat de travail est exécuté de bonne foi....', 'Cas pratique : Dans une entreprise à Nice, Thomas se demande comment appliquer Art. L1222-1. Solution : Le contrat de travail est exécuté de bonne foi.', 'Art. L1222-1 du Code du travail', 'Le contrat de travail est exécuté de bonne foi.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'exécution de bonne foi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 686 — Le télétravail', 'Point clé : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait éga...', 'Cas pratique : Dans une entreprise à Nice, Karim se demande comment appliquer Art. L1222-9. Solution : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Art. L1222-9 du Code du travail', 'Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-9 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'le télétravail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 687 — Rupture du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salar...', 'Cas pratique : Dans une entreprise à Nice, Awa se demande comment appliquer Art. L1231-1. Solution : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Art. L1231-1 du Code du travail', 'Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Conseil Expert : Assurez-vous que l''application de Art. L1231-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 688 — Cause réelle et sérieuse', 'Point clé : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse....', 'Cas pratique : Dans une entreprise à Montpellier, Julien se demande comment appliquer Art. L1232-1. Solution : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Art. L1232-1 du Code du travail', 'Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Conseil Expert : Assurez-vous que l''application de Art. L1232-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'cause réelle et sérieuse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 689 — Licenciement économique', 'Point clé : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou...', 'Cas pratique : Dans une entreprise à Montpellier, Nadia se demande comment appliquer Art. L1233-3. Solution : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Art. L1233-3 du Code du travail', 'Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1233-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'licenciement économique', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 690 — Préavis de licenciement', 'Point clé : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est dé...', 'Cas pratique : Dans une entreprise à Montpellier, Camille se demande comment appliquer Art. L1234-1. Solution : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Art. L1234-1 du Code du travail', 'Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Conseil Expert : Assurez-vous que l''application de Art. L1234-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'préavis de licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 691 — Contestation du licenciement', 'Point clé : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et l...', 'Cas pratique : Dans une entreprise à Paris, Jean se demande comment appliquer Art. L1235-1. Solution : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Art. L1235-1 du Code du travail', 'En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1235-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'contestation du licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 692 — Rupture conventionnelle', 'Point clé : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contra...', 'Cas pratique : Dans une entreprise à Paris, Sophie se demande comment appliquer Art. L1237-11. Solution : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Art. L1237-11 du Code du travail', 'L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-11 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture conventionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 693 — Durée légale du travail', 'Point clé : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par ...', 'Cas pratique : Dans une entreprise à Paris, Marc se demande comment appliquer Art. L3121-27. Solution : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Art. L3121-27 du Code du travail', 'La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-27 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée légale du travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 694 — Temps de travail effectif', 'Point clé : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employ...', 'Cas pratique : Dans une entreprise à Lyon, Léa se demande comment appliquer Art. L3121-1. Solution : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Art. L3121-1 du Code du travail', 'La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de travail effectif', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 695 — Temps de pause', 'Point clé : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d...', 'Cas pratique : Dans une entreprise à Lyon, Thomas se demande comment appliquer Art. L3121-16. Solution : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Art. L3121-16 du Code du travail', 'Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-16 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de pause', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 696 — Durée quotidienne maximale', 'Point clé : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures....', 'Cas pratique : Dans une entreprise à Lyon, Karim se demande comment appliquer Art. L3121-18. Solution : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Art. L3121-18 du Code du travail', 'Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-18 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée quotidienne maximale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 697 — Durée maximale hebdomadaire', 'Point clé : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures....', 'Cas pratique : Dans une entreprise à Marseille, Awa se demande comment appliquer Art. L3121-20. Solution : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Art. L3121-20 du Code du travail', 'Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-20 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée maximale hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 698 — Travail de nuit', 'Point clé : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la ...', 'Cas pratique : Dans une entreprise à Marseille, Julien se demande comment appliquer Art. L3122-1. Solution : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Art. L3122-1 du Code du travail', 'Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Conseil Expert : Assurez-vous que l''application de Art. L3122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'travail de nuit', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 699 — Repos quotidien', 'Point clé : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives....', 'Cas pratique : Dans une entreprise à Marseille, Nadia se demande comment appliquer Art. L3131-1. Solution : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Art. L3131-1 du Code du travail', 'Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3131-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos quotidien', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 700 — Repos hebdomadaire', 'Point clé : Il est interdit de faire travailler un même salarié plus de six jours par semaine....', 'Cas pratique : Dans une entreprise à Lille, Camille se demande comment appliquer Art. L3132-1. Solution : Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Art. L3132-1 du Code du travail', 'Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 701 — Repos dominical', 'Point clé : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche....', 'Cas pratique : Dans une entreprise à Lille, Jean se demande comment appliquer Art. L3132-3. Solution : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Art. L3132-3 du Code du travail', 'Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos dominical', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 702 — Congés annuels', 'Point clé : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur....', 'Cas pratique : Dans une entreprise à Lille, Sophie se demande comment appliquer Art. L3141-1. Solution : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Art. L3141-1 du Code du travail', 'Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés annuels', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 703 — Calcul des congés', 'Point clé : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le m...', 'Cas pratique : Dans une entreprise à Bordeaux, Marc se demande comment appliquer Art. L3141-3. Solution : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Art. L3141-3 du Code du travail', 'Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'calcul des congés', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 704 — Égalité de rémunération', 'Point clé : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunér...', 'Cas pratique : Dans une entreprise à Bordeaux, Léa se demande comment appliquer Art. L3221-2. Solution : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Art. L3221-2 du Code du travail', 'Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Conseil Expert : Assurez-vous que l''application de Art. L3221-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'égalité de rémunération', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 705 — Mensualisation du salaire', 'Point clé : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une qu...', 'Cas pratique : Dans une entreprise à Bordeaux, Thomas se demande comment appliquer Art. L3242-1. Solution : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Art. L3242-1 du Code du travail', 'Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Conseil Expert : Assurez-vous que l''application de Art. L3242-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'mensualisation du salaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 706 — Obligation de sécurité', 'Point clé : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et ...', 'Cas pratique : Dans une entreprise à Nantes, Karim se demande comment appliquer Art. L4121-1. Solution : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Art. L4121-1 du Code du travail', 'L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Conseil Expert : Assurez-vous que l''application de Art. L4121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation de sécurité', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 707 — Obligation du salarié (Sécurité)', 'Point clé : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilit...', 'Cas pratique : Dans une entreprise à Nantes, Awa se demande comment appliquer Art. L4122-1. Solution : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Art. L4122-1 du Code du travail', 'Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation du salarié (sécurité)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 708 — Définition de la sanction disciplinaire', 'Point clé : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la...', 'Cas pratique : Dans une entreprise à Nantes, Julien se demande comment appliquer Art. L1331-1. Solution : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Art. L1331-1 du Code du travail', 'Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Conseil Expert : Assurez-vous que l''application de Art. L1331-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'définition de la sanction disciplinaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 709 — Non-discrimination', 'Point clé : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun ...', 'Cas pratique : Dans une entreprise à Strasbourg, Nadia se demande comment appliquer Art. L1132-1. Solution : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Art. L1132-1 du Code du travail', 'Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Conseil Expert : Assurez-vous que l''application de Art. L1132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'non-discrimination', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 710 — Harcèlement moral', 'Point clé : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour ...', 'Cas pratique : Dans une entreprise à Strasbourg, Camille se demande comment appliquer Art. L1152-1. Solution : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Art. L1152-1 du Code du travail', 'Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1152-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement moral', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 711 — Harcèlement sexuel', 'Point clé : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou c...', 'Cas pratique : Dans une entreprise à Strasbourg, Jean se demande comment appliquer Art. L1153-1. Solution : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Art. L1153-1 du Code du travail', 'Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Conseil Expert : Assurez-vous que l''application de Art. L1153-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement sexuel', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 712 — Informations demandées au candidat', 'Point clé : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir...', 'Cas pratique : Dans une entreprise à Toulouse, Sophie se demande comment appliquer Art. L1221-6. Solution : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Art. L1221-6 du Code du travail', 'Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-6 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'informations demandées au candidat', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 713 — Protection maternité (Licenciement)', 'Point clé : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de gross...', 'Cas pratique : Dans une entreprise à Toulouse, Marc se demande comment appliquer Art. L1225-4. Solution : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Art. L1225-4 du Code du travail', 'Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1225-4 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'protection maternité (licenciement)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 714 — Inaptitude non-professionnelle', 'Point clé : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait ...', 'Cas pratique : Dans une entreprise à Toulouse, Léa se demande comment appliquer Art. L1226-2. Solution : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Art. L1226-2 du Code du travail', 'Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Conseil Expert : Assurez-vous que l''application de Art. L1226-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'inaptitude non-professionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 715 — Démission', 'Point clé : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention...', 'Cas pratique : Dans une entreprise à Nice, Thomas se demande comment appliquer Art. L1237-1. Solution : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Art. L1237-1 du Code du travail', 'En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'démission', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 716 — Liberté syndicale', 'Point clé : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''...', 'Cas pratique : Dans une entreprise à Nice, Karim se demande comment appliquer Art. L2141-1. Solution : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Art. L2141-1 du Code du travail', 'Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Conseil Expert : Assurez-vous que l''application de Art. L2141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'liberté syndicale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 717 — Application convention collective', 'Point clé : La convention collective applicable est celle dont relève l''activité principale exercée par l''employ...', 'Cas pratique : Dans une entreprise à Nice, Awa se demande comment appliquer Art. L2261-2. Solution : La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Art. L2261-2 du Code du travail', 'La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L2261-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'application convention collective', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 718 — Missions du CSE', 'Point clé : Le comité social et économique a pour mission d''assurer une expression collective des salariés perme...', 'Cas pratique : Dans une entreprise à Montpellier, Julien se demande comment appliquer Art. L2312-1. Solution : Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Art. L2312-1 du Code du travail', 'Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Conseil Expert : Assurez-vous que l''application de Art. L2312-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'missions du cse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 719 — Congés événements familiaux', 'Point clé : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mar...', 'Cas pratique : Dans une entreprise à Montpellier, Nadia se demande comment appliquer Art. L3142-1. Solution : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Art. L3142-1 du Code du travail', 'Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Conseil Expert : Assurez-vous que l''application de Art. L3142-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés événements familiaux', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 720 — Visite d''information et de prévention', 'Point clé : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des profes...', 'Cas pratique : Dans une entreprise à Montpellier, Camille se demande comment appliquer Art. L4612-1. Solution : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Art. L4612-1 du Code du travail', 'Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4612-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'visite d''information et de prévention', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 721 — La formation du contrat de travail', 'Point clé : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes qu...', 'Cas pratique : Dans une entreprise à Paris, Jean se demande comment appliquer Art. L1221-1. Solution : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Art. L1221-1 du Code du travail', 'Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la formation du contrat de travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 722 — La période d''essai du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale...', 'Cas pratique : Dans une entreprise à Paris, Sophie se demande comment appliquer Art. L1221-19. Solution : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Art. L1221-19 du Code du travail', 'Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-19 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la période d''essai du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 723 — Renouvellement de la période d''essai', 'Point clé : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet acco...', 'Cas pratique : Dans une entreprise à Paris, Marc se demande comment appliquer Art. L1221-21. Solution : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Art. L1221-21 du Code du travail', 'La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-21 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'renouvellement de la période d''essai', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 724 — Délai de prévenance (Rupture période d''essai)', 'Point clé : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le sala...', 'Cas pratique : Dans une entreprise à Lyon, Léa se demande comment appliquer Art. L1221-25. Solution : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Art. L1221-25 du Code du travail', 'Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-25 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'délai de prévenance (rupture période d''essai)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 725 — Exécution de bonne foi', 'Point clé : Le contrat de travail est exécuté de bonne foi....', 'Cas pratique : Dans une entreprise à Lyon, Thomas se demande comment appliquer Art. L1222-1. Solution : Le contrat de travail est exécuté de bonne foi.', 'Art. L1222-1 du Code du travail', 'Le contrat de travail est exécuté de bonne foi.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'exécution de bonne foi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 726 — Le télétravail', 'Point clé : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait éga...', 'Cas pratique : Dans une entreprise à Lyon, Karim se demande comment appliquer Art. L1222-9. Solution : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Art. L1222-9 du Code du travail', 'Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-9 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'le télétravail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 727 — Rupture du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salar...', 'Cas pratique : Dans une entreprise à Marseille, Awa se demande comment appliquer Art. L1231-1. Solution : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Art. L1231-1 du Code du travail', 'Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Conseil Expert : Assurez-vous que l''application de Art. L1231-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 728 — Cause réelle et sérieuse', 'Point clé : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse....', 'Cas pratique : Dans une entreprise à Marseille, Julien se demande comment appliquer Art. L1232-1. Solution : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Art. L1232-1 du Code du travail', 'Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Conseil Expert : Assurez-vous que l''application de Art. L1232-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'cause réelle et sérieuse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 729 — Licenciement économique', 'Point clé : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou...', 'Cas pratique : Dans une entreprise à Marseille, Nadia se demande comment appliquer Art. L1233-3. Solution : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Art. L1233-3 du Code du travail', 'Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1233-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'licenciement économique', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 730 — Préavis de licenciement', 'Point clé : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est dé...', 'Cas pratique : Dans une entreprise à Lille, Camille se demande comment appliquer Art. L1234-1. Solution : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Art. L1234-1 du Code du travail', 'Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Conseil Expert : Assurez-vous que l''application de Art. L1234-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'préavis de licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 731 — Contestation du licenciement', 'Point clé : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et l...', 'Cas pratique : Dans une entreprise à Lille, Jean se demande comment appliquer Art. L1235-1. Solution : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Art. L1235-1 du Code du travail', 'En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1235-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'contestation du licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 732 — Rupture conventionnelle', 'Point clé : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contra...', 'Cas pratique : Dans une entreprise à Lille, Sophie se demande comment appliquer Art. L1237-11. Solution : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Art. L1237-11 du Code du travail', 'L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-11 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture conventionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 733 — Durée légale du travail', 'Point clé : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par ...', 'Cas pratique : Dans une entreprise à Bordeaux, Marc se demande comment appliquer Art. L3121-27. Solution : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Art. L3121-27 du Code du travail', 'La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-27 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée légale du travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 734 — Temps de travail effectif', 'Point clé : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employ...', 'Cas pratique : Dans une entreprise à Bordeaux, Léa se demande comment appliquer Art. L3121-1. Solution : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Art. L3121-1 du Code du travail', 'La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de travail effectif', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 735 — Temps de pause', 'Point clé : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d...', 'Cas pratique : Dans une entreprise à Bordeaux, Thomas se demande comment appliquer Art. L3121-16. Solution : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Art. L3121-16 du Code du travail', 'Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-16 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de pause', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 736 — Durée quotidienne maximale', 'Point clé : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures....', 'Cas pratique : Dans une entreprise à Nantes, Karim se demande comment appliquer Art. L3121-18. Solution : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Art. L3121-18 du Code du travail', 'Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-18 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée quotidienne maximale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 737 — Durée maximale hebdomadaire', 'Point clé : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures....', 'Cas pratique : Dans une entreprise à Nantes, Awa se demande comment appliquer Art. L3121-20. Solution : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Art. L3121-20 du Code du travail', 'Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-20 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée maximale hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 738 — Travail de nuit', 'Point clé : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la ...', 'Cas pratique : Dans une entreprise à Nantes, Julien se demande comment appliquer Art. L3122-1. Solution : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Art. L3122-1 du Code du travail', 'Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Conseil Expert : Assurez-vous que l''application de Art. L3122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'travail de nuit', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 739 — Repos quotidien', 'Point clé : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives....', 'Cas pratique : Dans une entreprise à Strasbourg, Nadia se demande comment appliquer Art. L3131-1. Solution : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Art. L3131-1 du Code du travail', 'Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3131-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos quotidien', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 740 — Repos hebdomadaire', 'Point clé : Il est interdit de faire travailler un même salarié plus de six jours par semaine....', 'Cas pratique : Dans une entreprise à Strasbourg, Camille se demande comment appliquer Art. L3132-1. Solution : Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Art. L3132-1 du Code du travail', 'Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 741 — Repos dominical', 'Point clé : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche....', 'Cas pratique : Dans une entreprise à Strasbourg, Jean se demande comment appliquer Art. L3132-3. Solution : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Art. L3132-3 du Code du travail', 'Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos dominical', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 742 — Congés annuels', 'Point clé : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur....', 'Cas pratique : Dans une entreprise à Toulouse, Sophie se demande comment appliquer Art. L3141-1. Solution : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Art. L3141-1 du Code du travail', 'Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés annuels', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 743 — Calcul des congés', 'Point clé : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le m...', 'Cas pratique : Dans une entreprise à Toulouse, Marc se demande comment appliquer Art. L3141-3. Solution : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Art. L3141-3 du Code du travail', 'Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'calcul des congés', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 744 — Égalité de rémunération', 'Point clé : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunér...', 'Cas pratique : Dans une entreprise à Toulouse, Léa se demande comment appliquer Art. L3221-2. Solution : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Art. L3221-2 du Code du travail', 'Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Conseil Expert : Assurez-vous que l''application de Art. L3221-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'égalité de rémunération', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 745 — Mensualisation du salaire', 'Point clé : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une qu...', 'Cas pratique : Dans une entreprise à Nice, Thomas se demande comment appliquer Art. L3242-1. Solution : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Art. L3242-1 du Code du travail', 'Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Conseil Expert : Assurez-vous que l''application de Art. L3242-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'mensualisation du salaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 746 — Obligation de sécurité', 'Point clé : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et ...', 'Cas pratique : Dans une entreprise à Nice, Karim se demande comment appliquer Art. L4121-1. Solution : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Art. L4121-1 du Code du travail', 'L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Conseil Expert : Assurez-vous que l''application de Art. L4121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation de sécurité', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 747 — Obligation du salarié (Sécurité)', 'Point clé : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilit...', 'Cas pratique : Dans une entreprise à Nice, Awa se demande comment appliquer Art. L4122-1. Solution : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Art. L4122-1 du Code du travail', 'Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation du salarié (sécurité)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 748 — Définition de la sanction disciplinaire', 'Point clé : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la...', 'Cas pratique : Dans une entreprise à Montpellier, Julien se demande comment appliquer Art. L1331-1. Solution : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Art. L1331-1 du Code du travail', 'Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Conseil Expert : Assurez-vous que l''application de Art. L1331-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'définition de la sanction disciplinaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 749 — Non-discrimination', 'Point clé : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun ...', 'Cas pratique : Dans une entreprise à Montpellier, Nadia se demande comment appliquer Art. L1132-1. Solution : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Art. L1132-1 du Code du travail', 'Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Conseil Expert : Assurez-vous que l''application de Art. L1132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'non-discrimination', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 750 — Harcèlement moral', 'Point clé : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour ...', 'Cas pratique : Dans une entreprise à Montpellier, Camille se demande comment appliquer Art. L1152-1. Solution : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Art. L1152-1 du Code du travail', 'Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1152-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement moral', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 751 — Harcèlement sexuel', 'Point clé : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou c...', 'Cas pratique : Dans une entreprise à Paris, Jean se demande comment appliquer Art. L1153-1. Solution : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Art. L1153-1 du Code du travail', 'Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Conseil Expert : Assurez-vous que l''application de Art. L1153-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement sexuel', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 752 — Informations demandées au candidat', 'Point clé : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir...', 'Cas pratique : Dans une entreprise à Paris, Sophie se demande comment appliquer Art. L1221-6. Solution : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Art. L1221-6 du Code du travail', 'Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-6 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'informations demandées au candidat', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 753 — Protection maternité (Licenciement)', 'Point clé : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de gross...', 'Cas pratique : Dans une entreprise à Paris, Marc se demande comment appliquer Art. L1225-4. Solution : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Art. L1225-4 du Code du travail', 'Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1225-4 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'protection maternité (licenciement)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 754 — Inaptitude non-professionnelle', 'Point clé : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait ...', 'Cas pratique : Dans une entreprise à Lyon, Léa se demande comment appliquer Art. L1226-2. Solution : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Art. L1226-2 du Code du travail', 'Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Conseil Expert : Assurez-vous que l''application de Art. L1226-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'inaptitude non-professionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 755 — Démission', 'Point clé : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention...', 'Cas pratique : Dans une entreprise à Lyon, Thomas se demande comment appliquer Art. L1237-1. Solution : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Art. L1237-1 du Code du travail', 'En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'démission', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 756 — Liberté syndicale', 'Point clé : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''...', 'Cas pratique : Dans une entreprise à Lyon, Karim se demande comment appliquer Art. L2141-1. Solution : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Art. L2141-1 du Code du travail', 'Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Conseil Expert : Assurez-vous que l''application de Art. L2141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'liberté syndicale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 757 — Application convention collective', 'Point clé : La convention collective applicable est celle dont relève l''activité principale exercée par l''employ...', 'Cas pratique : Dans une entreprise à Marseille, Awa se demande comment appliquer Art. L2261-2. Solution : La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Art. L2261-2 du Code du travail', 'La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L2261-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'application convention collective', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 758 — Missions du CSE', 'Point clé : Le comité social et économique a pour mission d''assurer une expression collective des salariés perme...', 'Cas pratique : Dans une entreprise à Marseille, Julien se demande comment appliquer Art. L2312-1. Solution : Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Art. L2312-1 du Code du travail', 'Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Conseil Expert : Assurez-vous que l''application de Art. L2312-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'missions du cse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 759 — Congés événements familiaux', 'Point clé : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mar...', 'Cas pratique : Dans une entreprise à Marseille, Nadia se demande comment appliquer Art. L3142-1. Solution : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Art. L3142-1 du Code du travail', 'Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Conseil Expert : Assurez-vous que l''application de Art. L3142-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés événements familiaux', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 760 — Visite d''information et de prévention', 'Point clé : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des profes...', 'Cas pratique : Dans une entreprise à Lille, Camille se demande comment appliquer Art. L4612-1. Solution : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Art. L4612-1 du Code du travail', 'Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4612-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'visite d''information et de prévention', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 761 — La formation du contrat de travail', 'Point clé : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes qu...', 'Cas pratique : Dans une entreprise à Lille, Jean se demande comment appliquer Art. L1221-1. Solution : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Art. L1221-1 du Code du travail', 'Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la formation du contrat de travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 762 — La période d''essai du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale...', 'Cas pratique : Dans une entreprise à Lille, Sophie se demande comment appliquer Art. L1221-19. Solution : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Art. L1221-19 du Code du travail', 'Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-19 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la période d''essai du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 763 — Renouvellement de la période d''essai', 'Point clé : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet acco...', 'Cas pratique : Dans une entreprise à Bordeaux, Marc se demande comment appliquer Art. L1221-21. Solution : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Art. L1221-21 du Code du travail', 'La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-21 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'renouvellement de la période d''essai', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 764 — Délai de prévenance (Rupture période d''essai)', 'Point clé : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le sala...', 'Cas pratique : Dans une entreprise à Bordeaux, Léa se demande comment appliquer Art. L1221-25. Solution : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Art. L1221-25 du Code du travail', 'Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-25 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'délai de prévenance (rupture période d''essai)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 765 — Exécution de bonne foi', 'Point clé : Le contrat de travail est exécuté de bonne foi....', 'Cas pratique : Dans une entreprise à Bordeaux, Thomas se demande comment appliquer Art. L1222-1. Solution : Le contrat de travail est exécuté de bonne foi.', 'Art. L1222-1 du Code du travail', 'Le contrat de travail est exécuté de bonne foi.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'exécution de bonne foi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 766 — Le télétravail', 'Point clé : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait éga...', 'Cas pratique : Dans une entreprise à Nantes, Karim se demande comment appliquer Art. L1222-9. Solution : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Art. L1222-9 du Code du travail', 'Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-9 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'le télétravail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 767 — Rupture du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salar...', 'Cas pratique : Dans une entreprise à Nantes, Awa se demande comment appliquer Art. L1231-1. Solution : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Art. L1231-1 du Code du travail', 'Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Conseil Expert : Assurez-vous que l''application de Art. L1231-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 768 — Cause réelle et sérieuse', 'Point clé : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse....', 'Cas pratique : Dans une entreprise à Nantes, Julien se demande comment appliquer Art. L1232-1. Solution : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Art. L1232-1 du Code du travail', 'Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Conseil Expert : Assurez-vous que l''application de Art. L1232-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'cause réelle et sérieuse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 769 — Licenciement économique', 'Point clé : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou...', 'Cas pratique : Dans une entreprise à Strasbourg, Nadia se demande comment appliquer Art. L1233-3. Solution : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Art. L1233-3 du Code du travail', 'Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1233-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'licenciement économique', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 770 — Préavis de licenciement', 'Point clé : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est dé...', 'Cas pratique : Dans une entreprise à Strasbourg, Camille se demande comment appliquer Art. L1234-1. Solution : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Art. L1234-1 du Code du travail', 'Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Conseil Expert : Assurez-vous que l''application de Art. L1234-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'préavis de licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 771 — Contestation du licenciement', 'Point clé : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et l...', 'Cas pratique : Dans une entreprise à Strasbourg, Jean se demande comment appliquer Art. L1235-1. Solution : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Art. L1235-1 du Code du travail', 'En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1235-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'contestation du licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 772 — Rupture conventionnelle', 'Point clé : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contra...', 'Cas pratique : Dans une entreprise à Toulouse, Sophie se demande comment appliquer Art. L1237-11. Solution : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Art. L1237-11 du Code du travail', 'L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-11 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture conventionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 773 — Durée légale du travail', 'Point clé : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par ...', 'Cas pratique : Dans une entreprise à Toulouse, Marc se demande comment appliquer Art. L3121-27. Solution : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Art. L3121-27 du Code du travail', 'La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-27 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée légale du travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 774 — Temps de travail effectif', 'Point clé : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employ...', 'Cas pratique : Dans une entreprise à Toulouse, Léa se demande comment appliquer Art. L3121-1. Solution : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Art. L3121-1 du Code du travail', 'La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de travail effectif', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 775 — Temps de pause', 'Point clé : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d...', 'Cas pratique : Dans une entreprise à Nice, Thomas se demande comment appliquer Art. L3121-16. Solution : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Art. L3121-16 du Code du travail', 'Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-16 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de pause', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 776 — Durée quotidienne maximale', 'Point clé : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures....', 'Cas pratique : Dans une entreprise à Nice, Karim se demande comment appliquer Art. L3121-18. Solution : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Art. L3121-18 du Code du travail', 'Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-18 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée quotidienne maximale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 777 — Durée maximale hebdomadaire', 'Point clé : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures....', 'Cas pratique : Dans une entreprise à Nice, Awa se demande comment appliquer Art. L3121-20. Solution : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Art. L3121-20 du Code du travail', 'Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-20 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée maximale hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 778 — Travail de nuit', 'Point clé : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la ...', 'Cas pratique : Dans une entreprise à Montpellier, Julien se demande comment appliquer Art. L3122-1. Solution : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Art. L3122-1 du Code du travail', 'Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Conseil Expert : Assurez-vous que l''application de Art. L3122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'travail de nuit', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 779 — Repos quotidien', 'Point clé : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives....', 'Cas pratique : Dans une entreprise à Montpellier, Nadia se demande comment appliquer Art. L3131-1. Solution : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Art. L3131-1 du Code du travail', 'Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3131-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos quotidien', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 780 — Repos hebdomadaire', 'Point clé : Il est interdit de faire travailler un même salarié plus de six jours par semaine....', 'Cas pratique : Dans une entreprise à Montpellier, Camille se demande comment appliquer Art. L3132-1. Solution : Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Art. L3132-1 du Code du travail', 'Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 781 — Repos dominical', 'Point clé : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche....', 'Cas pratique : Dans une entreprise à Paris, Jean se demande comment appliquer Art. L3132-3. Solution : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Art. L3132-3 du Code du travail', 'Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos dominical', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 782 — Congés annuels', 'Point clé : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur....', 'Cas pratique : Dans une entreprise à Paris, Sophie se demande comment appliquer Art. L3141-1. Solution : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Art. L3141-1 du Code du travail', 'Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés annuels', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 783 — Calcul des congés', 'Point clé : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le m...', 'Cas pratique : Dans une entreprise à Paris, Marc se demande comment appliquer Art. L3141-3. Solution : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Art. L3141-3 du Code du travail', 'Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'calcul des congés', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 784 — Égalité de rémunération', 'Point clé : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunér...', 'Cas pratique : Dans une entreprise à Lyon, Léa se demande comment appliquer Art. L3221-2. Solution : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Art. L3221-2 du Code du travail', 'Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Conseil Expert : Assurez-vous que l''application de Art. L3221-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'égalité de rémunération', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 785 — Mensualisation du salaire', 'Point clé : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une qu...', 'Cas pratique : Dans une entreprise à Lyon, Thomas se demande comment appliquer Art. L3242-1. Solution : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Art. L3242-1 du Code du travail', 'Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Conseil Expert : Assurez-vous que l''application de Art. L3242-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'mensualisation du salaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 786 — Obligation de sécurité', 'Point clé : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et ...', 'Cas pratique : Dans une entreprise à Lyon, Karim se demande comment appliquer Art. L4121-1. Solution : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Art. L4121-1 du Code du travail', 'L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Conseil Expert : Assurez-vous que l''application de Art. L4121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation de sécurité', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 787 — Obligation du salarié (Sécurité)', 'Point clé : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilit...', 'Cas pratique : Dans une entreprise à Marseille, Awa se demande comment appliquer Art. L4122-1. Solution : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Art. L4122-1 du Code du travail', 'Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation du salarié (sécurité)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 788 — Définition de la sanction disciplinaire', 'Point clé : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la...', 'Cas pratique : Dans une entreprise à Marseille, Julien se demande comment appliquer Art. L1331-1. Solution : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Art. L1331-1 du Code du travail', 'Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Conseil Expert : Assurez-vous que l''application de Art. L1331-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'définition de la sanction disciplinaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 789 — Non-discrimination', 'Point clé : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun ...', 'Cas pratique : Dans une entreprise à Marseille, Nadia se demande comment appliquer Art. L1132-1. Solution : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Art. L1132-1 du Code du travail', 'Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Conseil Expert : Assurez-vous que l''application de Art. L1132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'non-discrimination', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 790 — Harcèlement moral', 'Point clé : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour ...', 'Cas pratique : Dans une entreprise à Lille, Camille se demande comment appliquer Art. L1152-1. Solution : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Art. L1152-1 du Code du travail', 'Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1152-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement moral', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 791 — Harcèlement sexuel', 'Point clé : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou c...', 'Cas pratique : Dans une entreprise à Lille, Jean se demande comment appliquer Art. L1153-1. Solution : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Art. L1153-1 du Code du travail', 'Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Conseil Expert : Assurez-vous que l''application de Art. L1153-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement sexuel', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 792 — Informations demandées au candidat', 'Point clé : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir...', 'Cas pratique : Dans une entreprise à Lille, Sophie se demande comment appliquer Art. L1221-6. Solution : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Art. L1221-6 du Code du travail', 'Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-6 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'informations demandées au candidat', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 793 — Protection maternité (Licenciement)', 'Point clé : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de gross...', 'Cas pratique : Dans une entreprise à Bordeaux, Marc se demande comment appliquer Art. L1225-4. Solution : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Art. L1225-4 du Code du travail', 'Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1225-4 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'protection maternité (licenciement)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 794 — Inaptitude non-professionnelle', 'Point clé : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait ...', 'Cas pratique : Dans une entreprise à Bordeaux, Léa se demande comment appliquer Art. L1226-2. Solution : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Art. L1226-2 du Code du travail', 'Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Conseil Expert : Assurez-vous que l''application de Art. L1226-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'inaptitude non-professionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 795 — Démission', 'Point clé : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention...', 'Cas pratique : Dans une entreprise à Bordeaux, Thomas se demande comment appliquer Art. L1237-1. Solution : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Art. L1237-1 du Code du travail', 'En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'démission', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 796 — Liberté syndicale', 'Point clé : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''...', 'Cas pratique : Dans une entreprise à Nantes, Karim se demande comment appliquer Art. L2141-1. Solution : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Art. L2141-1 du Code du travail', 'Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Conseil Expert : Assurez-vous que l''application de Art. L2141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'liberté syndicale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 797 — Application convention collective', 'Point clé : La convention collective applicable est celle dont relève l''activité principale exercée par l''employ...', 'Cas pratique : Dans une entreprise à Nantes, Awa se demande comment appliquer Art. L2261-2. Solution : La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Art. L2261-2 du Code du travail', 'La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L2261-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'application convention collective', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 798 — Missions du CSE', 'Point clé : Le comité social et économique a pour mission d''assurer une expression collective des salariés perme...', 'Cas pratique : Dans une entreprise à Nantes, Julien se demande comment appliquer Art. L2312-1. Solution : Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Art. L2312-1 du Code du travail', 'Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Conseil Expert : Assurez-vous que l''application de Art. L2312-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'missions du cse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 799 — Congés événements familiaux', 'Point clé : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mar...', 'Cas pratique : Dans une entreprise à Strasbourg, Nadia se demande comment appliquer Art. L3142-1. Solution : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Art. L3142-1 du Code du travail', 'Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Conseil Expert : Assurez-vous que l''application de Art. L3142-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés événements familiaux', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 800 — Visite d''information et de prévention', 'Point clé : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des profes...', 'Cas pratique : Dans une entreprise à Strasbourg, Camille se demande comment appliquer Art. L4612-1. Solution : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Art. L4612-1 du Code du travail', 'Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4612-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'visite d''information et de prévention', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 801 — La formation du contrat de travail', 'Point clé : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes qu...', 'Cas pratique : Dans une entreprise à Strasbourg, Jean se demande comment appliquer Art. L1221-1. Solution : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Art. L1221-1 du Code du travail', 'Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la formation du contrat de travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 802 — La période d''essai du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale...', 'Cas pratique : Dans une entreprise à Toulouse, Sophie se demande comment appliquer Art. L1221-19. Solution : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Art. L1221-19 du Code du travail', 'Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-19 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la période d''essai du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 803 — Renouvellement de la période d''essai', 'Point clé : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet acco...', 'Cas pratique : Dans une entreprise à Toulouse, Marc se demande comment appliquer Art. L1221-21. Solution : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Art. L1221-21 du Code du travail', 'La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-21 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'renouvellement de la période d''essai', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 804 — Délai de prévenance (Rupture période d''essai)', 'Point clé : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le sala...', 'Cas pratique : Dans une entreprise à Toulouse, Léa se demande comment appliquer Art. L1221-25. Solution : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Art. L1221-25 du Code du travail', 'Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-25 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'délai de prévenance (rupture période d''essai)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 805 — Exécution de bonne foi', 'Point clé : Le contrat de travail est exécuté de bonne foi....', 'Cas pratique : Dans une entreprise à Nice, Thomas se demande comment appliquer Art. L1222-1. Solution : Le contrat de travail est exécuté de bonne foi.', 'Art. L1222-1 du Code du travail', 'Le contrat de travail est exécuté de bonne foi.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'exécution de bonne foi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 806 — Le télétravail', 'Point clé : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait éga...', 'Cas pratique : Dans une entreprise à Nice, Karim se demande comment appliquer Art. L1222-9. Solution : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Art. L1222-9 du Code du travail', 'Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-9 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'le télétravail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 807 — Rupture du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salar...', 'Cas pratique : Dans une entreprise à Nice, Awa se demande comment appliquer Art. L1231-1. Solution : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Art. L1231-1 du Code du travail', 'Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Conseil Expert : Assurez-vous que l''application de Art. L1231-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 808 — Cause réelle et sérieuse', 'Point clé : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse....', 'Cas pratique : Dans une entreprise à Montpellier, Julien se demande comment appliquer Art. L1232-1. Solution : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Art. L1232-1 du Code du travail', 'Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Conseil Expert : Assurez-vous que l''application de Art. L1232-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'cause réelle et sérieuse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 809 — Licenciement économique', 'Point clé : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou...', 'Cas pratique : Dans une entreprise à Montpellier, Nadia se demande comment appliquer Art. L1233-3. Solution : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Art. L1233-3 du Code du travail', 'Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1233-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'licenciement économique', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 810 — Préavis de licenciement', 'Point clé : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est dé...', 'Cas pratique : Dans une entreprise à Montpellier, Camille se demande comment appliquer Art. L1234-1. Solution : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Art. L1234-1 du Code du travail', 'Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Conseil Expert : Assurez-vous que l''application de Art. L1234-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'préavis de licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 811 — Contestation du licenciement', 'Point clé : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et l...', 'Cas pratique : Dans une entreprise à Paris, Jean se demande comment appliquer Art. L1235-1. Solution : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Art. L1235-1 du Code du travail', 'En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1235-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'contestation du licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 812 — Rupture conventionnelle', 'Point clé : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contra...', 'Cas pratique : Dans une entreprise à Paris, Sophie se demande comment appliquer Art. L1237-11. Solution : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Art. L1237-11 du Code du travail', 'L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-11 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture conventionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 813 — Durée légale du travail', 'Point clé : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par ...', 'Cas pratique : Dans une entreprise à Paris, Marc se demande comment appliquer Art. L3121-27. Solution : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Art. L3121-27 du Code du travail', 'La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-27 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée légale du travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 814 — Temps de travail effectif', 'Point clé : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employ...', 'Cas pratique : Dans une entreprise à Lyon, Léa se demande comment appliquer Art. L3121-1. Solution : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Art. L3121-1 du Code du travail', 'La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de travail effectif', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 815 — Temps de pause', 'Point clé : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d...', 'Cas pratique : Dans une entreprise à Lyon, Thomas se demande comment appliquer Art. L3121-16. Solution : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Art. L3121-16 du Code du travail', 'Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-16 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de pause', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 816 — Durée quotidienne maximale', 'Point clé : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures....', 'Cas pratique : Dans une entreprise à Lyon, Karim se demande comment appliquer Art. L3121-18. Solution : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Art. L3121-18 du Code du travail', 'Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-18 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée quotidienne maximale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 817 — Durée maximale hebdomadaire', 'Point clé : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures....', 'Cas pratique : Dans une entreprise à Marseille, Awa se demande comment appliquer Art. L3121-20. Solution : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Art. L3121-20 du Code du travail', 'Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-20 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée maximale hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 818 — Travail de nuit', 'Point clé : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la ...', 'Cas pratique : Dans une entreprise à Marseille, Julien se demande comment appliquer Art. L3122-1. Solution : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Art. L3122-1 du Code du travail', 'Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Conseil Expert : Assurez-vous que l''application de Art. L3122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'travail de nuit', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 819 — Repos quotidien', 'Point clé : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives....', 'Cas pratique : Dans une entreprise à Marseille, Nadia se demande comment appliquer Art. L3131-1. Solution : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Art. L3131-1 du Code du travail', 'Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3131-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos quotidien', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 820 — Repos hebdomadaire', 'Point clé : Il est interdit de faire travailler un même salarié plus de six jours par semaine....', 'Cas pratique : Dans une entreprise à Lille, Camille se demande comment appliquer Art. L3132-1. Solution : Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Art. L3132-1 du Code du travail', 'Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 821 — Repos dominical', 'Point clé : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche....', 'Cas pratique : Dans une entreprise à Lille, Jean se demande comment appliquer Art. L3132-3. Solution : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Art. L3132-3 du Code du travail', 'Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos dominical', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 822 — Congés annuels', 'Point clé : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur....', 'Cas pratique : Dans une entreprise à Lille, Sophie se demande comment appliquer Art. L3141-1. Solution : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Art. L3141-1 du Code du travail', 'Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés annuels', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 823 — Calcul des congés', 'Point clé : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le m...', 'Cas pratique : Dans une entreprise à Bordeaux, Marc se demande comment appliquer Art. L3141-3. Solution : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Art. L3141-3 du Code du travail', 'Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'calcul des congés', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 824 — Égalité de rémunération', 'Point clé : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunér...', 'Cas pratique : Dans une entreprise à Bordeaux, Léa se demande comment appliquer Art. L3221-2. Solution : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Art. L3221-2 du Code du travail', 'Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Conseil Expert : Assurez-vous que l''application de Art. L3221-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'égalité de rémunération', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 825 — Mensualisation du salaire', 'Point clé : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une qu...', 'Cas pratique : Dans une entreprise à Bordeaux, Thomas se demande comment appliquer Art. L3242-1. Solution : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Art. L3242-1 du Code du travail', 'Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Conseil Expert : Assurez-vous que l''application de Art. L3242-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'mensualisation du salaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 826 — Obligation de sécurité', 'Point clé : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et ...', 'Cas pratique : Dans une entreprise à Nantes, Karim se demande comment appliquer Art. L4121-1. Solution : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Art. L4121-1 du Code du travail', 'L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Conseil Expert : Assurez-vous que l''application de Art. L4121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation de sécurité', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 827 — Obligation du salarié (Sécurité)', 'Point clé : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilit...', 'Cas pratique : Dans une entreprise à Nantes, Awa se demande comment appliquer Art. L4122-1. Solution : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Art. L4122-1 du Code du travail', 'Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation du salarié (sécurité)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 828 — Définition de la sanction disciplinaire', 'Point clé : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la...', 'Cas pratique : Dans une entreprise à Nantes, Julien se demande comment appliquer Art. L1331-1. Solution : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Art. L1331-1 du Code du travail', 'Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Conseil Expert : Assurez-vous que l''application de Art. L1331-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'définition de la sanction disciplinaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 829 — Non-discrimination', 'Point clé : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun ...', 'Cas pratique : Dans une entreprise à Strasbourg, Nadia se demande comment appliquer Art. L1132-1. Solution : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Art. L1132-1 du Code du travail', 'Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Conseil Expert : Assurez-vous que l''application de Art. L1132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'non-discrimination', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 830 — Harcèlement moral', 'Point clé : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour ...', 'Cas pratique : Dans une entreprise à Strasbourg, Camille se demande comment appliquer Art. L1152-1. Solution : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Art. L1152-1 du Code du travail', 'Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1152-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement moral', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 831 — Harcèlement sexuel', 'Point clé : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou c...', 'Cas pratique : Dans une entreprise à Strasbourg, Jean se demande comment appliquer Art. L1153-1. Solution : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Art. L1153-1 du Code du travail', 'Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Conseil Expert : Assurez-vous que l''application de Art. L1153-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement sexuel', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 832 — Informations demandées au candidat', 'Point clé : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir...', 'Cas pratique : Dans une entreprise à Toulouse, Sophie se demande comment appliquer Art. L1221-6. Solution : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Art. L1221-6 du Code du travail', 'Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-6 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'informations demandées au candidat', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 833 — Protection maternité (Licenciement)', 'Point clé : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de gross...', 'Cas pratique : Dans une entreprise à Toulouse, Marc se demande comment appliquer Art. L1225-4. Solution : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Art. L1225-4 du Code du travail', 'Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1225-4 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'protection maternité (licenciement)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 834 — Inaptitude non-professionnelle', 'Point clé : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait ...', 'Cas pratique : Dans une entreprise à Toulouse, Léa se demande comment appliquer Art. L1226-2. Solution : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Art. L1226-2 du Code du travail', 'Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Conseil Expert : Assurez-vous que l''application de Art. L1226-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'inaptitude non-professionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 835 — Démission', 'Point clé : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention...', 'Cas pratique : Dans une entreprise à Nice, Thomas se demande comment appliquer Art. L1237-1. Solution : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Art. L1237-1 du Code du travail', 'En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'démission', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 836 — Liberté syndicale', 'Point clé : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''...', 'Cas pratique : Dans une entreprise à Nice, Karim se demande comment appliquer Art. L2141-1. Solution : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Art. L2141-1 du Code du travail', 'Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Conseil Expert : Assurez-vous que l''application de Art. L2141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'liberté syndicale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 837 — Application convention collective', 'Point clé : La convention collective applicable est celle dont relève l''activité principale exercée par l''employ...', 'Cas pratique : Dans une entreprise à Nice, Awa se demande comment appliquer Art. L2261-2. Solution : La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Art. L2261-2 du Code du travail', 'La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L2261-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'application convention collective', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 838 — Missions du CSE', 'Point clé : Le comité social et économique a pour mission d''assurer une expression collective des salariés perme...', 'Cas pratique : Dans une entreprise à Montpellier, Julien se demande comment appliquer Art. L2312-1. Solution : Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Art. L2312-1 du Code du travail', 'Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Conseil Expert : Assurez-vous que l''application de Art. L2312-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'missions du cse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 839 — Congés événements familiaux', 'Point clé : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mar...', 'Cas pratique : Dans une entreprise à Montpellier, Nadia se demande comment appliquer Art. L3142-1. Solution : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Art. L3142-1 du Code du travail', 'Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Conseil Expert : Assurez-vous que l''application de Art. L3142-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés événements familiaux', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 840 — Visite d''information et de prévention', 'Point clé : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des profes...', 'Cas pratique : Dans une entreprise à Montpellier, Camille se demande comment appliquer Art. L4612-1. Solution : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Art. L4612-1 du Code du travail', 'Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4612-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'visite d''information et de prévention', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 841 — La formation du contrat de travail', 'Point clé : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes qu...', 'Cas pratique : Dans une entreprise à Paris, Jean se demande comment appliquer Art. L1221-1. Solution : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Art. L1221-1 du Code du travail', 'Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la formation du contrat de travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 842 — La période d''essai du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale...', 'Cas pratique : Dans une entreprise à Paris, Sophie se demande comment appliquer Art. L1221-19. Solution : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Art. L1221-19 du Code du travail', 'Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-19 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la période d''essai du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 843 — Renouvellement de la période d''essai', 'Point clé : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet acco...', 'Cas pratique : Dans une entreprise à Paris, Marc se demande comment appliquer Art. L1221-21. Solution : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Art. L1221-21 du Code du travail', 'La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-21 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'renouvellement de la période d''essai', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 844 — Délai de prévenance (Rupture période d''essai)', 'Point clé : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le sala...', 'Cas pratique : Dans une entreprise à Lyon, Léa se demande comment appliquer Art. L1221-25. Solution : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Art. L1221-25 du Code du travail', 'Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-25 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'délai de prévenance (rupture période d''essai)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 845 — Exécution de bonne foi', 'Point clé : Le contrat de travail est exécuté de bonne foi....', 'Cas pratique : Dans une entreprise à Lyon, Thomas se demande comment appliquer Art. L1222-1. Solution : Le contrat de travail est exécuté de bonne foi.', 'Art. L1222-1 du Code du travail', 'Le contrat de travail est exécuté de bonne foi.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'exécution de bonne foi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 846 — Le télétravail', 'Point clé : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait éga...', 'Cas pratique : Dans une entreprise à Lyon, Karim se demande comment appliquer Art. L1222-9. Solution : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Art. L1222-9 du Code du travail', 'Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-9 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'le télétravail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 847 — Rupture du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salar...', 'Cas pratique : Dans une entreprise à Marseille, Awa se demande comment appliquer Art. L1231-1. Solution : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Art. L1231-1 du Code du travail', 'Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Conseil Expert : Assurez-vous que l''application de Art. L1231-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 848 — Cause réelle et sérieuse', 'Point clé : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse....', 'Cas pratique : Dans une entreprise à Marseille, Julien se demande comment appliquer Art. L1232-1. Solution : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Art. L1232-1 du Code du travail', 'Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Conseil Expert : Assurez-vous que l''application de Art. L1232-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'cause réelle et sérieuse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 849 — Licenciement économique', 'Point clé : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou...', 'Cas pratique : Dans une entreprise à Marseille, Nadia se demande comment appliquer Art. L1233-3. Solution : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Art. L1233-3 du Code du travail', 'Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1233-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'licenciement économique', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 850 — Préavis de licenciement', 'Point clé : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est dé...', 'Cas pratique : Dans une entreprise à Lille, Camille se demande comment appliquer Art. L1234-1. Solution : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Art. L1234-1 du Code du travail', 'Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Conseil Expert : Assurez-vous que l''application de Art. L1234-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'préavis de licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 851 — Contestation du licenciement', 'Point clé : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et l...', 'Cas pratique : Dans une entreprise à Lille, Jean se demande comment appliquer Art. L1235-1. Solution : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Art. L1235-1 du Code du travail', 'En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1235-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'contestation du licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 852 — Rupture conventionnelle', 'Point clé : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contra...', 'Cas pratique : Dans une entreprise à Lille, Sophie se demande comment appliquer Art. L1237-11. Solution : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Art. L1237-11 du Code du travail', 'L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-11 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture conventionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 853 — Durée légale du travail', 'Point clé : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par ...', 'Cas pratique : Dans une entreprise à Bordeaux, Marc se demande comment appliquer Art. L3121-27. Solution : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Art. L3121-27 du Code du travail', 'La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-27 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée légale du travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 854 — Temps de travail effectif', 'Point clé : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employ...', 'Cas pratique : Dans une entreprise à Bordeaux, Léa se demande comment appliquer Art. L3121-1. Solution : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Art. L3121-1 du Code du travail', 'La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de travail effectif', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 855 — Temps de pause', 'Point clé : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d...', 'Cas pratique : Dans une entreprise à Bordeaux, Thomas se demande comment appliquer Art. L3121-16. Solution : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Art. L3121-16 du Code du travail', 'Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-16 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de pause', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 856 — Durée quotidienne maximale', 'Point clé : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures....', 'Cas pratique : Dans une entreprise à Nantes, Karim se demande comment appliquer Art. L3121-18. Solution : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Art. L3121-18 du Code du travail', 'Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-18 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée quotidienne maximale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 857 — Durée maximale hebdomadaire', 'Point clé : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures....', 'Cas pratique : Dans une entreprise à Nantes, Awa se demande comment appliquer Art. L3121-20. Solution : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Art. L3121-20 du Code du travail', 'Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-20 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée maximale hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 858 — Travail de nuit', 'Point clé : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la ...', 'Cas pratique : Dans une entreprise à Nantes, Julien se demande comment appliquer Art. L3122-1. Solution : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Art. L3122-1 du Code du travail', 'Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Conseil Expert : Assurez-vous que l''application de Art. L3122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'travail de nuit', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 859 — Repos quotidien', 'Point clé : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives....', 'Cas pratique : Dans une entreprise à Strasbourg, Nadia se demande comment appliquer Art. L3131-1. Solution : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Art. L3131-1 du Code du travail', 'Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3131-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos quotidien', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 860 — Repos hebdomadaire', 'Point clé : Il est interdit de faire travailler un même salarié plus de six jours par semaine....', 'Cas pratique : Dans une entreprise à Strasbourg, Camille se demande comment appliquer Art. L3132-1. Solution : Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Art. L3132-1 du Code du travail', 'Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 861 — Repos dominical', 'Point clé : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche....', 'Cas pratique : Dans une entreprise à Strasbourg, Jean se demande comment appliquer Art. L3132-3. Solution : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Art. L3132-3 du Code du travail', 'Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos dominical', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 862 — Congés annuels', 'Point clé : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur....', 'Cas pratique : Dans une entreprise à Toulouse, Sophie se demande comment appliquer Art. L3141-1. Solution : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Art. L3141-1 du Code du travail', 'Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés annuels', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 863 — Calcul des congés', 'Point clé : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le m...', 'Cas pratique : Dans une entreprise à Toulouse, Marc se demande comment appliquer Art. L3141-3. Solution : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Art. L3141-3 du Code du travail', 'Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'calcul des congés', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 864 — Égalité de rémunération', 'Point clé : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunér...', 'Cas pratique : Dans une entreprise à Toulouse, Léa se demande comment appliquer Art. L3221-2. Solution : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Art. L3221-2 du Code du travail', 'Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Conseil Expert : Assurez-vous que l''application de Art. L3221-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'égalité de rémunération', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 865 — Mensualisation du salaire', 'Point clé : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une qu...', 'Cas pratique : Dans une entreprise à Nice, Thomas se demande comment appliquer Art. L3242-1. Solution : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Art. L3242-1 du Code du travail', 'Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Conseil Expert : Assurez-vous que l''application de Art. L3242-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'mensualisation du salaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 866 — Obligation de sécurité', 'Point clé : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et ...', 'Cas pratique : Dans une entreprise à Nice, Karim se demande comment appliquer Art. L4121-1. Solution : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Art. L4121-1 du Code du travail', 'L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Conseil Expert : Assurez-vous que l''application de Art. L4121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation de sécurité', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 867 — Obligation du salarié (Sécurité)', 'Point clé : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilit...', 'Cas pratique : Dans une entreprise à Nice, Awa se demande comment appliquer Art. L4122-1. Solution : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Art. L4122-1 du Code du travail', 'Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation du salarié (sécurité)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 868 — Définition de la sanction disciplinaire', 'Point clé : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la...', 'Cas pratique : Dans une entreprise à Montpellier, Julien se demande comment appliquer Art. L1331-1. Solution : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Art. L1331-1 du Code du travail', 'Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Conseil Expert : Assurez-vous que l''application de Art. L1331-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'définition de la sanction disciplinaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 869 — Non-discrimination', 'Point clé : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun ...', 'Cas pratique : Dans une entreprise à Montpellier, Nadia se demande comment appliquer Art. L1132-1. Solution : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Art. L1132-1 du Code du travail', 'Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Conseil Expert : Assurez-vous que l''application de Art. L1132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'non-discrimination', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 870 — Harcèlement moral', 'Point clé : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour ...', 'Cas pratique : Dans une entreprise à Montpellier, Camille se demande comment appliquer Art. L1152-1. Solution : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Art. L1152-1 du Code du travail', 'Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1152-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement moral', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 871 — Harcèlement sexuel', 'Point clé : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou c...', 'Cas pratique : Dans une entreprise à Paris, Jean se demande comment appliquer Art. L1153-1. Solution : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Art. L1153-1 du Code du travail', 'Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Conseil Expert : Assurez-vous que l''application de Art. L1153-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement sexuel', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 872 — Informations demandées au candidat', 'Point clé : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir...', 'Cas pratique : Dans une entreprise à Paris, Sophie se demande comment appliquer Art. L1221-6. Solution : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Art. L1221-6 du Code du travail', 'Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-6 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'informations demandées au candidat', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 873 — Protection maternité (Licenciement)', 'Point clé : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de gross...', 'Cas pratique : Dans une entreprise à Paris, Marc se demande comment appliquer Art. L1225-4. Solution : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Art. L1225-4 du Code du travail', 'Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1225-4 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'protection maternité (licenciement)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 874 — Inaptitude non-professionnelle', 'Point clé : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait ...', 'Cas pratique : Dans une entreprise à Lyon, Léa se demande comment appliquer Art. L1226-2. Solution : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Art. L1226-2 du Code du travail', 'Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Conseil Expert : Assurez-vous que l''application de Art. L1226-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'inaptitude non-professionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 875 — Démission', 'Point clé : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention...', 'Cas pratique : Dans une entreprise à Lyon, Thomas se demande comment appliquer Art. L1237-1. Solution : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Art. L1237-1 du Code du travail', 'En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'démission', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 876 — Liberté syndicale', 'Point clé : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''...', 'Cas pratique : Dans une entreprise à Lyon, Karim se demande comment appliquer Art. L2141-1. Solution : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Art. L2141-1 du Code du travail', 'Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Conseil Expert : Assurez-vous que l''application de Art. L2141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'liberté syndicale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 877 — Application convention collective', 'Point clé : La convention collective applicable est celle dont relève l''activité principale exercée par l''employ...', 'Cas pratique : Dans une entreprise à Marseille, Awa se demande comment appliquer Art. L2261-2. Solution : La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Art. L2261-2 du Code du travail', 'La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L2261-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'application convention collective', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 878 — Missions du CSE', 'Point clé : Le comité social et économique a pour mission d''assurer une expression collective des salariés perme...', 'Cas pratique : Dans une entreprise à Marseille, Julien se demande comment appliquer Art. L2312-1. Solution : Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Art. L2312-1 du Code du travail', 'Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Conseil Expert : Assurez-vous que l''application de Art. L2312-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'missions du cse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 879 — Congés événements familiaux', 'Point clé : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mar...', 'Cas pratique : Dans une entreprise à Marseille, Nadia se demande comment appliquer Art. L3142-1. Solution : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Art. L3142-1 du Code du travail', 'Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Conseil Expert : Assurez-vous que l''application de Art. L3142-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés événements familiaux', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 880 — Visite d''information et de prévention', 'Point clé : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des profes...', 'Cas pratique : Dans une entreprise à Lille, Camille se demande comment appliquer Art. L4612-1. Solution : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Art. L4612-1 du Code du travail', 'Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4612-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'visite d''information et de prévention', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 881 — La formation du contrat de travail', 'Point clé : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes qu...', 'Cas pratique : Dans une entreprise à Lille, Jean se demande comment appliquer Art. L1221-1. Solution : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Art. L1221-1 du Code du travail', 'Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la formation du contrat de travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 882 — La période d''essai du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale...', 'Cas pratique : Dans une entreprise à Lille, Sophie se demande comment appliquer Art. L1221-19. Solution : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Art. L1221-19 du Code du travail', 'Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-19 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la période d''essai du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 883 — Renouvellement de la période d''essai', 'Point clé : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet acco...', 'Cas pratique : Dans une entreprise à Bordeaux, Marc se demande comment appliquer Art. L1221-21. Solution : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Art. L1221-21 du Code du travail', 'La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-21 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'renouvellement de la période d''essai', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 884 — Délai de prévenance (Rupture période d''essai)', 'Point clé : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le sala...', 'Cas pratique : Dans une entreprise à Bordeaux, Léa se demande comment appliquer Art. L1221-25. Solution : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Art. L1221-25 du Code du travail', 'Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-25 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'délai de prévenance (rupture période d''essai)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 885 — Exécution de bonne foi', 'Point clé : Le contrat de travail est exécuté de bonne foi....', 'Cas pratique : Dans une entreprise à Bordeaux, Thomas se demande comment appliquer Art. L1222-1. Solution : Le contrat de travail est exécuté de bonne foi.', 'Art. L1222-1 du Code du travail', 'Le contrat de travail est exécuté de bonne foi.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'exécution de bonne foi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 886 — Le télétravail', 'Point clé : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait éga...', 'Cas pratique : Dans une entreprise à Nantes, Karim se demande comment appliquer Art. L1222-9. Solution : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Art. L1222-9 du Code du travail', 'Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-9 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'le télétravail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 887 — Rupture du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salar...', 'Cas pratique : Dans une entreprise à Nantes, Awa se demande comment appliquer Art. L1231-1. Solution : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Art. L1231-1 du Code du travail', 'Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Conseil Expert : Assurez-vous que l''application de Art. L1231-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 888 — Cause réelle et sérieuse', 'Point clé : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse....', 'Cas pratique : Dans une entreprise à Nantes, Julien se demande comment appliquer Art. L1232-1. Solution : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Art. L1232-1 du Code du travail', 'Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Conseil Expert : Assurez-vous que l''application de Art. L1232-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'cause réelle et sérieuse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 889 — Licenciement économique', 'Point clé : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou...', 'Cas pratique : Dans une entreprise à Strasbourg, Nadia se demande comment appliquer Art. L1233-3. Solution : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Art. L1233-3 du Code du travail', 'Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1233-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'licenciement économique', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 890 — Préavis de licenciement', 'Point clé : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est dé...', 'Cas pratique : Dans une entreprise à Strasbourg, Camille se demande comment appliquer Art. L1234-1. Solution : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Art. L1234-1 du Code du travail', 'Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Conseil Expert : Assurez-vous que l''application de Art. L1234-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'préavis de licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 891 — Contestation du licenciement', 'Point clé : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et l...', 'Cas pratique : Dans une entreprise à Strasbourg, Jean se demande comment appliquer Art. L1235-1. Solution : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Art. L1235-1 du Code du travail', 'En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1235-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'contestation du licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 892 — Rupture conventionnelle', 'Point clé : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contra...', 'Cas pratique : Dans une entreprise à Toulouse, Sophie se demande comment appliquer Art. L1237-11. Solution : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Art. L1237-11 du Code du travail', 'L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-11 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture conventionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 893 — Durée légale du travail', 'Point clé : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par ...', 'Cas pratique : Dans une entreprise à Toulouse, Marc se demande comment appliquer Art. L3121-27. Solution : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Art. L3121-27 du Code du travail', 'La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-27 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée légale du travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 894 — Temps de travail effectif', 'Point clé : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employ...', 'Cas pratique : Dans une entreprise à Toulouse, Léa se demande comment appliquer Art. L3121-1. Solution : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Art. L3121-1 du Code du travail', 'La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de travail effectif', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 895 — Temps de pause', 'Point clé : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d...', 'Cas pratique : Dans une entreprise à Nice, Thomas se demande comment appliquer Art. L3121-16. Solution : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Art. L3121-16 du Code du travail', 'Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-16 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de pause', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 896 — Durée quotidienne maximale', 'Point clé : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures....', 'Cas pratique : Dans une entreprise à Nice, Karim se demande comment appliquer Art. L3121-18. Solution : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Art. L3121-18 du Code du travail', 'Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-18 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée quotidienne maximale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 897 — Durée maximale hebdomadaire', 'Point clé : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures....', 'Cas pratique : Dans une entreprise à Nice, Awa se demande comment appliquer Art. L3121-20. Solution : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Art. L3121-20 du Code du travail', 'Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-20 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée maximale hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 898 — Travail de nuit', 'Point clé : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la ...', 'Cas pratique : Dans une entreprise à Montpellier, Julien se demande comment appliquer Art. L3122-1. Solution : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Art. L3122-1 du Code du travail', 'Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Conseil Expert : Assurez-vous que l''application de Art. L3122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'travail de nuit', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 899 — Repos quotidien', 'Point clé : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives....', 'Cas pratique : Dans une entreprise à Montpellier, Nadia se demande comment appliquer Art. L3131-1. Solution : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Art. L3131-1 du Code du travail', 'Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3131-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos quotidien', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 900 — Repos hebdomadaire', 'Point clé : Il est interdit de faire travailler un même salarié plus de six jours par semaine....', 'Cas pratique : Dans une entreprise à Montpellier, Camille se demande comment appliquer Art. L3132-1. Solution : Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Art. L3132-1 du Code du travail', 'Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 901 — Repos dominical', 'Point clé : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche....', 'Cas pratique : Dans une entreprise à Paris, Jean se demande comment appliquer Art. L3132-3. Solution : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Art. L3132-3 du Code du travail', 'Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos dominical', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 902 — Congés annuels', 'Point clé : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur....', 'Cas pratique : Dans une entreprise à Paris, Sophie se demande comment appliquer Art. L3141-1. Solution : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Art. L3141-1 du Code du travail', 'Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés annuels', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 903 — Calcul des congés', 'Point clé : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le m...', 'Cas pratique : Dans une entreprise à Paris, Marc se demande comment appliquer Art. L3141-3. Solution : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Art. L3141-3 du Code du travail', 'Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'calcul des congés', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 904 — Égalité de rémunération', 'Point clé : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunér...', 'Cas pratique : Dans une entreprise à Lyon, Léa se demande comment appliquer Art. L3221-2. Solution : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Art. L3221-2 du Code du travail', 'Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Conseil Expert : Assurez-vous que l''application de Art. L3221-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'égalité de rémunération', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 905 — Mensualisation du salaire', 'Point clé : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une qu...', 'Cas pratique : Dans une entreprise à Lyon, Thomas se demande comment appliquer Art. L3242-1. Solution : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Art. L3242-1 du Code du travail', 'Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Conseil Expert : Assurez-vous que l''application de Art. L3242-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'mensualisation du salaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 906 — Obligation de sécurité', 'Point clé : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et ...', 'Cas pratique : Dans une entreprise à Lyon, Karim se demande comment appliquer Art. L4121-1. Solution : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Art. L4121-1 du Code du travail', 'L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Conseil Expert : Assurez-vous que l''application de Art. L4121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation de sécurité', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 907 — Obligation du salarié (Sécurité)', 'Point clé : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilit...', 'Cas pratique : Dans une entreprise à Marseille, Awa se demande comment appliquer Art. L4122-1. Solution : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Art. L4122-1 du Code du travail', 'Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation du salarié (sécurité)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 908 — Définition de la sanction disciplinaire', 'Point clé : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la...', 'Cas pratique : Dans une entreprise à Marseille, Julien se demande comment appliquer Art. L1331-1. Solution : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Art. L1331-1 du Code du travail', 'Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Conseil Expert : Assurez-vous que l''application de Art. L1331-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'définition de la sanction disciplinaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 909 — Non-discrimination', 'Point clé : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun ...', 'Cas pratique : Dans une entreprise à Marseille, Nadia se demande comment appliquer Art. L1132-1. Solution : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Art. L1132-1 du Code du travail', 'Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Conseil Expert : Assurez-vous que l''application de Art. L1132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'non-discrimination', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 910 — Harcèlement moral', 'Point clé : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour ...', 'Cas pratique : Dans une entreprise à Lille, Camille se demande comment appliquer Art. L1152-1. Solution : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Art. L1152-1 du Code du travail', 'Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1152-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement moral', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 911 — Harcèlement sexuel', 'Point clé : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou c...', 'Cas pratique : Dans une entreprise à Lille, Jean se demande comment appliquer Art. L1153-1. Solution : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Art. L1153-1 du Code du travail', 'Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Conseil Expert : Assurez-vous que l''application de Art. L1153-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement sexuel', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 912 — Informations demandées au candidat', 'Point clé : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir...', 'Cas pratique : Dans une entreprise à Lille, Sophie se demande comment appliquer Art. L1221-6. Solution : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Art. L1221-6 du Code du travail', 'Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-6 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'informations demandées au candidat', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 913 — Protection maternité (Licenciement)', 'Point clé : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de gross...', 'Cas pratique : Dans une entreprise à Bordeaux, Marc se demande comment appliquer Art. L1225-4. Solution : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Art. L1225-4 du Code du travail', 'Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1225-4 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'protection maternité (licenciement)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 914 — Inaptitude non-professionnelle', 'Point clé : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait ...', 'Cas pratique : Dans une entreprise à Bordeaux, Léa se demande comment appliquer Art. L1226-2. Solution : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Art. L1226-2 du Code du travail', 'Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Conseil Expert : Assurez-vous que l''application de Art. L1226-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'inaptitude non-professionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 915 — Démission', 'Point clé : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention...', 'Cas pratique : Dans une entreprise à Bordeaux, Thomas se demande comment appliquer Art. L1237-1. Solution : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Art. L1237-1 du Code du travail', 'En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'démission', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 916 — Liberté syndicale', 'Point clé : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''...', 'Cas pratique : Dans une entreprise à Nantes, Karim se demande comment appliquer Art. L2141-1. Solution : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Art. L2141-1 du Code du travail', 'Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Conseil Expert : Assurez-vous que l''application de Art. L2141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'liberté syndicale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 917 — Application convention collective', 'Point clé : La convention collective applicable est celle dont relève l''activité principale exercée par l''employ...', 'Cas pratique : Dans une entreprise à Nantes, Awa se demande comment appliquer Art. L2261-2. Solution : La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Art. L2261-2 du Code du travail', 'La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L2261-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'application convention collective', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 918 — Missions du CSE', 'Point clé : Le comité social et économique a pour mission d''assurer une expression collective des salariés perme...', 'Cas pratique : Dans une entreprise à Nantes, Julien se demande comment appliquer Art. L2312-1. Solution : Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Art. L2312-1 du Code du travail', 'Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Conseil Expert : Assurez-vous que l''application de Art. L2312-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'missions du cse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 919 — Congés événements familiaux', 'Point clé : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mar...', 'Cas pratique : Dans une entreprise à Strasbourg, Nadia se demande comment appliquer Art. L3142-1. Solution : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Art. L3142-1 du Code du travail', 'Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Conseil Expert : Assurez-vous que l''application de Art. L3142-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés événements familiaux', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 920 — Visite d''information et de prévention', 'Point clé : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des profes...', 'Cas pratique : Dans une entreprise à Strasbourg, Camille se demande comment appliquer Art. L4612-1. Solution : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Art. L4612-1 du Code du travail', 'Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4612-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'visite d''information et de prévention', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 921 — La formation du contrat de travail', 'Point clé : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes qu...', 'Cas pratique : Dans une entreprise à Strasbourg, Jean se demande comment appliquer Art. L1221-1. Solution : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Art. L1221-1 du Code du travail', 'Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la formation du contrat de travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 922 — La période d''essai du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale...', 'Cas pratique : Dans une entreprise à Toulouse, Sophie se demande comment appliquer Art. L1221-19. Solution : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Art. L1221-19 du Code du travail', 'Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-19 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la période d''essai du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 923 — Renouvellement de la période d''essai', 'Point clé : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet acco...', 'Cas pratique : Dans une entreprise à Toulouse, Marc se demande comment appliquer Art. L1221-21. Solution : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Art. L1221-21 du Code du travail', 'La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-21 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'renouvellement de la période d''essai', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 924 — Délai de prévenance (Rupture période d''essai)', 'Point clé : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le sala...', 'Cas pratique : Dans une entreprise à Toulouse, Léa se demande comment appliquer Art. L1221-25. Solution : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Art. L1221-25 du Code du travail', 'Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-25 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'délai de prévenance (rupture période d''essai)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 925 — Exécution de bonne foi', 'Point clé : Le contrat de travail est exécuté de bonne foi....', 'Cas pratique : Dans une entreprise à Nice, Thomas se demande comment appliquer Art. L1222-1. Solution : Le contrat de travail est exécuté de bonne foi.', 'Art. L1222-1 du Code du travail', 'Le contrat de travail est exécuté de bonne foi.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'exécution de bonne foi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 926 — Le télétravail', 'Point clé : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait éga...', 'Cas pratique : Dans une entreprise à Nice, Karim se demande comment appliquer Art. L1222-9. Solution : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Art. L1222-9 du Code du travail', 'Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-9 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'le télétravail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 927 — Rupture du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salar...', 'Cas pratique : Dans une entreprise à Nice, Awa se demande comment appliquer Art. L1231-1. Solution : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Art. L1231-1 du Code du travail', 'Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Conseil Expert : Assurez-vous que l''application de Art. L1231-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 928 — Cause réelle et sérieuse', 'Point clé : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse....', 'Cas pratique : Dans une entreprise à Montpellier, Julien se demande comment appliquer Art. L1232-1. Solution : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Art. L1232-1 du Code du travail', 'Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Conseil Expert : Assurez-vous que l''application de Art. L1232-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'cause réelle et sérieuse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 929 — Licenciement économique', 'Point clé : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou...', 'Cas pratique : Dans une entreprise à Montpellier, Nadia se demande comment appliquer Art. L1233-3. Solution : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Art. L1233-3 du Code du travail', 'Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1233-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'licenciement économique', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 930 — Préavis de licenciement', 'Point clé : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est dé...', 'Cas pratique : Dans une entreprise à Montpellier, Camille se demande comment appliquer Art. L1234-1. Solution : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Art. L1234-1 du Code du travail', 'Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Conseil Expert : Assurez-vous que l''application de Art. L1234-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'préavis de licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 931 — Contestation du licenciement', 'Point clé : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et l...', 'Cas pratique : Dans une entreprise à Paris, Jean se demande comment appliquer Art. L1235-1. Solution : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Art. L1235-1 du Code du travail', 'En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1235-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'contestation du licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 932 — Rupture conventionnelle', 'Point clé : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contra...', 'Cas pratique : Dans une entreprise à Paris, Sophie se demande comment appliquer Art. L1237-11. Solution : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Art. L1237-11 du Code du travail', 'L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-11 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture conventionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 933 — Durée légale du travail', 'Point clé : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par ...', 'Cas pratique : Dans une entreprise à Paris, Marc se demande comment appliquer Art. L3121-27. Solution : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Art. L3121-27 du Code du travail', 'La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-27 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée légale du travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 934 — Temps de travail effectif', 'Point clé : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employ...', 'Cas pratique : Dans une entreprise à Lyon, Léa se demande comment appliquer Art. L3121-1. Solution : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Art. L3121-1 du Code du travail', 'La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de travail effectif', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 935 — Temps de pause', 'Point clé : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d...', 'Cas pratique : Dans une entreprise à Lyon, Thomas se demande comment appliquer Art. L3121-16. Solution : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Art. L3121-16 du Code du travail', 'Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-16 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de pause', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 936 — Durée quotidienne maximale', 'Point clé : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures....', 'Cas pratique : Dans une entreprise à Lyon, Karim se demande comment appliquer Art. L3121-18. Solution : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Art. L3121-18 du Code du travail', 'Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-18 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée quotidienne maximale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 937 — Durée maximale hebdomadaire', 'Point clé : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures....', 'Cas pratique : Dans une entreprise à Marseille, Awa se demande comment appliquer Art. L3121-20. Solution : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Art. L3121-20 du Code du travail', 'Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-20 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée maximale hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 938 — Travail de nuit', 'Point clé : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la ...', 'Cas pratique : Dans une entreprise à Marseille, Julien se demande comment appliquer Art. L3122-1. Solution : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Art. L3122-1 du Code du travail', 'Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Conseil Expert : Assurez-vous que l''application de Art. L3122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'travail de nuit', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 939 — Repos quotidien', 'Point clé : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives....', 'Cas pratique : Dans une entreprise à Marseille, Nadia se demande comment appliquer Art. L3131-1. Solution : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Art. L3131-1 du Code du travail', 'Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3131-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos quotidien', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 940 — Repos hebdomadaire', 'Point clé : Il est interdit de faire travailler un même salarié plus de six jours par semaine....', 'Cas pratique : Dans une entreprise à Lille, Camille se demande comment appliquer Art. L3132-1. Solution : Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Art. L3132-1 du Code du travail', 'Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 941 — Repos dominical', 'Point clé : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche....', 'Cas pratique : Dans une entreprise à Lille, Jean se demande comment appliquer Art. L3132-3. Solution : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Art. L3132-3 du Code du travail', 'Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos dominical', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 942 — Congés annuels', 'Point clé : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur....', 'Cas pratique : Dans une entreprise à Lille, Sophie se demande comment appliquer Art. L3141-1. Solution : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Art. L3141-1 du Code du travail', 'Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés annuels', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 943 — Calcul des congés', 'Point clé : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le m...', 'Cas pratique : Dans une entreprise à Bordeaux, Marc se demande comment appliquer Art. L3141-3. Solution : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Art. L3141-3 du Code du travail', 'Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'calcul des congés', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 944 — Égalité de rémunération', 'Point clé : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunér...', 'Cas pratique : Dans une entreprise à Bordeaux, Léa se demande comment appliquer Art. L3221-2. Solution : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Art. L3221-2 du Code du travail', 'Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Conseil Expert : Assurez-vous que l''application de Art. L3221-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'égalité de rémunération', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 945 — Mensualisation du salaire', 'Point clé : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une qu...', 'Cas pratique : Dans une entreprise à Bordeaux, Thomas se demande comment appliquer Art. L3242-1. Solution : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Art. L3242-1 du Code du travail', 'Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Conseil Expert : Assurez-vous que l''application de Art. L3242-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'mensualisation du salaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 946 — Obligation de sécurité', 'Point clé : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et ...', 'Cas pratique : Dans une entreprise à Nantes, Karim se demande comment appliquer Art. L4121-1. Solution : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Art. L4121-1 du Code du travail', 'L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Conseil Expert : Assurez-vous que l''application de Art. L4121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation de sécurité', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 947 — Obligation du salarié (Sécurité)', 'Point clé : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilit...', 'Cas pratique : Dans une entreprise à Nantes, Awa se demande comment appliquer Art. L4122-1. Solution : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Art. L4122-1 du Code du travail', 'Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation du salarié (sécurité)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 948 — Définition de la sanction disciplinaire', 'Point clé : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la...', 'Cas pratique : Dans une entreprise à Nantes, Julien se demande comment appliquer Art. L1331-1. Solution : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Art. L1331-1 du Code du travail', 'Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Conseil Expert : Assurez-vous que l''application de Art. L1331-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'définition de la sanction disciplinaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 949 — Non-discrimination', 'Point clé : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun ...', 'Cas pratique : Dans une entreprise à Strasbourg, Nadia se demande comment appliquer Art. L1132-1. Solution : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Art. L1132-1 du Code du travail', 'Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Conseil Expert : Assurez-vous que l''application de Art. L1132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'non-discrimination', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 950 — Harcèlement moral', 'Point clé : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour ...', 'Cas pratique : Dans une entreprise à Strasbourg, Camille se demande comment appliquer Art. L1152-1. Solution : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Art. L1152-1 du Code du travail', 'Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1152-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement moral', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 951 — Harcèlement sexuel', 'Point clé : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou c...', 'Cas pratique : Dans une entreprise à Strasbourg, Jean se demande comment appliquer Art. L1153-1. Solution : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Art. L1153-1 du Code du travail', 'Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Conseil Expert : Assurez-vous que l''application de Art. L1153-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement sexuel', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 952 — Informations demandées au candidat', 'Point clé : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir...', 'Cas pratique : Dans une entreprise à Toulouse, Sophie se demande comment appliquer Art. L1221-6. Solution : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Art. L1221-6 du Code du travail', 'Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-6 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'informations demandées au candidat', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 953 — Protection maternité (Licenciement)', 'Point clé : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de gross...', 'Cas pratique : Dans une entreprise à Toulouse, Marc se demande comment appliquer Art. L1225-4. Solution : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Art. L1225-4 du Code du travail', 'Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1225-4 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'protection maternité (licenciement)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 954 — Inaptitude non-professionnelle', 'Point clé : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait ...', 'Cas pratique : Dans une entreprise à Toulouse, Léa se demande comment appliquer Art. L1226-2. Solution : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Art. L1226-2 du Code du travail', 'Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Conseil Expert : Assurez-vous que l''application de Art. L1226-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'inaptitude non-professionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 955 — Démission', 'Point clé : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention...', 'Cas pratique : Dans une entreprise à Nice, Thomas se demande comment appliquer Art. L1237-1. Solution : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Art. L1237-1 du Code du travail', 'En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'démission', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 956 — Liberté syndicale', 'Point clé : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''...', 'Cas pratique : Dans une entreprise à Nice, Karim se demande comment appliquer Art. L2141-1. Solution : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Art. L2141-1 du Code du travail', 'Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Conseil Expert : Assurez-vous que l''application de Art. L2141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'liberté syndicale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 957 — Application convention collective', 'Point clé : La convention collective applicable est celle dont relève l''activité principale exercée par l''employ...', 'Cas pratique : Dans une entreprise à Nice, Awa se demande comment appliquer Art. L2261-2. Solution : La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Art. L2261-2 du Code du travail', 'La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L2261-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'application convention collective', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 958 — Missions du CSE', 'Point clé : Le comité social et économique a pour mission d''assurer une expression collective des salariés perme...', 'Cas pratique : Dans une entreprise à Montpellier, Julien se demande comment appliquer Art. L2312-1. Solution : Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Art. L2312-1 du Code du travail', 'Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Conseil Expert : Assurez-vous que l''application de Art. L2312-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'missions du cse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 959 — Congés événements familiaux', 'Point clé : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mar...', 'Cas pratique : Dans une entreprise à Montpellier, Nadia se demande comment appliquer Art. L3142-1. Solution : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Art. L3142-1 du Code du travail', 'Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Conseil Expert : Assurez-vous que l''application de Art. L3142-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés événements familiaux', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 960 — Visite d''information et de prévention', 'Point clé : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des profes...', 'Cas pratique : Dans une entreprise à Montpellier, Camille se demande comment appliquer Art. L4612-1. Solution : Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Art. L4612-1 du Code du travail', 'Tout travailleur bénéficie d''une visite d''information et de prévention effectuée par l''un des professionnels de santé mentionnés à l''article L. 4624-1 dans un délai qui n''excède pas trois mois à compter de la prise effective du poste de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4612-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'visite d''information et de prévention', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 961 — La formation du contrat de travail', 'Point clé : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes qu...', 'Cas pratique : Dans une entreprise à Paris, Jean se demande comment appliquer Art. L1221-1. Solution : Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Art. L1221-1 du Code du travail', 'Le contrat de travail est soumis aux règles du droit commun. Il peut être établi selon les formes que les parties contractantes décident d''adopter.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la formation du contrat de travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 962 — La période d''essai du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale...', 'Cas pratique : Dans une entreprise à Paris, Sophie se demande comment appliquer Art. L1221-19. Solution : Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Art. L1221-19 du Code du travail', 'Le contrat de travail à durée indéterminée peut comporter une période d''essai dont la durée maximale est : 1° Pour les ouvriers et les employés, de deux mois ; 2° Pour les agents de maîtrise et les techniciens, de trois mois ; 3° Pour les cadres, de quatre mois.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-19 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'la période d''essai du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 963 — Renouvellement de la période d''essai', 'Point clé : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet acco...', 'Cas pratique : Dans une entreprise à Paris, Marc se demande comment appliquer Art. L1221-21. Solution : La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Art. L1221-21 du Code du travail', 'La période d''essai peut être renouvelée une fois si un accord de branche étendu le prévoit. Cet accord fixe les conditions et les durées de renouvellement.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-21 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'renouvellement de la période d''essai', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 964 — Délai de prévenance (Rupture période d''essai)', 'Point clé : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le sala...', 'Cas pratique : Dans une entreprise à Lyon, Léa se demande comment appliquer Art. L1221-25. Solution : Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Art. L1221-25 du Code du travail', 'Lorsqu''il est mis fin par l''employeur au contrat en cours ou au terme de la période d''essai, le salarié est prévenu dans un délai qui ne peut être inférieur à : 24h (< 8j), 48h (8j - 1 mois), 2 semaines (> 1 mois), 1 mois (> 3 mois).', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-25 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'délai de prévenance (rupture période d''essai)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 965 — Exécution de bonne foi', 'Point clé : Le contrat de travail est exécuté de bonne foi....', 'Cas pratique : Dans une entreprise à Lyon, Thomas se demande comment appliquer Art. L1222-1. Solution : Le contrat de travail est exécuté de bonne foi.', 'Art. L1222-1 du Code du travail', 'Le contrat de travail est exécuté de bonne foi.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'exécution de bonne foi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 966 — Le télétravail', 'Point clé : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait éga...', 'Cas pratique : Dans une entreprise à Lyon, Karim se demande comment appliquer Art. L1222-9. Solution : Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Art. L1222-9 du Code du travail', 'Le télétravail désigne toute forme d''organisation du travail dans laquelle un travail qui aurait également pu être exécuté dans les locaux de l''employeur est effectué par un salarié hors de ces locaux de façon volontaire en utilisant les TIC.', 'Conseil Expert : Assurez-vous que l''application de Art. L1222-9 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'le télétravail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 967 — Rupture du CDI', 'Point clé : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salar...', 'Cas pratique : Dans une entreprise à Marseille, Awa se demande comment appliquer Art. L1231-1. Solution : Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Art. L1231-1 du Code du travail', 'Le contrat de travail à durée indéterminée peut être rompu à l''initiative de l''employeur ou du salarié, ou d''un commun accord, dans les conditions prévues par le présent titre.', 'Conseil Expert : Assurez-vous que l''application de Art. L1231-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture du cdi', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 968 — Cause réelle et sérieuse', 'Point clé : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse....', 'Cas pratique : Dans une entreprise à Marseille, Julien se demande comment appliquer Art. L1232-1. Solution : Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Art. L1232-1 du Code du travail', 'Tout licenciement pour motif personnel est motivé. Il est justifié par une cause réelle et sérieuse.', 'Conseil Expert : Assurez-vous que l''application de Art. L1232-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'cause réelle et sérieuse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 969 — Licenciement économique', 'Point clé : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou...', 'Cas pratique : Dans une entreprise à Marseille, Nadia se demande comment appliquer Art. L1233-3. Solution : Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Art. L1233-3 du Code du travail', 'Constitue un licenciement pour motif économique le licenciement effectué par un employeur pour un ou plusieurs motifs non inhérents à la personne du salarié résultant d''une suppression ou transformation d''emploi ou d''une modification, refusée par le salarié, d''un élément essentiel du contrat de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1233-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'licenciement économique', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 970 — Préavis de licenciement', 'Point clé : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est dé...', 'Cas pratique : Dans une entreprise à Lille, Camille se demande comment appliquer Art. L1234-1. Solution : Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Art. L1234-1 du Code du travail', 'Le salarié licencié a droit, sauf en cas de faute grave ou lourde, à un préavis dont la durée est déterminée par la loi (1 mois de 6 mois à 2 ans d''ancienneté, 2 mois au-delà).', 'Conseil Expert : Assurez-vous que l''application de Art. L1234-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'préavis de licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 971 — Contestation du licenciement', 'Point clé : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et l...', 'Cas pratique : Dans une entreprise à Lille, Jean se demande comment appliquer Art. L1235-1. Solution : En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Art. L1235-1 du Code du travail', 'En cas de litige, le juge, à qui il appartient d''apprécier la régularité de la procédure suivie et le caractère réel et sérieux des motifs invoqués par l''employeur, forme sa conviction au vu des éléments fournis par les parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1235-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'contestation du licenciement', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 972 — Rupture conventionnelle', 'Point clé : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contra...', 'Cas pratique : Dans une entreprise à Lille, Sophie se demande comment appliquer Art. L1237-11. Solution : L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Art. L1237-11 du Code du travail', 'L''employeur et le salarié peuvent convenir d''un commun accord des conditions de la rupture du contrat de travail qui les lie. La rupture conventionnelle, exclusive du licenciement ou de la démission, ne peut être imposée par l''une ou l''autre des parties.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-11 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'rupture conventionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 973 — Durée légale du travail', 'Point clé : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par ...', 'Cas pratique : Dans une entreprise à Bordeaux, Marc se demande comment appliquer Art. L3121-27. Solution : La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Art. L3121-27 du Code du travail', 'La durée légale du travail effectif des salariés à temps complet est fixée à trente-cinq heures par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-27 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée légale du travail', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 974 — Temps de travail effectif', 'Point clé : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employ...', 'Cas pratique : Dans une entreprise à Bordeaux, Léa se demande comment appliquer Art. L3121-1. Solution : La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Art. L3121-1 du Code du travail', 'La durée du travail effectif est le temps pendant lequel le salarié est à la disposition de l''employeur et se conforme à ses directives sans pouvoir voguer librement à des occupations personnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de travail effectif', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 975 — Temps de pause', 'Point clé : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d...', 'Cas pratique : Dans une entreprise à Bordeaux, Thomas se demande comment appliquer Art. L3121-16. Solution : Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Art. L3121-16 du Code du travail', 'Dès que le temps de travail quotidien atteint six heures, le salarié bénéficie d''un temps de pause d''une durée minimale de vingt minutes consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-16 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'temps de pause', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 976 — Durée quotidienne maximale', 'Point clé : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures....', 'Cas pratique : Dans une entreprise à Nantes, Karim se demande comment appliquer Art. L3121-18. Solution : Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Art. L3121-18 du Code du travail', 'Sauf dérogations, la durée quotidienne de travail effectif par salarié ne peut excéder dix heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-18 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée quotidienne maximale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 977 — Durée maximale hebdomadaire', 'Point clé : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures....', 'Cas pratique : Dans une entreprise à Nantes, Awa se demande comment appliquer Art. L3121-20. Solution : Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Art. L3121-20 du Code du travail', 'Au cours d''une même semaine, la durée maximale hebdomadaire de travail est de quarante-huit heures.', 'Conseil Expert : Assurez-vous que l''application de Art. L3121-20 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'durée maximale hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 978 — Travail de nuit', 'Point clé : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la ...', 'Cas pratique : Dans une entreprise à Nantes, Julien se demande comment appliquer Art. L3122-1. Solution : Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Art. L3122-1 du Code du travail', 'Le recours au travail de nuit est exceptionnel. Il doit être justifié par la nécessité d''assurer la continuité de l''activité économique ou des services d''utilité sociale.', 'Conseil Expert : Assurez-vous que l''application de Art. L3122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'travail de nuit', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 979 — Repos quotidien', 'Point clé : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives....', 'Cas pratique : Dans une entreprise à Strasbourg, Nadia se demande comment appliquer Art. L3131-1. Solution : Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Art. L3131-1 du Code du travail', 'Tout salarié bénéficie d''un repos quotidien d''une durée minimale de onze heures consécutives.', 'Conseil Expert : Assurez-vous que l''application de Art. L3131-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos quotidien', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 980 — Repos hebdomadaire', 'Point clé : Il est interdit de faire travailler un même salarié plus de six jours par semaine....', 'Cas pratique : Dans une entreprise à Strasbourg, Camille se demande comment appliquer Art. L3132-1. Solution : Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Art. L3132-1 du Code du travail', 'Il est interdit de faire travailler un même salarié plus de six jours par semaine.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos hebdomadaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 981 — Repos dominical', 'Point clé : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche....', 'Cas pratique : Dans une entreprise à Strasbourg, Jean se demande comment appliquer Art. L3132-3. Solution : Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Art. L3132-3 du Code du travail', 'Dans l''intérêt des salariés, le repos hebdomadaire est donné le dimanche.', 'Conseil Expert : Assurez-vous que l''application de Art. L3132-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'repos dominical', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 982 — Congés annuels', 'Point clé : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur....', 'Cas pratique : Dans une entreprise à Toulouse, Sophie se demande comment appliquer Art. L3141-1. Solution : Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Art. L3141-1 du Code du travail', 'Tout salarié a droit chaque année à un congé payé à la charge de l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés annuels', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 983 — Calcul des congés', 'Point clé : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le m...', 'Cas pratique : Dans une entreprise à Toulouse, Marc se demande comment appliquer Art. L3141-3. Solution : Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Art. L3141-3 du Code du travail', 'Le salarié a droit à un congé de deux jours ouvrables et demi par mois de travail effectif chez le même employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L3141-3 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'calcul des congés', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 984 — Égalité de rémunération', 'Point clé : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunér...', 'Cas pratique : Dans une entreprise à Toulouse, Léa se demande comment appliquer Art. L3221-2. Solution : Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Art. L3221-2 du Code du travail', 'Tout employeur assure, pour un même travail ou pour un travail de valeur égale, l''égalité de rémunération entre les femmes et les hommes.', 'Conseil Expert : Assurez-vous que l''application de Art. L3221-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'égalité de rémunération', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 985 — Mensualisation du salaire', 'Point clé : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une qu...', 'Cas pratique : Dans une entreprise à Nice, Thomas se demande comment appliquer Art. L3242-1. Solution : Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Art. L3242-1 du Code du travail', 'Le paiement de la rémunération est effectué une fois par mois. Un acompte correspondant, pour une quinzaine, à la moitié du salaire mensuel est versé au salarié qui en fait la demande.', 'Conseil Expert : Assurez-vous que l''application de Art. L3242-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'mensualisation du salaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 986 — Obligation de sécurité', 'Point clé : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et ...', 'Cas pratique : Dans une entreprise à Nice, Karim se demande comment appliquer Art. L4121-1. Solution : L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Art. L4121-1 du Code du travail', 'L''employeur prend les mesures nécessaires pour assurer la sécurité et protéger la santé physique et mentale des travailleurs.', 'Conseil Expert : Assurez-vous que l''application de Art. L4121-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation de sécurité', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 987 — Obligation du salarié (Sécurité)', 'Point clé : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilit...', 'Cas pratique : Dans une entreprise à Nice, Awa se demande comment appliquer Art. L4122-1. Solution : Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Art. L4122-1 du Code du travail', 'Il incombe à chaque travailleur de prendre soin, en fonction de sa formation et selon ses possibilités, de sa santé et de sa sécurité ainsi que de celles des autres personnes concernées par ses actes ou ses omissions au travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L4122-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'obligation du salarié (sécurité)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 988 — Définition de la sanction disciplinaire', 'Point clé : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la...', 'Cas pratique : Dans une entreprise à Montpellier, Julien se demande comment appliquer Art. L1331-1. Solution : Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Art. L1331-1 du Code du travail', 'Constitue une sanction toute mesure, autre que les observations verbales, prise par l''employeur à la suite d''un agissement du salarié considéré par l''employeur comme fautif.', 'Conseil Expert : Assurez-vous que l''application de Art. L1331-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'définition de la sanction disciplinaire', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 989 — Non-discrimination', 'Point clé : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun ...', 'Cas pratique : Dans une entreprise à Montpellier, Nadia se demande comment appliquer Art. L1132-1. Solution : Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Art. L1132-1 du Code du travail', 'Aucune personne ne peut être écartée d''une procédure de recrutement ou de l''accès à un stage, aucun salarié ne peut être sanctionné, licencié ou faire l''objet d''une mesure discriminatoire, directe ou indirecte.', 'Conseil Expert : Assurez-vous que l''application de Art. L1132-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'non-discrimination', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 990 — Harcèlement moral', 'Point clé : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour ...', 'Cas pratique : Dans une entreprise à Montpellier, Camille se demande comment appliquer Art. L1152-1. Solution : Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Art. L1152-1 du Code du travail', 'Aucun salarié ne doit subir les agissements répétés de harcèlement moral qui ont pour objet ou pour effet une dégradation de ses conditions de travail susceptible de porter atteinte à ses droits et à sa dignité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1152-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement moral', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 991 — Harcèlement sexuel', 'Point clé : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou c...', 'Cas pratique : Dans une entreprise à Paris, Jean se demande comment appliquer Art. L1153-1. Solution : Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Art. L1153-1 du Code du travail', 'Aucun salarié ne doit subir des faits : 1° Soit de harcèlement sexuel, constitué par des propos ou comportements à connotation sexuelle répétés ; 2° Soit assimilés au harcèlement sexuel, consistant en toute forme de pression grave.', 'Conseil Expert : Assurez-vous que l''application de Art. L1153-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'harcèlement sexuel', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 992 — Informations demandées au candidat', 'Point clé : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir...', 'Cas pratique : Dans une entreprise à Paris, Sophie se demande comment appliquer Art. L1221-6. Solution : Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Art. L1221-6 du Code du travail', 'Les informations demandées, sous quelque forme que ce soit, au candidat à un emploi ne peuvent avoir comme finalité que d''apprécier sa capacité à occuper l''emploi proposé ou ses aptitudes professionnelles. Ces informations doivent présenter un lien direct et nécessaire avec l''emploi proposé ou avec l''évaluation des aptitudes professionnelles.', 'Conseil Expert : Assurez-vous que l''application de Art. L1221-6 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'informations demandées au candidat', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 993 — Protection maternité (Licenciement)', 'Point clé : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de gross...', 'Cas pratique : Dans une entreprise à Paris, Marc se demande comment appliquer Art. L1225-4. Solution : Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Art. L1225-4 du Code du travail', 'Aucun employeur ne peut rompre le contrat de travail d''une salariée lorsqu''elle est en état de grossesse médicalement constaté et pendant l''intégralité des périodes de suspension du contrat de travail auxquels elle a droit au titre du congé de maternité.', 'Conseil Expert : Assurez-vous que l''application de Art. L1225-4 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'protection maternité (licenciement)', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 994 — Inaptitude non-professionnelle', 'Point clé : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait ...', 'Cas pratique : Dans une entreprise à Lyon, Léa se demande comment appliquer Art. L1226-2. Solution : Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Art. L1226-2 du Code du travail', 'Lorsque le salarié est déclaré inapte par le médecin du travail à reprendre l''emploi qu''il occupait précédemment, l''employeur lui propose un autre emploi approprié à ses capacités.', 'Conseil Expert : Assurez-vous que l''application de Art. L1226-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'inaptitude non-professionnelle', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 995 — Démission', 'Point clé : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention...', 'Cas pratique : Dans une entreprise à Lyon, Thomas se demande comment appliquer Art. L1237-1. Solution : En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Art. L1237-1 du Code du travail', 'En cas de démission, l''existence et la durée du préavis sont fixées par la loi, ou par la convention ou l''accord collectif de travail.', 'Conseil Expert : Assurez-vous que l''application de Art. L1237-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'démission', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 996 — Liberté syndicale', 'Point clé : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''...', 'Cas pratique : Dans une entreprise à Lyon, Karim se demande comment appliquer Art. L2141-1. Solution : Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Art. L2141-1 du Code du travail', 'Tout salarié peut librement adhérer au syndicat professionnel de son choix et ne peut être écarté d''une procédure de recrutement ou sanctionné en raison de son appartenance syndicale.', 'Conseil Expert : Assurez-vous que l''application de Art. L2141-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'liberté syndicale', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 997 — Application convention collective', 'Point clé : La convention collective applicable est celle dont relève l''activité principale exercée par l''employ...', 'Cas pratique : Dans une entreprise à Marseille, Awa se demande comment appliquer Art. L2261-2. Solution : La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Art. L2261-2 du Code du travail', 'La convention collective applicable est celle dont relève l''activité principale exercée par l''employeur.', 'Conseil Expert : Assurez-vous que l''application de Art. L2261-2 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'application convention collective', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 998 — Missions du CSE', 'Point clé : Le comité social et économique a pour mission d''assurer une expression collective des salariés perme...', 'Cas pratique : Dans une entreprise à Marseille, Julien se demande comment appliquer Art. L2312-1. Solution : Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Art. L2312-1 du Code du travail', 'Le comité social et économique a pour mission d''assurer une expression collective des salariés permettant la prise en compte permanente de leurs intérêts dans les décisions relatives à la gestion et à l''évolution économique et financière de l''entreprise.', 'Conseil Expert : Assurez-vous que l''application de Art. L2312-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'missions du cse', true);
INSERT INTO public.messages (subject, content, casus, reference, article, best_practice, source, tag, is_active) VALUES ('Leçon 999 — Congés événements familiaux', 'Point clé : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mar...', 'Cas pratique : Dans une entreprise à Marseille, Nadia se demande comment appliquer Art. L3142-1. Solution : Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Art. L3142-1 du Code du travail', 'Le salarié a droit, sur justification, à des congés exceptionnels pour des événements familiaux (Mariage, naissance, décès).', 'Conseil Expert : Assurez-vous que l''application de Art. L3142-1 est tracée par écrit et conforme à votre convention collective.', 'https://code.travail.gouv.fr/droit-du-travail', 'congés événements familiaux', true);
